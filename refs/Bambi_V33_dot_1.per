;region resign=================================================
(defrule
	(true)
=>
	(enable-timer timer-score 5)
	(set-goal gl-pop-cap 100)
	(disable-self)
)

(defrule
	(timer-triggered timer-score)
=>
	(up-get-fact-max any-ally current-score 0 gl-max-score-ally)
	(up-get-fact-min any-enemy current-score 0 gl-min-score-enemy)
	(up-get-fact current-score 0 gl-my-score)
)

(defrule
	(timer-triggered timer-score)
	(or (up-compare-goal gl-my-score g:> gl-max-score-ally) (not (player-in-game any-ally)))
=>
	(up-modify-goal gl-max-score-ally g:= gl-my-score)
)

(defrule
	(timer-triggered timer-score)
=>
	(up-get-fact resource-amount 101 gl-trade-gold)
	(up-modify-goal gl-trade-gold c:/ 1000)
	(up-modify-goal gl-trade-gold c:+ 15)
	(up-get-fact population-cap 0 gl-pop-cap)
	(up-get-fact population 0 gl-pop)
	;(up-chat-data-to-self "pop-cap: %d" g: gl-pop-cap)
	(up-modify-goal gl-pop-cap g:- gl-pop)
	;(up-chat-data-to-self "pop-cap - pop: %d" g: gl-pop-cap)
)

(defrule
	(timer-triggered timer-score)
=>
	(disable-timer timer-score)
	(up-modify-goal gl-our-double-score c:= 0)
	(up-modify-goal gl-our-double-score g:= gl-max-score-ally)
	(up-modify-goal gl-our-double-score g:+ gl-max-score-ally)
	;(up-chat-data-to-all "double score best ally %d" g: gl-our-double-score)
	;(up-chat-data-to-self "min score enemy %d" g: gl-min-score-enemy)
	(enable-timer timer-score 5)
)

(defrule
	(game-time > 1200)
	(player-in-game any-ally)
	(up-compare-goal gl-min-score-enemy g:> gl-our-double-score)
	(military-population <= 25)
	(civilian-population <= 25)
	(up-get-fact-max any-ally military-population 0 gl-ally-mil-pop)
	(up-get-player-fact this-any-ally civilian-population 0 gl-ally-civ-pop)
	(up-compare-goal gl-ally-mil-pop < 25)
	(up-compare-goal gl-ally-civ-pop < 25)
=>
	(chat-to-enemies "gg wp")
	(chat-to-allies "I'm sorry, i can't take this anymore :-(")
	(enable-timer timer-resign 3)
	(disable-self)
)

#load-if-not-defined VICTORY-STANDARD
(defrule
	(game-time > 1200)
	(not (player-in-game any-ally))
	(up-compare-goal gl-min-score-enemy g:> gl-our-double-score)
	(military-population < 25)
	(civilian-population < 25)
=>
	(chat-to-all "gg wp")
	(enable-timer timer-resign 10)
	(disable-self)
)

#end-if

#load-if-defined VICTORY-STANDARD
(defrule
	(game-time > 1200)
	(not (player-in-game any-ally))
	(up-compare-goal gl-min-score-enemy g:> gl-our-double-score)
	(military-population < 25)
	(civilian-population < 25)
=>	
	(up-get-fact resource-amount amount-hold-relics gl-team-relics)
)

(defrule
	(up-compare-goal gl-team-relics == 0)
=>
	(chat-to-all "gg wp")
	(enable-timer timer-resign 10)
	(disable-self)
)
#end-if

#load-if-defined VICTORY-RELICS
(defrule
	(game-time > 1200)
	(not (player-in-game any-ally))
	(up-compare-goal gl-min-score-enemy g:> gl-our-double-score)
	(military-population < 25)
	(civilian-population < 25)
=>	
	(up-get-fact resource-amount amount-hold-relics gl-team-relics)
)

(defrule
	(up-compare-goal gl-team-relics == 0)
=>
	(chat-to-all "gg wp")
	(enable-timer timer-resign 10)
	(disable-self)
)
#end-if

(defrule
	(timer-triggered timer-resign)
=>
	(resign)
)
;endregion

;region emergency rebuild================================
(defrule
	(goal gl-land-nomad yes)
	(building-type-count lumber-camp == 0)
	;(up-pending-objects c: lumber-camp == 1)
=>
	(up-jump-rule 10000)
	(chat-local-to-self "land nomad emergency rebuild")
)

; (defrule
	; (goal gl-land-nomad yes) ;needs finishing TC build next to LC
	; (building-type-count-total town-center == 0)
	; ;(up-pending-objects c: lumber-camp == 1)
; =>
	; (up-jump-rule 10000)
; )

(defrule
	(not (building-type-count-total town-center == 0))
	(unit-type-count-total villager < 25)
	(food-amount < 50)
	(can-buy-commodity food)
	(not (town-under-attack))
=>
	(release-escrow gold)
	(buy-commodity food)
	(chat-local-to-self "Buying emergency food for villagers")
)

(defrule
	(building-type-count-total town-center == 0)
=>
	(release-escrow wood)
	(release-escrow food)
	(release-escrow stone)
	(release-escrow gold)
)	

(defrule
	(building-type-count-total town-center == 0)
	(wood-amount < 275)
	(can-buy-commodity wood)
=>
	(buy-commodity wood)
	(up-jump-rule 10000)
	(chat-local-to-self "up-jump buy wood")
)

(defrule
	(building-type-count-total town-center == 0)
	(stone-amount < 100)
	(can-buy-commodity stone)
=>
	(buy-commodity stone)
	(up-jump-rule 10000)
	(chat-local-to-self "up-jump buy stone")
)

(defrule
	(building-type-count-total town-center == 0)
	(can-sell-commodity food)
	(or
		(stone-amount < 100)
		(wood-amount < 275)
	)		
=>
	(sell-commodity food)
	(up-jump-rule 10000)
	(chat-local-to-self "up-jump sell food")
)

(defrule
	(building-type-count-total town-center == 0)
	(building-type-count-total market == 0)
	(or
		(and (building-type-count-total lumber-camp == 0) (wood-amount < 100))
		(and (building-type-count-total mining-camp == 0) (and (wood-amount < 100)(stone-amount < 100)))
	)
	(can-train monk)
=>
    (train monk)
)

(defrule
	;(nand (game-time < 600)(goal gl-land-nomad yes))
	(up-pending-placement c: town-center)
	(building-type-count-total town-center == 0)
=>
	(up-reset-placement c: town-center)
	(chat-local-to-self "reset placement TC")
)

(defrule
	(nand (game-time < 600)(goal gl-land-nomad yes))
	(resource-found wood)
	(building-type-count-total town-center == 0)
	(can-build town-center)
	(unit-type-count villager > 0)
	(goal gl-nomad no)
=>
	(up-assign-builders c: town-center-foundation c: 3)
	(up-build place-normal 0 c: town-center)
	(set-goal gl-emergency-rebuild yes)
	(chat-local-to-self "Emergency or land nomad placement TC")
	(up-jump-rule 10000)
)

(defrule
	(nand (game-time < 600)(goal gl-land-nomad yes))
	(resource-found wood)
	(building-type-count-total town-center == 0)
	(can-build town-center)
	(unit-type-count villager > 0)
	(goal gl-nomad yes)
	(game-time > 100)
=>
	(up-assign-builders c: town-center-foundation c: 3)
	(up-build place-normal 0 c: town-center)
	(set-goal gl-emergency-rebuild yes)
	(chat-local-to-self "Emergency or nomad placement TC")
	(up-jump-rule 10000)
)

(defrule
	(game-time < 100)
	(resource-found wood)
	(building-type-count-total town-center == 0)
	(can-build town-center)
	(unit-type-count villager > 0)
=>
	(up-assign-builders c: town-center-foundation c: 3)
	(up-build place-normal 0 c: town-center)
	(chat-local-to-self "Nomad placement TC")
	(up-jump-rule 10000)
)

(defrule
	(not (resource-found wood)) ;this triggers in the beginning of nomad
	(building-type-count-total town-center == 0)
	(can-build town-center)
	(unit-type-count villager > 0)
=>
	(up-jump-rule 10000)
	(chat-local-to-self "jumping to wait")
	(disable-self)
)

(defrule
	(building-type-count-total town-center == 0)
	(wood-amount < 275)
	(building-type-count-total lumber-camp > 0)
	(unit-type-count villager > 0)
=>
	(set-strategic-number sn-food-gatherer-percentage 0)
	(set-strategic-number sn-wood-gatherer-percentage 100)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
	(up-jump-rule 10000)
)

(defrule
	;(not (goal gl-land-nomad yes))
	(not (resource-found wood))
	(building-type-count-total town-center == 0)
	(wood-amount < 275)
	(wood-amount >= 100)
	(building-type-count-total lumber-camp == 0)
	(can-build lumber-camp)
=>
	(up-jump-rule 10000)
)

(defrule
	(not (goal gl-land-nomad yes))
	(resource-found wood)
	(building-type-count-total town-center == 0)
	(wood-amount < 275)
	(wood-amount >= 100)
	(building-type-count-total lumber-camp == 0)
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(up-modify-sn sn-camp-max-distance c:+ 2)
	(chat-local-to-self "emergency lumber-camp rule")
	(up-jump-rule 10000)
)

(defrule
	(timer-triggered timer-taunt)
	(building-type-count-total town-center == 0)
	(building-type-count-total lumber-camp == 0)
	(wood-amount < 100)
	(player-in-game any-ally)
	(unit-type-count villager > 0)
=>
	(disable-timer timer-taunt)
	(chat-to-allies "4")
	(enable-timer timer-taunt 300)
	(up-jump-rule 10000)
)

(defrule
	(building-type-count-total town-center == 0)
	(wood-amount >= 275)
	(stone-amount < 100)
	(building-type-count-total mining-camp > 0)
	(unit-type-count villager > 0)
=>
	(set-strategic-number sn-food-gatherer-percentage 0)
	(set-strategic-number sn-wood-gatherer-percentage 0)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 100)
	(up-jump-rule 10000)
)

(defrule
	(building-type-count-total town-center == 0)
	(wood-amount >= 275)
	(stone-amount < 100)
	(building-type-count-total mining-camp == 0)
	(can-build mining-camp)
=>
	(up-build place-normal 0 c: mining-camp)
	(up-modify-sn sn-camp-max-distance c:+ 2)
	(up-jump-rule 10000)
)

(defrule
	(building-type-count-total town-center == 0)
	(not (timer-triggered timer-taunt))
	(game-time > 1000)
=>
	(chat-local-to-self "timer not triggered timer-taunt")
	(up-jump-rule 10000)
)

(defrule
	(goal gl-emergency-rebuild yes)
	(building-type-count-total town-center > 0)
=>
    (set-strategic-number sn-food-gatherer-percentage 45)
    (set-strategic-number sn-wood-gatherer-percentage 40)
    (set-strategic-number sn-gold-gatherer-percentage 10)
    (set-strategic-number sn-stone-gatherer-percentage 5)
	(set-goal gl-emergency-rebuild no)
	(chat-local-to-self "emergency villager distribution initiated")
)
;endregion

;region AGES & ESCROW========================================
(defrule
    (or
		(or (civilian-population >= 27) (players-current-age any-enemy >= feudal-age))
		(and (goal gl-scrush yes) (civilian-population >= 24))
	)
	(can-research feudal-age)
=>
    (research feudal-age)
	(set-escrow-percentage food 25)
	(set-escrow-percentage wood 25)
)

(defrule
    (can-research-with-escrow castle-age)
=>
    (release-escrow food)
	(research castle-age)
	(set-escrow-percentage wood 35)
	(set-escrow-percentage food 10)
)

(defrule
	(civilian-population >= 50)
	(can-research-with-escrow ri-wheel-barrow)
	(goal gl-feudal-defense yes)
	(nand (current-age == castle-age) (and (goal gl-pikeman yes) (food-amount < 500)))
=>
	(up-research gl-escrow-state c: ri-wheel-barrow)
)

(defrule
    (civilian-population >= 75)
	(can-research-with-escrow ri-hand-cart)
	(or (goal gl-pikeman no) (food-amount > 600))
=>
	(up-research gl-escrow-state c: ri-hand-cart)
)

(defrule
    (current-age == castle-age)
	(not (up-research-status c: imperial-age c:>= research-pending))
	(civilian-population < 50)
	(not (town-under-attack))
=>
    (set-escrow-percentage food 10)
	(set-escrow-percentage gold 8)
)

(defrule
    (current-age == castle-age)
	(not (up-research-status c: imperial-age c:>= research-pending))
	(civilian-population >= 50)
	(civilian-population < 75)
	(not (town-under-attack))
=>
    (set-escrow-percentage food 25)
	(set-escrow-percentage gold 20)
)

(defrule
    (current-age == castle-age)
	(not (up-research-status c: imperial-age c:>= research-pending))
	(civilian-population >= 75)
	(civilian-population < 100)
	(not (town-under-attack))
=>
    (set-escrow-percentage food 50)
	(set-escrow-percentage gold 40)
)

(defrule
    (current-age == castle-age)
	(not (up-research-status c: imperial-age c:>= research-pending))
	(civilian-population >= 100)
	(not (town-under-attack))
=>
    (set-escrow-percentage food 75)
	(set-escrow-percentage gold 60)
)

(defrule
    (can-research-with-escrow imperial-age)
=>
	(set-escrow-percentage food 0)
	(set-escrow-percentage gold 0)
	(set-escrow-percentage wood 0)
	(release-escrow food)
	(release-escrow gold)
	(release-escrow wood)
	(research imperial-age)
)

(defrule
	(up-research-status c: imperial-age c:>= research-pending)
	(unit-type-count-total trebuchet-set < 2)
	(building-type-count castle >= 1)
=>
	(set-escrow-percentage wood 10)
	(set-escrow-percentage gold 20)
)

(defrule
	(up-research-status c: imperial-age c:>= research-pending)
	(building-type-count-total castle < 1)
=>
	(set-escrow-percentage wood 0)
	(set-escrow-percentage gold 0)
	(release-escrow wood)
	(release-escrow gold)
)

(defrule
	(up-research-status c: imperial-age c:>= research-pending)
	(military-population <= 20)
=>
	(set-escrow-percentage wood 0)
	(set-escrow-percentage gold 0)
	(release-escrow wood)
	(release-escrow gold)
)
;endregion

;region CIVILIANS=====================
(defrule
	(current-age < castle-age)
	(players-military-population any-enemy > 9)
	(strategic-number sn-allow-civilian-offense == 2)
	(strategic-number sn-allow-civilian-defense == 3)
=>
	(set-strategic-number sn-allow-civilian-offense 0)
	(set-strategic-number sn-allow-civilian-defense 1)
	(chat-local-to-self "Civilian offense deactivated large enemy army")
)

(defrule
	(current-age < castle-age)
	(up-building-type-in-town c: town-center > 0)
	(strategic-number sn-maximum-town-size <= 35)
	(strategic-number sn-allow-civilian-offense == 2)
	(strategic-number sn-allow-civilian-defense == 3)
=>
	(set-strategic-number sn-allow-civilian-offense 0)
	(set-strategic-number sn-allow-civilian-defense 1)
	(chat-local-to-self "Civilian offense deactivated close TC")
)

(defrule
    (current-age < castle-age)
    (up-projectile-detected projectile-town-center < 2000)
    (up-projectile-target projectile-town-center == villager-class)
=>
    (chat-local-to-self "Emergency: villagers under TC fire!")
    (up-get-projectile-player projectile-town-center gl-player-TC-attack)
    (up-modify-sn sn-focus-player-number g: gl-player-TC-attack)
    (up-get-point position-self gl-me-x)
    (up-set-target-point gl-me-x)
    (up-full-reset-search)
    ;(up-filter-distance c: -1 c: 40)
    (up-find-remote c: town-center c: 1)
)

(defrule
    (current-age < castle-age)
    (up-projectile-detected projectile-town-center < 2000)
    (up-projectile-target projectile-town-center == villager-class)
	(up-set-target-object search-remote c: 0)
=>
    (up-get-object-data object-data-distance gl-enemy-TC-distance)
    (up-chat-data-to-player my-player-number "Enemy TC distance: %d" g: gl-enemy-TC-distance)
)

(defrule
	(current-age < castle-age)
	(up-projectile-detected projectile-town-center < 2000)
	(up-projectile-target projectile-town-center == villager-class)
	(up-compare-goal gl-enemy-TC-distance <= 35)
	(strategic-number sn-allow-civilian-offense == 2)
	(strategic-number sn-allow-civilian-defense == 3)
=>
	(set-strategic-number sn-allow-civilian-offense 0)
	(set-strategic-number sn-allow-civilian-defense 1)
	(chat-to-player my-player-number "Civilian offense deactivated: enemy TC distance smaller than 35")
)

(defrule
	(strategic-number sn-focus-player-number != 0)
=>
	(up-modify-sn sn-focus-player-number c: 0)
)

(defrule
	(research-completed ri-loom)
	(current-age < castle-age)
	(not (players-military-population any-enemy > 9))
	(military-population < 10)
	(strategic-number sn-allow-civilian-offense == 0)
	(strategic-number sn-allow-civilian-defense == 1)
	(up-compare-goal gl-enemy-TC-distance > 35)
	(nand (up-building-type-in-town c: town-center > 0)(strategic-number sn-maximum-town-size <= 35)) ;specially for nomad
=>
	(set-strategic-number sn-allow-civilian-offense 2)
	(set-strategic-number sn-allow-civilian-defense 3)
	(set-strategic-number sn-number-civilian-militia 10)
	(chat-local-to-self "Civilian defense and offense activated")
)

; (defrule
	; (true)
; =>
	; (up-chat-data-to-self "civilian militia: %d" s: sn-number-civilian-militia)
; )

(defrule
    (or 
		(players-military-population any-enemy >= 2)
		(up-enemy-buildings-in-town c:> 0)
	) 
	(not (research-completed ri-loom))
=>
    (set-goal gl-loom yes)
	(chat-local-to-self "Emergency Loom")
	(disable-self)
)

(defrule
	(not (research-completed ri-loom))
	(dropsite-min-distance live-boar s:<= sn-maximum-hunt-drop-distance)
	;(dropsite-min-distance live-boar c:!= -1)
	(dropsite-min-distance live-boar > 20)
	(or (unit-type-count livestock-class == 0) (up-compare-goal gl-boar-count > 0))
	(civilian-population > 6)
	(not (civ-selected berbers))
=>
    (set-goal gl-loom yes)
	(chat-local-to-self "Loom for iffy boar lure")
	(disable-self)
)	

