#load-if-defined ARENA-MAP
(defrule
	(strategic-number sn-placement-to-center == 1)
=>
	(set-strategic-number sn-placement-to-center 0)
)
#end-if

(defrule
	(building-type-count-total watch-tower > 0)
	(goal gl-imperial-priority no)
	(can-research ri-guard-tower)
	(or (goal gl-pikeman no) (food-amount > 600))
=>
	(research ri-guard-tower)
)

(defrule
	(building-type-count-total watch-tower > 1)
	(can-research ri-keep)
=>
	(research ri-keep)
)

