;endregion

;region Villager vs ram defense initiative
(defconst ramdefense 35)

(defrule
	(true)
=>
	(set-goal gl-my-arrows no)
	(set-goal gl-ram-focus-player 0)
	(disable-self)
)

(defrule
	(strategic-number sn-maximum-town-size <= ramdefense)
	(goal gl-my-arrows no)
	(or
		(or
			(unit-type-count 54 > 0);arrow from TC
			(unit-type-count 328 > 0) ;flaming arrow arrow from TC	
		)
		(or
			(unit-type-count 746 > 0);arrow from TC
			(unit-type-count 747 > 0) ;flaming arrow arrow from TC	
		
		)
	)
=>
	(set-goal gl-my-arrows yes)
	(chat-local-to-self "Defensive arrows detected")
)

(defrule
	(strategic-number sn-maximum-town-size <= ramdefense)
	(goal gl-my-arrows no)
	(or
		(unit-type-count 504 > 0);arrow tower
		(unit-type-count 505 > 0);arrow tower	
	)
=>
	(set-goal gl-my-arrows yes)
	;(chat-local-to-self "Defensive arrows detected")
)

(defrule
	(goal gl-my-arrows yes)
	(unit-type-count 54 == 0);arrow from TC
	(unit-type-count 328 == 0) ;flaming arrow arrow from TC	
	(unit-type-count 746 == 0);arrow from TC
	(unit-type-count 747 == 0) ;flaming arrow arrow from TC	
	(unit-type-count 504 == 0) ;arrow tower
	(unit-type-count 505 == 0) ;arrow tower
=>
	(set-goal gl-my-arrows no)
	;(chat-local-to-self "No defensive arrows")
)

(defrule
	(goal gl-my-arrows yes)
	(strategic-number sn-maximum-town-size > ramdefense)
=>
	(set-goal gl-my-arrows no)
	(chat-local-to-self "TS larger than or equal to ramdefense: defensive arrow detection de-activated")
)

(defrule
	(goal gl-my-arrows yes)
	(up-unit-type-in-town c: battering-ram-line > 0)
=>
	(up-find-player enemy find-attacker gl-ram-focus-player)
	(up-modify-sn sn-focus-player-number g:= gl-ram-focus-player)
	;(up-chat-data-to-self "Enemy ram focus player number primed at: %d" s: sn-focus-player-number)
)

(defrule
	(goal gl-my-arrows yes)
	(up-unit-type-in-town c: battering-ram-line > 0)
	(players-unit-type-count focus-player battering-ram-line > 0)
	(stance-toward focus-player enemy)
=>
	;(up-chat-data-to-self "Enemy ram focus player number found at: %d" s: sn-focus-player-number)
	(up-jump-rule 1)
)

(defrule
	(true)
=>
	(up-jump-rule 1)
)

; (defrule
	; (goal gl-my-arrows yes)
	; (up-unit-type-in-town c: battering-ram-line > 0)
	; (up-compare-goal gl-ram-focus-player != 8)
; =>
	; (up-modify-goal gl-ram-focus-player c:+ 1)
	; (up-modify-sn sn-focus-player-number g:= gl-ram-focus-player)
	; (up-chat-data-to-self "Ram focus player number: %d" s: sn-focus-player-number)
	; (up-jump-rule 2)
; )

; (defrule
	; (goal gl-my-arrows yes)
	; (up-unit-type-in-town c: battering-ram-line > 0)
	; (up-compare-goal gl-ram-focus-player == 8)
; =>
	; (up-modify-goal gl-ram-focus-player c:= 1)
	; (up-modify-sn sn-focus-player-number g:= gl-ram-focus-player)
	; (up-chat-data-to-self "Ram focus player number: %d" s: sn-focus-player-number)
	; (up-jump-rule 1)
; )

(defrule
	(goal gl-my-arrows yes)
	(up-timer-status timer-villagerVSram != timer-running)
	(player-in-game focus-player)
	(stance-toward focus-player enemy)
	(town-under-attack)
	(up-unit-type-in-town c: battering-ram-line > 0)
=>
	(up-get-point position-self gl-me-x)
	(up-set-target-point gl-me-x)
	(up-jump-rule 1)
	;(chat-local-to-self "Battering ram alert!")
)

(defrule
	(true)
=>
	(up-jump-rule 1)
)

(defrule
	(goal gl-my-arrows yes)
	(town-under-attack)
	(players-unit-type-count focus-player battering-ram-line > 0)
	(up-unit-type-in-town c: battering-ram-line > 0)
	(up-timer-status timer-villagerVSram != timer-running)
	(stance-toward focus-player enemy)
=>
	(up-full-reset-search)
	(up-filter-distance c: -1 c: ramdefense)
	(up-find-remote c: battering-ram-line c: 1)
	(up-find-local c: villager-class c: 7)
	(up-target-objects 0 action-default -1 -1)
	(enable-timer timer-villagerVSram 40)
	(chat-local-to-self "Villagers vs battering ram defense initiative DUC!")
)

(defrule
	(strategic-number sn-focus-player-number != 0)
=>
	(set-strategic-number sn-focus-player-number 0)
)
;endregion

