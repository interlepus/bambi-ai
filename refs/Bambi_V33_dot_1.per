;region BUILDINGS Farms & Mills===============================
(defrule
	(current-age == dark-age)
	(goal gl-water-map yes)
	(building-type-count-total dock == 0)
	(not (goal gl-water-farm-ok no))
	(game-time < 600)
=>
	(set-goal gl-water-farm-ok no)
)

(defrule
	(current-age == dark-age)
	(goal gl-water-map yes)
	(building-type-count dock > 0)
	(unit-type-count-total fishing-ship < 4)
	(up-pending-objects c: fishing-ship == 0)
	(wood-amount <= 150)
	(game-time < 600)
	(not (goal gl-water-farm-ok no))
=>
	(set-goal gl-water-farm-ok no)
)

(defrule
	(goal gl-water-map yes)
	(not (goal gl-water-farm-ok yes))
	(or
		(up-pending-objects c: fishing-ship > 0)
		(or
			(unit-type-count-total fishing-ship >= 4)
			(building-type-count dock == 0)
		)
	)
	(or 
		(building-type-count-total dock > 0) 
		(or 
			(wood-amount > 250)
			(game-time > 600)
		)
	)
=>
	(set-goal gl-water-farm-ok yes)
)

(defrule
	(not (goal gl-water-map yes))
	(not (goal gl-water-farm-ok yes))
=>
	(set-goal gl-water-farm-ok yes)
)

(defrule ;farms
    (civilian-population > 10)
	(current-age == dark-age)
	(building-type-count-total farm < 1)
	(building-type-count-total lumber-camp > 0)
	(or(building-type-count-total mill > 0)(building-type-count-total folwark > 0))
    (can-build farm)
	(up-pending-objects c: farm < 1)
	(goal gl-water-farm-ok yes)
	(food-amount < 2000)
=>
    (build farm)
)

(defrule ;farms ;emphasis food in dark age... needs programming.....
    (civilian-population > 10)
	(current-age == dark-age)
	(not (up-research-status c: feudal-age c:>= research-pending))
	(food-amount < feudal-food)
	(idle-farm-count < 1)
	(building-type-count-total lumber-camp > 0)
	(or(building-type-count-total mill > 0)(building-type-count-total folwark > 0))
	;(building-type-count-total barracks > 0)
	;(building-type-count-total mining-camp > 0)
    (can-build farm)
	(up-pending-objects c: farm < 1)
	(goal gl-water-farm-ok yes)
	(food-amount < 2000)
=>
    (build farm)
)

(defrule ;farms
    (civilian-population > 10)
	(current-age == dark-age)
	(idle-farm-count < 1)
	(building-type-count-total lumber-camp > 0)
	(building-type-count-total barracks > 0)
	(building-type-count-total mining-camp > 0)
    (can-build farm)
	(up-pending-objects c: farm < 1)
	(goal gl-water-farm-ok yes)
	(food-amount < 2000)
=>
    (build farm)
)

(defrule ;farms
    (current-age == feudal-age)
	(idle-farm-count < 2)
    (can-build farm)
	(up-pending-objects c: farm < 2)
	(food-amount < 2000)
=>
    (build farm)
)

(defrule ;farms
    (current-age == castle-age)
	(idle-farm-count < 3)
    (can-build farm)
	(up-pending-objects c: farm < 3)
	(food-amount < 2000)
=>
    (build farm)
)

(defrule ;farms
    (current-age == imperial-age)
	(idle-farm-count < 4)
    (can-build farm)
	(up-pending-objects c: farm < 4)
	(food-amount < 2000)
=>
    (build farm)
)

(defrule ;mills
	(building-type-count-total farm >= 15)
	(building-type-count-total mill < 2)
    (can-build mill)
	(dropsite-min-distance wood <= 3)
=>
    (set-strategic-number sn-preferred-mill-placement 0)
	(up-retask-gatherers food c: 1)
	(build mill)
)

(defrule ;mills
	(building-type-count-total farm >= 25)
	(building-type-count-total mill < 3)
    (can-build mill)
	(dropsite-min-distance wood <= 3)
=>
    (set-strategic-number sn-preferred-mill-placement 0)
	(up-retask-gatherers food c: 1)
	(build mill)
)

(defrule ;mills
	(building-type-count-total farm >= 40)
	(building-type-count-total mill < 4)
    (can-build mill)
	(dropsite-min-distance wood <= 3)
=>
    (set-strategic-number sn-preferred-mill-placement 0)
	(up-retask-gatherers food c: 1)
	(build mill)
)

(defrule ;mills
	(building-type-count-total farm >= 55)
	(building-type-count-total mill < 5)
    (can-build mill)
	(dropsite-min-distance wood <= 3)
=>
    (set-strategic-number sn-preferred-mill-placement 0)
	(up-retask-gatherers food c: 1)
	(build mill)
)

(defrule ;mills
	(building-type-count-total farm >= 75)
	(building-type-count-total mill < 6)
    (can-build mill)
	(dropsite-min-distance wood <= 3)
=>
    (set-strategic-number sn-preferred-mill-placement 0)
