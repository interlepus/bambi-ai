(defrule
	    (up-timer-status timer-suicide != timer-running)
=>
		(chat-local-to-self "timer suicide is not running")
		(disable-self)
)

(defrule
	    (up-timer-status timer-suicide == timer-running)
=>
		(chat-local-to-self "timer suicide is running")
		(disable-self)
)

;(defrule
;	(true)
;=>
;    (up-find-player enemy find-closest gl-closest-enemy)
;   (up-modify-sn sn-focus-player-number g:= gl-closest-enemy)
;	(up-chat-data-to-self "Closest enemy goal=%d" g: gl-closest-enemy)
;	(up-chat-data-to-self "Focus enemy=%d" s: sn-focus-player-number)
;	(disable-self)
;)

(defrule
    (up-compare-goal gl-pop-cap < 10)
    (current-age >= castle-age)
    (civilian-population > numbercivilians)
    (up-timer-status timer-suicide != timer-running)
=>
    (up-find-player enemy find-closest gl-closest-enemy)
    (up-modify-sn sn-focus-player-number g:= gl-closest-enemy)

	(up-chat-data-to-self "Closest enemy=%d" g: gl-closest-enemy)

    (up-full-reset-search)

    ; Find one enemy building owned by focus player.
    (up-find-status-remote c: building-class c: 1)

    ; Find ten own villagers.
    (up-find-local c: villager-class c: 10)

    ; Store search result counts into 4 consecutive goals.
    (up-get-search-state gl-duc-local-searches)

    (up-chat-data-to-self "DUC suicide: local-found=%d" g: gl-duc-local-found)
    (up-chat-data-to-self "DUC suicide: remote-found=%d" g: gl-duc-remote-found)

;    (enable-timer timer-suicide 5)
)

;(defrule
;	(timer-triggered timer-suicide)
;=>
;	(up-get-point position-target gl-point-x)
;	(up-send-flare gl-point-x)
;	(chat-to-player my-player-number "Flare attack building fired")
;	(disable-self)
;)

(defrule
;    (timer-triggered timer-suicide)
    (up-compare-goal gl-pop-cap < 10)
    (current-age >= castle-age)
    (civilian-population > numbercivilians)
    (up-timer-status timer-suicide != timer-running)
    (up-compare-goal gl-duc-remote-found > 0)
    (up-set-target-object search-remote c: 0)
=>
    (up-get-object-data object-data-point-x gl-point-x)
    (up-get-object-data object-data-point-y gl-point-y)

    (up-send-flare gl-point-x)

    (chat-to-player my-player-number "Flare attack building fired")
)

(defrule
;    (timer-triggered timer-suicide)
    (up-compare-goal gl-pop-cap < 10)
    (current-age >= castle-age)
    (civilian-population > numbercivilians)
    (up-timer-status timer-suicide != timer-running)
    (up-compare-goal gl-duc-local-found > 0)
    (up-compare-goal gl-duc-remote-found > 0)
=>
    (up-target-objects 0 action-default -1 -1)
    (disable-timer timer-suicide)
    (enable-timer timer-suicide 60)

    (chat-to-player my-player-number "Overboomed: DUC sent villagers to enemy building")
)

