;region ECONOMY LLAMAs - (GAIA SHEEP) - BOAR LURING===============================
(defrule
	(true)
=>
	(enable-timer timer-60 1)
	(disable-self)
)

(defrule
	(timer-triggered timer-60)
	(unit-type-count llama > 0)
	(or
		(building-type-count house > 0)
		(not (building-available house))
	)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-get-point position-self gl-me-x)
	(up-set-target-point gl-me-x)
	(up-full-reset-search)
	(up-filter-distance c: -1 c: 10)
	(up-find-local c: villager-class c: 1)
	(up-find-remote c: llama c: 1)
	(up-target-objects 0 action-default -1 -1)
	(up-set-timer c: timer-60 c: 60)
)

(defrule
	(strategic-number sn-focus-player-number != 0)
=>
	(set-strategic-number sn-focus-player-number 0)
)

; (defrule
	; (dropsite-min-distance live-boar < 5)
	; (up-remaining-boar-amount < 250)	
; =>
	; (chat-local-to-self "Debug: accidently lured 2nd boar")
	; (disable-self)
; )
#load-if-not-defined DIFFICULTY-EASIEST
#load-if-not-defined DIFFICULTY-EASY
(defrule
	(true)
=>
	(set-goal gl-boar-hunt 1)
	(set-goal gl-boar-count 0)
	(disable-self)
)

(defrule
	(and (or (unit-type-count livestock-class == 0) (up-compare-goal gl-boar-count > 0)) (civilian-population > 6))
	(goal gl-boar-hunt 1)
	(dropsite-min-distance live-boar s:<= sn-maximum-hunt-drop-distance)
	(dropsite-min-distance live-boar > -1)
	(strategic-number sn-enable-boar-hunting != 2)
=>
	(set-strategic-number sn-enable-boar-hunting 2) ;We’re doing nothing but boar hunting now
    ;(set-strategic-number sn-minimum-number-hunters 6)
	(set-strategic-number sn-minimum-number-hunters 1)
    (up-retask-gatherers food c: 1)
	(set-strategic-number sn-minimum-boar-lure-group-size 1) ;set to 1 to start luring
	(up-modify-goal gl-boar-count c:+ 1)
	(up-chat-data-to-self "Luring boar %d" g: gl-boar-count)
	(enable-timer time-out-boar 600) ;this is set for the fail-safe
	(set-goal gl-boar-hunt 2)
)

(defrule
	(goal gl-boar-hunt 2)
	(strategic-number sn-enable-boar-hunting == 2)
	(dropsite-min-distance live-boar <= 13)
	(dropsite-min-distance live-boar > -1)
=>
	(disable-timer time-out-boar)
	(set-strategic-number sn-minimum-number-hunters 6) ;new with DE
	(set-strategic-number sn-minimum-boar-hunt-group-size 6)
	(up-chat-data-to-self "29 6 vills to boar %d" g: gl-boar-count)
	(enable-timer time-out-boar 120)
	(set-goal gl-boar-hunt 3)
)

(defrule ;normal procedure
	(goal gl-boar-hunt 3)
	(timer-triggered time-out-boar)
	(strategic-number sn-enable-boar-hunting == 2)
	(or (up-remaining-boar-amount < 180) (up-remaining-boar-amount == 65535))
=>
	(set-strategic-number sn-enable-boar-hunting 1)
	(set-strategic-number sn-minimum-boar-lure-group-size 0)
	(set-strategic-number sn-minimum-boar-hunt-group-size 0)
	(set-strategic-number sn-minimum-number-hunters 0)
	(up-chat-data-to-self "Reset boar %d luring normal procedure" g: gl-boar-count)
	(set-goal gl-boar-hunt 1)
	(disable-timer time-out-boar)
)

(defrule ;fail-safe procedure
	(goal gl-boar-hunt 2)
	(timer-triggered time-out-boar)
	(strategic-number sn-enable-boar-hunting == 2)
	(or (up-remaining-boar-amount < 180) (up-remaining-boar-amount == 65535))
=>
	(set-strategic-number sn-enable-boar-hunting 1)
	(set-strategic-number sn-minimum-boar-lure-group-size 0)
	(set-strategic-number sn-minimum-boar-hunt-group-size 0)
	(set-strategic-number sn-minimum-number-hunters 0)
	(up-chat-data-to-self "Reset boar %d luring fail-safe procedure" g: gl-boar-count)
	(set-goal gl-boar-hunt 1)
	(disable-timer time-out-boar)
)
#end-if
#end-if

