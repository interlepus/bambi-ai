	(true)
 =>
	(up-chat-data-to-self "sn-camp-max-distance %d" s: sn-camp-max-distance)
	(disable-self)
)

(defrule
	(true)
 =>
	(chat-local-to-self "last defrule")
	(disable-self)
)

(defrule
	(true)
=>
	(do-nothing)
)