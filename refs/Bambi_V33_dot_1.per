#load-if-not-defined AZTEC-CIV
	#load-if-not-defined MAYAN-CIV
		#load-if-not-defined INCAN-CIV
			(defrule ;if neither aztec, mayan or incan are defined
				(true)
			=>
				(set-goal meso-civ no)
				(chat-local-to-self "I am not a meso-civ")
				(disable-self)
			)
		#else ;if defined INCAN
			(defrule
				(true)
			=>
				(set-goal meso-civ yes)
				(chat-local-to-self "I am Incan")
				(disable-self)
			)
		#end-if
	#else ;if defined MAYAN
		(defrule
			(true)
		=>
			(set-goal meso-civ yes)
			(chat-local-to-self "I am Mayan")
			(disable-self)
		)
	#end-if
#else ;if defined AZTEC
	(defrule
		(true)
	=>
		(set-goal meso-civ yes)
		(chat-local-to-self "I am Aztec")
		(disable-self)
	)
#end-if

