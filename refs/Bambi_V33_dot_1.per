;region TRADING==========================
(defrule
	(not (up-research-status c: castle-age c:>= research-pending))
	(gold-amount < castle-gold)
	(food-amount > castle-food)
	(building-type-count-total blacksmith > 0)
	(not (town-under-attack))
	(can-sell-commodity wood)
=>
	(sell-commodity wood)
	(chat-to-player my-player-number "Sell wood to expedite castle-age research")	
)

(defrule
	(can-research ri-guilds)
	(or
		(wood-amount > 1200)
		(or
			(food-amount > 1700)
			(or
				(gold-amount > 1250)
				(stone-amount > 1400)
			)
		)
	)
=>
	(research ri-guilds)
)

(defrule
        (wood-amount > 1200)
        (or
                (food-amount < 1600)
                (or
                        (gold-amount < 1200)
                        (and
							(stone-amount < 650)
							(commodity-buying-price stone < 400)
						)
                )
        )
        (can-sell-commodity wood)
=>
        (chat-local-to-self "excess wood")
        (release-escrow wood)
        (sell-commodity wood)
)

(defrule
        (food-amount > 1700)
        (or
                (wood-amount < 1100)
                (or
                        (gold-amount < 1200)
                        (and
							(stone-amount < 650)
							(commodity-buying-price stone < 400)
						)
				)
        )
        (can-sell-commodity food)
=>
        (chat-local-to-self "excess food")
        (release-escrow food)
        (sell-commodity food)
)

(defrule
        (stone-amount > 1400)
        (or
                (wood-amount < 1100)
                (or
                        (food-amount < 1600)
                        (gold-amount < 1200)
                )
        )
        (can-sell-commodity stone)
=>
        (chat-local-to-self "excess stone")
        (release-escrow stone)
        (sell-commodity stone)
)

