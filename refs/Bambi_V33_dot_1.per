;region ATTACK STRATEGIES================================
;scoutrush
#load-if-not-defined DIFFICULTY-EASIEST
#load-if-not-defined DIFFICULTY-EASY
#load-if-not-defined UP-POCKET-POSITION
(defrule
	(goal gl-nomad no)
	(goal meso-civ no)
	(goal gl-walled-map no)
=>
	(set-goal gl-scrush yes)
	(chat-to-allies "Scrush strat set")
	(chat-local-to-self "Scrush strat set")
	(disable-self)
)

(defrule
	(up-research-status c: feudal-age c:< research-pending)
	(building-type-count barracks == 1)
	(goal gl-walled-map no)
=>
	(chat-local-to-self "I would like to propose a drush - please program this")
	(disable-self)
)
#end-if
#end-if
#end-if

(defrule
	(goal gl-scrush yes)
=>
	(up-reset-target-priorities priority-offense 1)
	(enable-timer timer-attack 1)
	(disable-self)
)

(defrule
	(goal gl-scrush yes)
=>
	(up-set-offense-priority c: house c: 5)
	(up-set-offense-priority c: archery-range c: 6)
	(up-set-offense-priority c: stable c: 7)
	(up-set-offense-priority c: barracks c: 8)
	(up-set-offense-priority c: mill c: 9)
	(up-set-offense-priority c: mining-camp c: 10)
	(up-set-offense-priority c: lumber-camp c: 11)
	(set-strategic-number sn-disable-tower-priority 1)
	(disable-self)
)

(defrule
	(goal gl-scrush yes)
	(unit-type-count scout-cavalry-line >= 6)
	(can-research-with-escrow ri-bloodlines)
=>
	(up-research gl-escrow-state c: ri-bloodlines)
)

(defrule
	(goal gl-scrush yes)
	(current-age == feudal-age)
	(not (players-current-age any-enemy >= castle-age))
	(players-unit-type-count any-enemy spearman-line == 0)
	(can-train-with-escrow scout-cavalry-line)
	(not (town-under-attack))
=>
	(up-train gl-escrow-state c: scout-cavalry-line)
)

(defrule
	(goal gl-scrush yes)
	(timer-triggered timer-attack)
	(current-age == feudal-age)
	(players-current-age every-enemy <= feudal-age)
	(players-unit-type-count any-enemy spearman-line == 0)
	(unit-type-count scout-cavalry-line >= 6)
	(not (town-under-attack))
=>
	(chat-to-allies "Executing Scout Rush")
)

(defrule
	(goal gl-scrush yes)
	(timer-triggered timer-attack)
	(current-age == feudal-age)
	(players-current-age every-enemy <= feudal-age)
	(players-unit-type-count any-enemy spearman-line == 0)
	(unit-type-count scout-cavalry-line >= 6)
	(not (town-under-attack))
=>
	(set-strategic-number sn-number-civilian-militia 0)
	(attack-now)
	(disable-timer timer-attack)
	(enable-timer timer-attack 100)
	(set-strategic-number sn-number-civilian-militia 10)
	(up-set-attack-stance scout-cavalry-line c: stance-defensive)
	(up-set-attack-stance spearman-line c: stance-defensive)
	(up-jump-rule 10000)
)

(defrule
	(or (unit-type-count scout-cavalry-line >= 6) (food-amount > 300))
	(goal gl-scrush yes)
	(can-research-with-escrow ri-forging)
	(research-completed ri-double-bit-axe)
	(research-completed ri-horse-collar)
=>
	(up-research gl-escrow-state c: ri-forging)
)

(defrule
	(or (unit-type-count scout-cavalry-line >= 6) (food-amount > 300))
	(goal gl-scrush yes)
	(research-completed ri-forging)
	(can-research-with-escrow ri-scale-barding)
=>
	(up-research gl-escrow-state c: ri-scale-barding)
)

(defrule
	(goal gl-scrush yes)
	(current-age == dark-age)
	(population >= 28)
=>
	(set-goal gl-scrush deactivate)
)

(defrule
	(goal gl-scrush yes)
	(or
		(or
			(or (players-current-age any-enemy >= castle-age)(game-time > 1200))
			(current-age >= castle-age)
		)
		(or
			(or (players-unit-type-count any-enemy spearman-line > 0)(players-military-population any-enemy >= 5))
			(and (town-under-attack) (up-attacker-class != gaia))
		)
	)
=>
	(set-goal gl-scrush deactivate)
)

(defrule
	(goal gl-scrush deactivate)
=>
	(set-goal gl-scrush no)
	(chat-to-allies "Deactivating scrush")
	(chat-local-to-self "Deactivating scrush")
	(disable-timer timer-attack)
	(enable-timer timer-attack 200)
)

(defrule
	(goal gl-scrush no)
	(timer-triggered timer-attack)
=>
	(up-reset-target-priorities priority-offense 0)
	(set-strategic-number sn-disable-tower-priority 0)
	;(up-retreat-now)
	;(up-reset-attack-now)
	(disable-timer timer-attack)
	(chat-to-allies "Scrush deactivated")
	(chat-local-to-self "Scrush deactivated")
	(up-set-attack-stance scout-cavalry-line c: stance-aggressive)
	(up-set-attack-stance spearman-line c: stance-aggressive)
	(disable-self)
)

