;MONKS==============================
(defrule
	(can-train-with-escrow monk)
	(goal gl-imperial-priority no)
=>
	(up-train gl-escrow-state c: monk)
	(set-goal gl-monk 50)
	(up-set-timer c: timer-train-monk g: gl-monk)
	(up-chat-data-to-self "Monk timer set first time: %d" g: gl-monk)
	(disable-self)
)

(defrule
	(can-train monk)
	(timer-triggered timer-train-monk)
	(goal gl-imperial-priority no)
=>
    (up-modify-goal gl-monk c:+ 50)
	(disable-timer timer-train-monk)
	(up-chat-data-to-self "Monk timer set to %d" g: gl-monk)
	(train monk)
	(up-set-timer c: timer-train-monk g: gl-monk)
)
;endregion

;region FEUDAL-AGE-DEFENSE-INITIATIVE=================================
(defrule
	(current-age == feudal-age)
	(town-under-attack)
	(building-type-count-total barracks == 1)
	(building-type-count barracks == 0)
	(can-build-with-escrow barracks)
=>
	(up-assign-builders c: barracks c: 5)
	(release-escrow wood)
	(build barracks)
	(chat-local-to-self "Trying to build 2nd emergency barracks")
)

(defrule
	(true)
=>
	(set-goal gl-feudal-defense no)
	(disable-self)
)

; #load-if-defined UP-POCKET-POSITION
; (defrule
	; (goal gl-feudal-defense no)
	; (or (building-type-count-total town-center >= 3) (goal gl-help-allies yes))
	; (up-research-status c: castle-age c:>= research-pending)
; =>
	; (set-goal gl-feudal-defense yes)
	; (chat-local-to-self "POCKET Feudal-Age Defense initiative activated")
; )
; #end-if


(defrule
	(goal gl-feudal-defense no)
	(up-research-status c: castle-age c:>= research-pending)
=>
	(set-goal gl-feudal-defense yes)
	(chat-local-to-self "Castling: Feudal-Age Defense initiative activated")
)

#load-if-not-defined UP-POCKET-POSITION
(defrule
	(goal gl-feudal-defense no)
	(players-military-population any-enemy > 3)
	(not (players-current-age any-enemy >= castle-age))
	(or (food-amount < lessnear-castle-food) (players-military-population any-enemy > 7))
	(not (up-research-status c: castle-age c:>= research-pending))
=>
	(set-goal gl-feudal-defense yes)
	(chat-local-to-self "Stop Fast Castle: Feudal-Age Defense initiative activated")
	(disable-self)
)
#end-if

(defrule ;rule for nomad
	(goal gl-nomad yes)
	(goal gl-feudal-defense no)
	(town-under-attack)
	(players-military-population any-enemy > 3)
	(not (players-current-age any-enemy >= castle-age))
	(or (food-amount < lessnear-castle-food) (players-military-population any-enemy > 7))
	(not (up-research-status c: castle-age c:>= research-pending))
=>
	(set-goal gl-feudal-defense yes)
	(chat-local-to-self "Under attack: Nomad Feudal-Age Defense initiative activated")
	(disable-self)
)

(defrule
	(goal gl-feudal-defense yes)
	(players-current-age any-enemy >= castle-age)
	(nand (town-under-attack)(not (up-attacker-class == gaia)))
	(not (up-research-status c: castle-age c:>= research-pending))
=>
	(set-goal gl-feudal-defense no)
	(chat-local-to-self "Hold Feudal-Age Defense Initiative to expedite Castle-Age: enemy in Castle")
)

(defrule
	(goal gl-feudal-defense yes)
	(timer-triggered timer-attack-detection)
	(nand (town-under-attack)(not (up-attacker-class == gaia)))
	(not (up-research-status c: castle-age c:>= research-pending))
=>
	(set-goal gl-feudal-defense no)
	(chat-local-to-self "Hold Feudal-Age Defense Initiative to expedite Castle-Age: unattacked for 120s")
	(disable-timer timer-attack-detection)
)

(defrule
	(goal gl-feudal-defense no)
	(town-under-attack)
	(not (up-attacker-class == gaia))
	;(or
		(strategic-number sn-maximum-town-size < 35)
		;(goal gl-help-allies yes)
	;)
=>
	(disable-timer timer-attack-detection)
	(set-goal gl-feudal-defense yes)
	(chat-local-to-self "Emergency Feudal-Age Defense initiative activated")
	(enable-timer timer-attack-detection 120)
)

(defrule
	;(military-population <= 25)
	(current-age == feudal-age)
	(can-train scout-cavalry-line)
	(unit-type-count-total scout-cavalry-line < 1)
	;(goal gl-feudal-defense yes)
	;(not (can-train-with-escrow knight-line))
=>
    (train scout-cavalry-line)
	(chat-local-to-self "Feudal Scout")
)

(defrule
	;(military-population <= 25)
	(current-age == feudal-age)
	(can-train eagles)
	(unit-type-count-total eagles < 1)
	;(goal gl-feudal-defense yes)
	;(not (can-train-with-escrow knight-line))
=>
    (train eagles)
	(chat-local-to-self "Feudal Eagle")
)

(defrule
	(military-population <= 25)
	(can-train scout-cavalry-line)
	(town-under-attack) 
	(goal gl-feudal-defense yes)
	(not (can-train-with-escrow knight-line))
=>
    (train scout-cavalry-line)
	(chat-local-to-self "Emergency feudal scout")
)

;======TOWERS========
#load-if-defined ARENA-MAP
(defrule
	(current-age == feudal-age)
	(strategic-number sn-placement-to-center == 0)
=>
	(set-strategic-number sn-placement-to-center 1)
)
#end-if

(defrule
	;(xor (up-research-status c: castle-age c:>= research-pending)(current-age == feudal-age))
	(military-population < 3)
	;(building-type-count castle == 0)
	(players-military-population any-enemy >= 5)
	(goal gl-activate-threatlevel yes)
	(building-type-count-total watch-tower < 1)
	(not (town-under-attack))
	; (or
		; (building-type-count blacksmith > 0)
		; (building-type-count dock > 0)
	; )
	(up-can-build 0 c: watch-tower)
=>
	(set-strategic-number sn-placement-zone-size 5)
	(up-set-placement-data my-player-number -1 c: towerdistance)
	(up-build place-control 0 c: watch-tower)
	(up-assign-builders c: watch-tower c: 3)
	(up-chat-data-to-player my-player-number "Building tower: target enemy: %d" s: sn-target-player-number)
	(up-chat-data-to-player my-player-number "Building tower: placement to center: %d" s: sn-placement-to-center)
	(up-jump-rule 10000)
)

(defrule
	;(or
		;(not (up-research-status c: castle-age c:>= research-pending))
		(military-population < 6)
	;)
	;(building-type-count castle == 0)
	(players-military-population any-enemy >= 10)
	(goal gl-activate-threatlevel yes)
	(building-type-count-total watch-tower < 3)
	(not (town-under-attack))
	;(building-type-count blacksmith > 0)
	(up-can-build 0 c: watch-tower)
=>
	(set-strategic-number sn-placement-zone-size 10)
	(up-set-placement-data my-player-number -1 c: towerdistance)
	(up-build place-control 0 c: watch-tower)
	(up-assign-builders c: watch-tower c: 3)
	(up-chat-data-to-player my-player-number "Building tower: target enemy: %d" s: sn-target-player-number)
	(up-chat-data-to-player my-player-number "Building tower: placement to center: %d" s: sn-placement-to-center)
	(up-jump-rule 10000)
)

