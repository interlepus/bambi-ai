;region RESEARCH===================================
;Cannon Galleon
(defrule
	(or (unit-type-count-total fishing-ship >= 4) (current-age == imperial-age))
	(unit-type-count-total cannon-galleon-line == 0)
	(can-train cannon-galleon-line)
=>
	(train cannon-galleon-line)
)
;Emphasis ri-pikeman=================
(defrule
	(goal gl-pikeman no)
	(not (civ-selected turkish))
	(not (civ-selected ethiopian))
	(not (up-research-status c: ri-pikeman c:>= research-pending))
	(building-type-count barracks > 0)
	(unit-type-count-total spearman-line > 0)
	;(goal gl-skirmisher-counter no)
=>
	(set-goal gl-pikeman yes)
	(chat-to-player my-player-number "Emphasis ri-pikeman activated")
)

(defrule
	(goal gl-pikeman yes)
	(or
		(up-research-status c: ri-pikeman c:>= research-pending)
		(or 
			(building-type-count barracks == 0) 
			(unit-type-count-total spearman-line == 0)
		)
	)
=>
	(set-goal gl-pikeman no)
	(chat-to-player my-player-number "Emphasis ri-pikeman de-activated")
)

; (defrule
	; (goal gl-pikeman yes)
	; (goal gl-skirmisher-counter yes)
	; (unit-type-count spearman-line < 8)
; =>
	; (set-goal gl-pikeman no)
	; (chat-to-player my-player-number "Emergency Emphasis ri-pikeman de-activated")
; )


(defrule
	;(unit-type-count-total spearman-line > 0)
	(can-research-with-escrow ri-pikeman)
	(goal gl-imperial-priority no)
=>
	(up-research gl-escrow-state c: ri-pikeman)
)
;=========================================

(defrule
	(can-research-with-escrow ri-double-bit-axe)
	(or
		(or
			(goal gl-feudal-defense yes)
			(or
				(goal gl-water-map yes)
				(and (goal gl-scrush yes)(building-type-count-total stable > 0))
			)
		)
		(or
			(current-age-time > 120)
			(players-military-population any-enemy > 1)
		)
	)
	;(building-type-count-total archery-range > 0)
=>
    (up-research gl-escrow-state c: ri-double-bit-axe)
	(chat-local-to-self "Researching Double Bit Axe rule 1")
)

(defrule
	(can-research-with-escrow ri-double-bit-axe)
	(and
		(food-amount > 950) 
		(or
			(gold-amount >= 200)
			(research-completed ri-gold-mining)
		)
	)
	;(building-type-count-total archery-range > 0)
=>
    (up-research gl-escrow-state c: ri-double-bit-axe)
	(chat-local-to-self "Researching Double Bit Axe rule 2")
)

