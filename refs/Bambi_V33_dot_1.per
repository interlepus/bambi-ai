;region scouting=================================
(defrule
	(goal gl-nomad yes)
	(building-type-count-total town-center == 0)
	(building-type-count lumber-camp == 0)
	(game-time < 180)
=>
	(set-strategic-number sn-percent-civilian-explorers 100)
	(set-strategic-number sn-cap-civilian-explorers 10)
    (set-strategic-number sn-number-explore-groups 15)
	(set-strategic-number sn-total-number-explorers 15)
	(set-strategic-number sn-minimum-civilian-explorers 5)
	(chat-local-to-self "sn-percent-civilian-explorers 100")
	(disable-self)
)

(defrule
	(goal gl-nomad yes)
	(building-type-count-total town-center == 0)
	(building-type-count-total lumber-camp > 0)
	;(game-time < 180)
=>
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-explorers 0)	;don't scout with villagers
    (set-strategic-number sn-number-explore-groups 1)
	(set-strategic-number sn-total-number-explorers 1) ;scout with one scouting unit!
	(chat-local-to-self "sn-cap-civilian-explorers 0")
	(disable-self)
)

(defrule
	(goal gl-nomad yes)
	(building-type-count town-center > 0)
	(building-type-count house == 0)
	(building-available house)
	(can-build house)
=>
	(set-strategic-number sn-percent-civilian-explorers 100)
	(set-strategic-number sn-minimum-civilian-explorers 5)
	(set-strategic-number sn-cap-civilian-explorers 5)
    (set-strategic-number sn-total-number-explorers 5)
    (set-strategic-number sn-number-explore-groups 5)
	(chat-local-to-self "sn-percent-civilian-explorers 100")
	(disable-self)
)

(defrule
	(goal gl-nomad yes)
	(building-type-count town-center > 0)
	(or
		(building-type-count house > 0)
		(not (building-available house))
	)
	(unit-type-count-total scout-cavalry-line == 0)
	(unit-type-count-total eagles == 0)
	(unit-type-count-total wkeagles == 0)
=>
	(set-strategic-number sn-percent-civilian-explorers 34)
	(set-strategic-number sn-minimum-civilian-explorers 1)
	(set-strategic-number sn-cap-civilian-explorers 1)
    (set-strategic-number sn-total-number-explorers 1)
    (set-strategic-number sn-number-explore-groups 1)
	(set-strategic-number sn-percent-half-exploration 100)
	(chat-local-to-self "sn-percent-civilian-explorers 34")
	(disable-self)
)

(defrule
	(goal gl-nomad yes)
	(or
		(unit-type-count scout-cavalry-line > 0)
		(or (unit-type-count eagles > 0)(unit-type-count wkeagles > 0))
	)
=>
	(set-strategic-number sn-minimum-civilian-explorers 0)
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-explorers 0)
	;(up-reset-scouts)
	(set-strategic-number sn-number-explore-groups 1)
	(set-strategic-number sn-total-number-explorers 1) ;scout with one scouting unit!
	(chat-local-to-self "sn-percent-civilian-explorers 0 nomad")
	(disable-self)
)

;(defrule
;	(goal gl-nomad yes)
;	(or
;		(unit-type-count scout-cavalry-line > 0)
;		(or (unit-type-count eagles > 0)(unit-type-count wkeagles > 0))
;	)
;=>
;	(up-reset-scouts)
;	(chat-local-to-self "try scout reset")
;	(disable-self)
;)

(defrule
	(goal gl-nomad no)
=>
	(set-strategic-number sn-cap-civilian-explorers 10)
	(set-strategic-number sn-percent-civilian-explorers 100)
    (set-strategic-number sn-number-explore-groups 1)
	(set-strategic-number sn-total-number-explorers 11)

	(disable-self)
)

(defrule
	(goal gl-nomad no)
	(military-population == 0)
	(unit-type-count villager  >= 3)
	(game-time < 300)
=>
	(set-strategic-number sn-percent-civilian-explorers 34)
	(set-strategic-number sn-minimum-civilian-explorers 1)
	(set-strategic-number sn-cap-civilian-explorers 1)
    (set-strategic-number sn-total-number-explorers 1)
    (set-strategic-number sn-number-explore-groups 1)
	(set-strategic-number sn-percent-half-exploration 100)

	(disable-self)
)


(defrule
	(goal gl-nomad no)
	(military-population > 0)
	(or
		(or
			(unit-type-count livestock-class > 0)
			(unit-type-count villager-shepherd > 0)
		)
		(or
			(or
				(resource-found food)
				(game-time > 60)
			)
			(building-type-count farm > 0)
		)
		
	)
=>
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-explorers 0)	;don't scout with villagers
    (set-strategic-number sn-number-explore-groups 1)
	(set-strategic-number sn-total-number-explorers 1) ;scout with one scouting unit!

	(disable-self)
)

(defrule
	(game-time > 3600)
=>
	(set-strategic-number sn-number-explore-groups 0)
	(set-strategic-number sn-total-number-explorers 0)
		;stop scouting after an hour
	(disable-self)
)

(defrule
	(game-time > 600)
	;(goal gl-scrush yes)
=>
	(up-send-scout 101 scout-flank)
	(disable-self)
)

(defrule
	(game-time > 780)
	;(goal gl-scrush yes)
=>
	(up-send-scout 101 scout-mirror)
	(disable-self)
)

(defrule
	(game-time > 960)
	;(goal gl-scrush yes)
=>
	(up-send-scout 101 scout-opposite)
	(disable-self)
)

(defrule
	(game-time > 1140)
	;(goal gl-scrush yes)
=>
	(up-send-scout 101 scout-enemy)
	(disable-self)
)

(defrule
	(up-get-fact gaia-type-count-total 126 seen-wolf)
	(up-compare-goal seen-wolf > 0)
=>
	(chat-to-player my-player-number "I have spotted a wolf with gaia type count total")
	(disable-self)
)

