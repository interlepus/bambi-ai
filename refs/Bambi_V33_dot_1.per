 =>
	 (set-strategic-number sn-allow-civilian-offense 2)
	 (set-strategic-number sn-allow-civilian-defense 3)
	 (set-strategic-number sn-number-civilian-militia 30)
	 (chat-local-to-self "Spanish Bloodlust activated")
	 (disable-self)
 )
