(defrule
	(strategic-number sn-focus-player-number != 0)
=>
	(set-strategic-number sn-focus-player-number 0)
)

(defrule
	(current-age == feudal-age)
	(escrow-amount food > castle-food)
=>
	(up-modify-escrow food c:= castle-food)
	(chat-to-player my-player-number "Fail-safe food-amount for castle")
)

(defrule
	(or
		(and (current-age == feudal-age) (up-research-status c: castle-age c:>= research-pending))
		(current-age == castle-age)
	)
	(building-type-count-total town-center == 1)
	(escrow-amount wood > two-TC-wood)
=>
	(up-modify-escrow wood c:= two-TC-wood)
	(chat-to-player my-player-number "Fail-safe wood-amount 2 TCs")
)

(defrule
	(current-age >= castle-age)
	(building-type-count-total town-center == 1)
	(or
		(escrow-amount wood > two-TC-wood)
		(wood-amount > two-TC-wood)
	)
	(stone-amount < 100)
	(can-buy-commodity stone)
=>
	(buy-commodity stone)
	(chat-to-player my-player-number "Fail-safe buy-stone 2nd TC")
)

(defrule
	(or
		(and (current-age == feudal-age) (up-research-status c: castle-age c:>= research-pending))
		(current-age == castle-age)
	)
	(building-type-count-total town-center == 2)
	(escrow-amount wood > TC-wood)
=>
	(up-modify-escrow wood c:= TC-wood)
	(chat-to-player my-player-number "Fail-safe wood-amount for 1 TC")
)

(defrule
	(current-age >= castle-age)
	(building-type-count-total town-center == 2)
	(or
		(escrow-amount wood > TC-wood)
		(wood-amount > TC-wood)
	)
	(stone-amount < 100)
	(can-buy-commodity stone)
=>
	(buy-commodity stone)
	(chat-to-player my-player-number "Fail-safe buy-stone 3rd TC")
)

(defrule
	(current-age == castle-age)
	(escrow-amount food > imperial-food)
=>
	(up-modify-escrow food c:= imperial-food)
	(chat-to-player my-player-number "Fail-safe food-amount for imp")
)

(defrule
	(current-age == castle-age)
	(escrow-amount gold > imperial-gold)
=>
	(up-modify-escrow gold c:= imperial-gold)
	(chat-to-player my-player-number "Fail-safe gold-amount for imp")
)

(defrule
	(current-age == imperial-age)
	(escrow-amount wood > 200)
=>
	(up-modify-escrow wood c:= 200)
	(chat-to-player my-player-number "Fail-safe wood-amount treb")
)

(defrule
	(current-age == imperial-age)
	(escrow-amount gold > 200)
=>
	(up-modify-escrow gold c:= 200)
	(chat-to-player my-player-number "Fail-safe gold-amount treb")
)

