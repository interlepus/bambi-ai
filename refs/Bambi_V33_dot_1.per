;region initial strategic numbers========================================
(defrule
	(true)
=>
	
	(set-strategic-number sn-enable-patrol-attack 1)
	(set-strategic-number sn-percent-attack-soldiers 100)
	;(set-strategic-number sn-percent-enemy-sighted-response 100)
	;(set-strategic-number sn-disable-sighted-response-cap 1)
	(set-strategic-number sn-enemy-sighted-response-distance 40) ; was on 50 but may be buggy in DE
;	(set-strategic-number sn-attack-separation-time 60)
	(set-strategic-number sn-wall-targeting-mode 1)
	(set-strategic-number sn-minimum-attack-group-size 1)
	(set-strategic-number sn-maximum-attack-group-size 1)
	(set-strategic-number sn-attack-group-size-randomness 0)
	(set-strategic-number sn-consecutive-idle-unit-limit 1)
	;(set-strategic-number sn-max-retask-gather-amount 0)
	(set-goal meso-civ unknown)
	(set-goal gl-water-map unknown)
	(set-strategic-number sn-object-repair-level 2)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-percent-attack-boats 100)
	(set-strategic-number sn-minimum-boat-attack-group-size 1)
	(set-strategic-number sn-maximum-boat-attack-group-size 1)
	(set-strategic-number sn-local-targeting-mode 1) ;used to be 1 but maybe buggy in DE ??
	(set-strategic-number sn-coop-share-attacking 1)
	(set-strategic-number sn-coop-share-information 1)
	(set-goal gl-market-zone 0)
	(set-goal gl-pikeman no)
	(fe-reset-attack-group-exclusion-list)
	(disable-self)
)

(defrule 
    (true)
=>
    (set-strategic-number sn-initial-exploration-required 0)
    (set-strategic-number sn-defer-dropsite-update 1)
    (set-strategic-number sn-enable-boar-hunting 0) ;no boars or deer
	(set-strategic-number sn-maximum-hunt-drop-distance 32)
	(set-strategic-number sn-maximum-food-drop-distance 32)
	(set-strategic-number sn-maximum-gold-drop-distance 40)
	(set-strategic-number sn-maximum-stone-drop-distance 40)
	(set-strategic-number sn-mill-max-distance 30)
	(set-strategic-number sn-dropsite-separation-distance 5)
	(set-strategic-number sn-allow-adjacent-dropsites 1)
	(set-strategic-number sn-blot-exploration-map 0)
	(set-strategic-number sn-camp-max-distance 20)
    (disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-intelligent-gathering 1)
	(set-strategic-number sn-minimum-number-hunters 0)
	(set-strategic-number sn-minimum-boar-hunt-group-size 0)
	(set-strategic-number sn-cap-civilian-builders 10)
	(set-strategic-number sn-home-exploration-time 480)
	(set-strategic-number sn-percent-civilian-gatherers 0)
	(set-strategic-number sn-sentry-distance-variation 20)
	(set-strategic-number sn-enable-offensive-priority 1)
	(set-strategic-number sn-zero-priority-distance 255)
	(set-strategic-number sn-villager-attack-reset 0)
	(set-strategic-number sn-allow-gathering-sea-fish-with-villagers 1)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-livestock-to-town-center 1)
	(set-goal gl-loom no)
	(set-strategic-number sn-enable-new-building-system 1)
	(set-strategic-number sn-percent-building-cancellation 10)
	(set-goal gl-escrow-state with-escrow)
	(set-strategic-number sn-placement-fail-delta 0)
	(set-strategic-number sn-placement-zone-size 20)
	(set-goal gl-castle-placement 10)
	(set-strategic-number sn-town-center-placement lumber-camp)
	(set-goal gl-emergency-rebuild no)
	(set-strategic-number sn-disable-trade-evasion 1) ;enemy attack trade evasion
	(set-goal gl-help-allies no)
	(up-modify-goal gl-enemy-TC-distance c:= 255)
	(disable-self)
)

(defrule
	(or
		(goal gl-nomad yes)
		(goal gl-land-nomad yes)
	)
	(strategic-number sn-disable-trade-evasion == 1)
=>
	(set-strategic-number sn-disable-trade-evasion 0)
)

