(defrule
	;(strategic-number sn-number-civilian-militia != 30)
	(strategic-number sn-allow-civilian-defense == 3)
	(current-age >= castle-age)
	(or
		(up-compare-goal gl-pop-cap > 15)
		(civilian-population < numbercivilians)
	)
=>
	(set-strategic-number sn-allow-civilian-offense 0)
	(set-strategic-number sn-allow-civilian-defense 1)
	(chat-to-player my-player-number "Overboom reset and civilian offense de-activated")
)

