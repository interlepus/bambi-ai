;region TSA=======================================================
(defrule
	(true)
=>
	(set-goal gl-imperial-notsa no)
	(set-goal gl-tsa yes)
	(disable-self)
)

(defrule
	(goal gl-imperial-notsa no)
	(or (players-building-type-count any-enemy castle >= 2) (players-current-age any-enemy >= imperial-age))
	(current-age <= castle-age)
=>
	(set-goal gl-imperial-notsa yes)
)

(defrule
	(goal gl-imperial-notsa yes)
	(current-age == imperial-age)
=>
	(set-goal gl-imperial-notsa no)
)

(defrule
	(or (goal gl-tsa yes)(goal gl-tsa fail-safe))
=>
	(set-goal gl-tsa no)
)

; #load-if-defined UP-POCKET-POSITION
; (defrule ;pocket TSA
	; (goal gl-tsa no)
	; (goal gl-help-allies yes)
	; (up-building-type-in-town c: castle == 0)
	; (up-building-type-in-town c: town-center == 0)
	; (up-building-type-in-town c: watch-tower == 0)
	; (up-building-type-in-town c: bombard-tower == 0)
	; (not (town-under-attack))
; =>
	; (set-goal gl-tsa yes)
; )
; #end-if

; (defrule ;2v2 TSA
	; (goal gl-tsa no)
	; (up-players-in-game ally == 2)	
	; (goal gl-help-allies yes)
	; (up-building-type-in-town c: castle == 0)
	; (up-building-type-in-town c: town-center == 0)
	; (up-building-type-in-town c: watch-tower == 0)
	; (up-building-type-in-town c: bombard-tower == 0)
	; (not (town-under-attack))
; =>
	; (set-goal gl-tsa yes)
; )

(defrule ;STANDARD TSA
	(goal gl-tsa no)
	
	(or (players-building-type-count every-enemy castle == 0) (or (unit-type-count battering-ram-line > 1)(unit-type-count trebuchet-set > 0)))
	(goal gl-imperial-notsa no)
	
	(up-building-type-in-town c: castle == 0)
	(up-building-type-in-town c: town-center == 0)
	(up-building-type-in-town c: watch-tower == 0)
	(up-building-type-in-town c: bombard-tower == 0)
	(not (town-under-attack))
=>
	(set-goal gl-tsa yes)
)

(defrule ;near pop cap tsa - need breating space
	(or
		(goal gl-tsa no)
		(goal gl-tsa yes)
	)
	
	(up-compare-goal gl-pop-cap < 10)
	
	(up-building-type-in-town c: castle == 0)
	(up-building-type-in-town c: town-center == 0)
	(up-building-type-in-town c: watch-tower == 0)
	(up-building-type-in-town c: bombard-tower == 0)
	(not (town-under-attack))
=>
	(set-goal gl-tsa fail-safe)
)

(defrule ;help allies tsa
	(or
		(goal gl-tsa no)
		(goal gl-tsa yes)
	)
	
	(goal gl-help-allies yes)
	
	(up-building-type-in-town c: castle == 0)
	(up-building-type-in-town c: town-center == 0)
	(up-building-type-in-town c: watch-tower == 0)
	(up-building-type-in-town c: bombard-tower == 0)
	(not (town-under-attack))
=>
	(set-goal gl-tsa fail-safe)
)	

