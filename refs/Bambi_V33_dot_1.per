(defrule
	(up-get-fact building-type-count-total town-center gl-number-town-centers)
	(up-compare-goal gl-number-castles g:> gl-number-town-centers)
	(can-build town-center)
=>
	(build town-center)
	(chat-local-to-self "Extra boom - extra TC")
)

(defrule
	(can-research ri-spies)
=>
	(research ri-spies)
	(chat-to-player my-player-number "Spies researched")
)

(defrule
	(current-age == castle-age)
	(current-age-time > 120)
	(unit-type-count villager-gold == 0)
	(not (town-under-attack))
=>
	(up-modify-sn sn-maximum-gold-drop-distance c:+ 20)
	(chat-to-player my-player-number "Fail-safe gold gathering extension to 60")
	(disable-self)
)

(defrule
	(current-age == castle-age)
	(unit-type-count villager-stone == 0)
	(current-age-time > 300)
	(not (town-under-attack))
=>
	(up-modify-sn sn-maximum-stone-drop-distance c:+ 20)
	(chat-to-player my-player-number "Fail-safe stone gathering extension to 60")
	(disable-self)
)
	
	
