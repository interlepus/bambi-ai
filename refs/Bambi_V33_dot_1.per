;region VARIABLES
(defrule
	(true)
=>
	(up-get-fact military-population 0 gl-my-army)
	;(up-chat-data-to-self "my army: %d" g: gl-my-army)
)

(defrule
	(civilian-population < 25)
	(strategic-number sn-object-repair-level != 2)
=>
	(set-strategic-number sn-object-repair-level 2)
	(chat-local-to-self "General repairs deactivated, TC repairs only")
)

(defrule
	(civilian-population > 25)
	(strategic-number sn-object-repair-level != 24575)
=>
	(set-strategic-number sn-object-repair-level 24575)
	(chat-local-to-self "Repairs activated")	;no wall/gate repair
)

(defrule
	(game-time < 1800)
=>
	(up-find-player enemy find-closest gl-closest-enemy)
	(up-modify-sn sn-target-player-number g:= gl-closest-enemy)
)

#load-if-defined UP-POCKET-POSITION
(defrule
	(game-time > 5)
=>
	(set-goal gl-pocket-position yes)
	(chat-to-player my-player-number "I am pocket")
	(disable-self)
)
#else
(defrule
	(game-time > 5)
=>
	(set-goal gl-pocket-position no)
	(chat-to-player my-player-number "I am not a pocket")
	(disable-self)
)
#end-if

(defrule
	(game-time > 8)
	(up-compare-goal gl-number-allies != 3)
	(up-players-in-game ally == 3)
	(game-time < 2500)
=>
	(set-goal gl-number-allies 3)
	(chat-to-player my-player-number "I have 2 allies")
)

(defrule
	(game-time > 8)
	(up-compare-goal gl-number-allies != 3)
	(up-players-in-game ally == 4)
	(game-time < 2500)
=>
	(set-goal gl-number-allies 3)
	(chat-to-player my-player-number "I have 3 allies")
)

(defrule
	(game-time > 8)
	(up-compare-goal gl-number-allies == 3)
	(up-players-in-game ally < 3)
	(game-time < 2500)
=>
	(set-goal gl-number-allies 0)
	(chat-to-player my-player-number "I'm losing allies")
)

(defrule
	(up-compare-goal gl-number-allies == 3)
	(game-time > 2500)
=>
	(set-goal gl-number-allies 0)
	(chat-to-player my-player-number "gl-number-allies default reset")
)	

(defrule
	(true)
=>
	(set-goal gl-superiority yes)
	(disable-self)
)

(defrule
	(goal gl-superiority no)
	(players-military-population every-enemy g:<= gl-my-army)
=>
	(set-goal gl-superiority yes)
	(chat-local-to-self "I have superiority")
)

(defrule
	(goal gl-superiority yes)
	(players-military-population any-enemy g:> gl-my-army)
=>
	(set-goal gl-superiority no)
	(chat-local-to-self "No superiority")
)

(defrule
	(true)
=>
	(up-get-fact game-time 0 gl-game-time)
	(up-modify-goal gl-game-time c:/ popdivider)
	;(up-get-fact-min any-ally population 0 gl-check-ally-population)
)
;endregion

;region NOMAD-MAP
; (defconst gl-point-x 150)
; (defconst gl-point-y 151)
; (defrule
	; (true)
; =>
	; (up-get-point position-self gl-point-x)
	; (up-send-flare gl-point-x)
; )

(defrule
	(goal gl-nomad unknown)
	(game-time < 10)
	(building-type-count town-center == 0)
=>
	(set-goal gl-nomad yes)
	(chat-local-to-self "nomad initiated")
	(disable-self)
)

(defrule
	(goal gl-land-nomad unknown)
	(game-time < 10)
	(building-type-count-total town-center == 0)
	(wood-amount < 275)
=>
	(set-goal gl-land-nomad yes)
	(chat-local-to-self "land nomad initiated")
	(disable-self)
)

(defrule
	(game-time < 10)
	(goal gl-land-nomad unknown)
	(goal gl-nomad yes)
	(wood-amount >= 275)
=>
	(set-goal gl-land-nomad no)
	(chat-local-to-self "nomad but not classic land nomad")
	(disable-self)
)

(defrule
	(building-type-count town-center > 0)
	(game-time < 10)
=>
	(set-goal gl-nomad no)
	(disable-self)
)

(defrule
	(goal gl-nomad yes)
	(goal gl-pocket-position yes)
=>
	(set-goal gl-pocket-position no)
	(chat-to-player my-player-number "I am not a pocket because of nomad")
	(disable-self)
)

 ;(defrule
	; (goal gl-nomad yes)
	; (building-type-count town-center > 0)
	; (can-build house)
	; (building-type-count-total house == 0)
	; ;(up-pending-objects c: house == 0)
; =>
	; (up-set-placement-data my-player-number -1 c: 0)
	; (up-build place-control 0 c: house)
	; (disable-self)
; )	

(defrule ;lumber camps
	(resource-found wood)
	(goal gl-nomad yes)
	(building-type-count town-center > 0)
	(building-type-count-total lumber-camp == 0) 
	(or
		(building-type-count house > 0)
		(not (building-available house))
	)
    (can-build lumber-camp)
=>
    (up-retask-gatherers wood c: 1)
	(build lumber-camp)
	(up-modify-sn sn-camp-max-distance c:+ 2)
)

; (defrule
	; (goal gl-land-nomad yes)
	; (building-type-count lumber-camp == 0)
	; (not (resource-found wood))
	; (can-build lumber-camp)
	; (up-pending-objects c: lumber-camp < 1)
; =>
	; (up-jump-rule 10000)
; )

(defrule
	(goal gl-nomad yes)
=>
	(set-strategic-number sn-camp-max-distance 255)
	(disable-self)
)

(defrule
	(goal gl-land-nomad yes)
=>
	(set-strategic-number sn-camp-max-distance 30)
	(disable-self)
)

#load-if-defined LAND-NOMAD-MAP
(defrule
	(goal gl-nomad yes)
=>
	(chat-local-to-self "DE Land Nomad Map Detected")
	(set-strategic-number sn-camp-max-distance 30)
	(disable-self)
)	
	
#end-if

; (defrule
	; (goal gl-land-nomad yes)	
	; (up-pending-placement c: lumber-camp)
	; (building-type-count-total lumber-camp == 0)
; =>
	; (up-reset-placement c: lumber-camp)
; )

(defrule
	(goal gl-land-nomad yes)
	(building-type-count lumber-camp == 0)
	(resource-found wood)
	(can-build lumber-camp)
	(up-pending-objects c: lumber-camp < 1)
=>
	(up-assign-builders c: lumber-camp c: 6)
	(build lumber-camp)
	(chat-to-all "Land nomad LC 6 vills")
	(set-goal gl-LN-LC-debug 5)
	(disable-self)
	;(up-jump-rule 10000)
)

