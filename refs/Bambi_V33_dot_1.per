;region COMMUNICATION
; (defrule
	; (game-time > 180)
; =>
	; (chat-to-allies "You can taunt 249 to know my resources")
	; (disable-self)
; )

(defrule
	(taunt-detected any-human-ally 249)
=>
	(up-get-fact food-amount 0 gl-food)
	(up-get-fact wood-amount 0 gl-wood)
	(up-get-fact gold-amount 0 gl-gold)
	(up-get-fact stone-amount 0 gl-stone)
	(acknowledge-taunt this-any-human-ally 249)
	(up-chat-data-to-player this-any-human-ally "Food: %d" g: gl-food)
	(up-chat-data-to-player this-any-human-ally "Wood: %d" g: gl-wood)
	(up-chat-data-to-player this-any-human-ally "Gold: %d" g: gl-gold)
	(up-chat-data-to-player this-any-human-ally "Stone: %d" g: gl-stone)
)

(defrule
	(population g:< gl-game-time)
=>
	(enable-timer timer-ask-help 1)
	(disable-self)
)

(defrule
	(population g:< gl-game-time)
	(timer-triggered timer-ask-help)
	(goal gl-nomad no)
	(game-time < 4000)
=>
	(chat-to-allies "I need help!")
	(disable-timer timer-ask-help)
	(enable-timer timer-ask-help 100)
)
;endregion

;region Trade carts and Market Placements=================================
(defrule 
	(player-in-game any-ally)
	(current-age >= feudal-age)
	(can-research-with-escrow ri-cartography)
	(goal gl-feudal-defense yes)
	(goal gl-imperial-priority no)
=>
	(release-escrow food)
	(release-escrow gold)
	(research ri-cartography)
)

(defrule
	(current-age == feudal-age)
	(player-in-game any-ally)
	(players-building-type-count any-ally market > 0)
	(unit-type-count-total trade-cart < 5)
	(can-train trade-cart)
	(nand ;when trying to save for castle don't make carts
		(and
			(and
				(food-amount > 600)
				(gold-amount < 250)	
			)
			(and 
				(unit-type-count villager-gold > 0)
				(dropsite-min-distance gold <= 5)
			) 
		)
		(up-research-status c: castle-age c:< research-pending)
	)
	;(goal gl-feudal-defense yes)
	;(goal gl-imperial-priority no)
=>
	(train trade-cart)
)

(defrule
	(current-age == castle-age)
	(player-in-game any-ally)
	(players-building-type-count any-ally market > 0)
	(unit-type-count-total trade-cart < 10)
	(can-train trade-cart)
	;(goal gl-feudal-defense yes)
	;(goal gl-imperial-priority no)
=>
	(train trade-cart)
)

(defrule
	(current-age == imperial-age)
	(player-in-game any-ally)
	(players-building-type-count any-ally market > 0)
	(unit-type-count-total trade-cart < 15)
	(can-train trade-cart)
	;(goal gl-feudal-defense yes)
	;(goal gl-imperial-priority no)
=>
	(train trade-cart)
)

(defrule
	(goal gl-superiority yes)
	(current-age == imperial-age)
	(player-in-game any-ally)
	(players-building-type-count any-ally market > 0)
	(unit-type-count-total trade-cart < 5)
	(can-train-with-escrow trade-cart)
	;(goal gl-feudal-defense yes)
	;(goal gl-imperial-priority no)
=>
	(up-train gl-escrow-state c: trade-cart)
)

(defrule
	(gold-amount < 1000)
	(player-in-game any-ally)
	(current-age == imperial-age)
	(players-building-type-count any-ally market > 0)
	(unit-type-count-total trade-cart >= 15)
	(up-object-type-count-total c: trade-cart g:< gl-trade-gold)
	(can-train trade-cart)
	;(goal gl-imperial-priority no)
=>
	(train trade-cart)
	(chat-local-to-self "Trade is going well, training extra trade cart")
)

(defrule 
	(player-in-game any-ally)
	(players-building-type-count any-ally market > 0)
	(current-age >= castle-age)
	(can-research-with-escrow ri-caravan)
	(goal gl-imperial-priority no)
	(or (goal gl-pikeman no) (food-amount > 600))
=>
	(release-escrow food)
	(release-escrow gold)
	(research ri-caravan)
)

(defrule ;try building market
	;(wood-amount > 400)
	;(building-type-count-total archery-range > 0)
	(building-type-count-total blacksmith > 0)
	(or
		(building-type-count-total stable > 0)
		(building-type-count-total archery-range > 0)
	)	
	(building-type-count-total market < 1)
	(nand (up-research-status c: castle-age c:>= research-pending)(building-type-count-total town-center < 3))
	(up-pending-objects c: market == 0)
	(up-can-build 0 c: market)
=>
	(up-set-placement-data my-player-number -1 c: 0)
	(up-build place-control 0 c: market)
	(chat-local-to-self "market")
)

(defrule ;try building market
	;(wood-amount > 400)
	;(building-type-count-total archery-range > 0)
	(building-type-count-total blacksmith > 0)
	(or
		(building-type-count-total stable > 0)
		(building-type-count-total archery-range > 0)
	)	
	(building-type-count-total market < 1)
	(wood-amount > 1000)
	(up-pending-objects c: market == 0)
	(up-can-build 0 c: market)
=>
	(up-set-placement-data my-player-number -1 c: 0)
	(up-build place-control 0 c: market)
	(chat-local-to-self "market fail-safe")
)

(defrule
	(up-players-in-game ally == 2)
	(players-building-type-count any-ally market > 0)
	(wood-amount > 400)
	(building-type-count-total market < 2)
	(up-can-build 0 c: market)
=>
	(up-find-player ally find-closest gl-ally)
	(up-modify-sn sn-target-player-number g:= gl-ally)
)

(defrule
	(up-players-in-game ally == 3)
	(players-building-type-count any-ally market > 0)
	(wood-amount > 400)
	(building-type-count-total market < 2)
	(up-can-build 0 c: market)
=>
	(up-find-player ally find-closest gl-ally)
	(up-find-next-player ally find-closest gl-ally)
	(up-modify-sn sn-target-player-number g:= gl-ally)
)

(defrule
	(up-players-in-game ally == 4)
	(players-building-type-count any-ally market > 0)
	(wood-amount > 400)
	(building-type-count-total market < 2)
	(up-can-build 0 c: market)
=>
	(up-find-player ally find-closest gl-ally)
	(up-find-next-player ally find-closest gl-ally)
	(up-find-next-player ally find-closest gl-ally)
	(up-modify-sn sn-target-player-number g:= gl-ally)
)

(defrule
	(up-players-in-game ally == 5)
	(players-building-type-count any-ally market > 0)
	(wood-amount > 400)
	(building-type-count-total market < 2)
	(up-can-build 0 c: market)
=>
	(up-find-player ally find-closest gl-ally)
	(up-find-next-player ally find-closest gl-ally)
	(up-find-next-player ally find-closest gl-ally)
	(up-find-next-player ally find-closest gl-ally)
	(up-modify-sn sn-target-player-number g:= gl-ally)
)

(defrule
	(up-players-in-game ally == 6)
	(players-building-type-count any-ally market > 0)
	(wood-amount > 400)
	(building-type-count-total market < 2)
	(up-can-build 0 c: market)
=>
	(up-find-player ally find-closest gl-ally)
	(up-find-next-player ally find-closest gl-ally)
	(up-find-next-player ally find-closest gl-ally)
	(up-find-next-player ally find-closest gl-ally)
	(up-find-next-player ally find-closest gl-ally)
	(up-modify-sn sn-target-player-number g:= gl-ally)
)

(defrule
	(up-players-in-game ally == 7)
	(players-building-type-count any-ally market > 0)
	(wood-amount > 400)
	(building-type-count-total market < 2)
	(up-can-build 0 c: market)
=>
	(up-find-player ally find-closest gl-ally)
	(up-find-next-player ally find-closest gl-ally)
	(up-find-next-player ally find-closest gl-ally)
	(up-find-next-player ally find-closest gl-ally)
	(up-find-next-player ally find-closest gl-ally)
	(up-find-next-player ally find-closest gl-ally)
	(up-modify-sn sn-target-player-number g:= gl-ally)
)

; (defrule
	; (true)
; =>
	; (up-chat-data-to-self "%d" s: sn-target-player-number)
; )

(defrule
	(up-pending-placement c: market)
	(building-type-count-total market < 1)
	(up-timer-status timer-market-debug == timer-disabled)
=>
	(enable-timer timer-market-debug 300)
	(up-chat-data-to-player my-player-number "Debug timer market placement SN: %d" s: sn-placement-zone-size)
)

(defrule
	(not (up-pending-placement c: market))
	(building-type-count-total market < 1)
	(up-timer-status timer-market-debug == timer-running)
=>
	(disable-timer timer-market-debug)
	(up-chat-data-to-player my-player-number "Stop debug timer market placement SN: %d" s: sn-placement-zone-size)
)

(defrule
	(timer-triggered timer-market-debug)
	(up-pending-placement c: market)
	(building-type-count-total market < 1)
=>
	(disable-timer timer-market-debug)
	(up-reset-placement c: market)
	(up-chat-data-to-player my-player-number "Debug reset market placement SN: %d" s: sn-placement-zone-size)
	(enable-timer timer-market-debug 300)
)

(defrule
	(up-pending-placement c: market)
	(building-type-count-total market >= 1)
	(up-timer-status timer-market-debug == timer-disabled)
=>
	(enable-timer timer-market-debug 300)
	(up-chat-data-to-player my-player-number "Debug timer market placement: %d" g: gl-market-zone)
)

(defrule
	(not (up-pending-placement c: market))
	(building-type-count-total market >= 1)
	(up-timer-status timer-market-debug == timer-running)
=>
	(disable-timer timer-market-debug)
	(up-chat-data-to-player my-player-number "Stop debug timer market placement: %d" g: gl-market-zone)
)

(defrule
	(timer-triggered timer-market-debug)
	(up-pending-placement c: market)
	(building-type-count-total market >= 1)
=>
	(disable-timer timer-market-debug)
	(up-reset-placement c: market)
	(up-modify-goal gl-market-zone c:+ 1)
	(up-chat-data-to-player my-player-number "Debug reset market placement: %d" g: gl-market-zone)
	(enable-timer timer-market-debug 300)
)

; (defrule
	; (up-compare-goal gl-market-zone > 20)
; =
	; (up-modify-goal gl-market-zone c:= 20)
	; (chat-to-player my-player-number "Debug placement-zone too large market")
; )

(defrule ;try market away from ally
	(player-in-game any-ally)
	(players-building-type-count any-ally market > 0)
	(wood-amount > 500)
	(building-type-count-total market == 1)
	(up-pending-objects c: market == 0)
	(up-can-build 0 c: market)
=>
	;(set-strategic-number sn-placement-to-center 1)
	(up-modify-sn sn-placement-zone-size g:= gl-market-zone)
	(up-set-placement-data my-player-number -1 c: -120)
	(up-build place-control 0 c: market)
	(up-chat-data-to-player my-player-number "market away from ally with player number %d" s: sn-target-player-number)
	(up-jump-rule 10000)
)

(defrule
	(up-compare-sn sn-target-player-number != 0)
=>
	(set-strategic-number sn-target-player-number 0)
	;(set-strategic-number sn-placement-zone-size 20)
	;(up-chat-data-to-self "Reset target player number to 0 check: %d" s: sn-target-player-number)
)

(defrule ;try market away from center
	(player-in-game any-ally)
	(players-building-type-count any-ally market > 0)
	(wood-amount > 750)
	(building-type-count-total market == 2)
	(up-pending-objects c: market == 0)
	(up-can-build 0 c: market)
=>
	(set-strategic-number sn-placement-to-center 1)
	(up-modify-sn sn-placement-zone-size g:= gl-market-zone)
	(up-set-placement-data my-player-number -1 c: -120)
	(up-build place-control 0 c: market)
	(chat-local-to-self "market away from center")
	(up-jump-rule 10000)
)

(defrule
	(strategic-number sn-placement-to-center == 1)
=>
	(set-strategic-number sn-placement-to-center 0)
)

(defrule ;try market away from enemy
	(player-in-game any-ally)
	(players-building-type-count any-ally market > 0)
	(wood-amount > 1000)
	(building-type-count-total market == 3)
	(up-pending-objects c: market == 0)
	(up-can-build 0 c: market)
=>
	;(set-strategic-number sn-placement-to-center 1)
	(up-modify-sn sn-placement-zone-size g:= gl-market-zone)
	(up-set-placement-data my-player-number -1 c: -120)
	(up-build place-control 0 c: market)
	(chat-local-to-self "market away from enemy")
	(up-jump-rule 10000)
)

(defrule
	(strategic-number sn-placement-zone-size != 20)
=>
	(set-strategic-number sn-placement-zone-size 20)
)
;endregion

;region TRIBUTING================================
(defrule
	(taunt-detected any-ally 4)
	;(building-type-count market > 0)
=>
	(acknowledge-taunt this-any-ally 4)
	(tribute-to-player this-any-ally wood 150)
	(chat-to-player my-player-number "Taunt 4 detected and acknowledged")
)

; (defrule
    ; (true)
    ; =>
    ; (up-find-player ally find-random gl-temp)
    ; (up-modify-sn sn-focus-player-number g:= gl-temp))

(defrule
	(player-in-game any-ally)
	(or
		(wood-amount > 1200)
		(or
			(food-amount > 1700)
			(or
				(gold-amount > 1250)
				(stone-amount > 1400)
			)
		)
	)
	;(players-building-type-count any-ally market > 0)
	(can-research ri-coinage)
=>
	(research ri-coinage)
)

(defrule
	(player-in-game any-ally)
	(or
		(wood-amount > 1200)
		(or
			(food-amount > 1700)
			(or
				(gold-amount > 1250)
				(stone-amount > 1400)
			)
		)
	)
	;(players-building-type-count any-ally market > 0)
	(can-research ri-banking)
=>
	(research ri-banking)
)

