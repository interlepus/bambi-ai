;Eagles Counter======================
(defrule
	(unit-type-count-total militiaman-line > 0)
	(can-research-with-escrow ri-man-at-arms)
	(goal gl-imperial-priority no)
	(goal gl-feudal-defense yes)
=>
	(up-research gl-escrow-state c: ri-man-at-arms)
)

(defrule
	(unit-type-count-total militiaman-line > 2)
	(can-research-with-escrow ri-long-swordsman)
	(goal gl-imperial-priority no)
	(goal gl-feudal-defense yes)
	(or (goal gl-pikeman no) (food-amount > 600))
=>
	(up-research gl-escrow-state c: ri-long-swordsman)
)

(defrule
	(unit-type-count-total militiaman-line > 4)
	(can-research ri-two-handed-swordsman)
=>
	(research ri-two-handed-swordsman)
)

(defrule
	(unit-type-count-total militiaman-line > 6)
	(can-research ri-champion)
=>
	(research ri-champion)
)

(defrule
	(or	(up-unit-type-in-town c: eagles > 1)(up-unit-type-in-town c: wkeagles > 1))
	(can-train militiaman-line)
	(goal gl-imperial-priority no)
	(goal gl-feudal-defense yes)
	;(goal gl-skirmisher-counter no)
=>
	(chat-local-to-self "More than 1 eagle in town")
	(train militiaman-line)
)

(defrule
	(up-unit-type-in-town c: skirmisher-line > 1)
	(can-train militiaman-line)
	(goal gl-imperial-priority no)
	(goal gl-feudal-defense yes)
	(goal gl-skirmisher-counter no)
=>
	(train militiaman-line)
	(chat-local-to-self "More than 1 skirmisher in town")
)

(defrule
	(or	
		(players-unit-type-count any-enemy eagles >= 5)
		(players-unit-type-count any-enemy wkeagles >= 5)
	)
	(can-train militiaman-line)
	(goal gl-imperial-priority no)
	(goal gl-feudal-defense yes)
	(goal gl-skirmisher-counter no)
	(not (town-under-attack))
=>
	(train militiaman-line)
	(chat-local-to-self "Enemy has 5 or more eagles")
)

(defrule
	(players-unit-type-count any-enemy skirmisher-line >= 10)
	(can-train militiaman-line)
	(goal gl-imperial-priority no)
	(goal gl-feudal-defense yes)
	(goal gl-skirmisher-counter no)
	(not (town-under-attack))
=>
	(train militiaman-line)
	(chat-local-to-self "Enemy has 10 or more skirmishers")
)
