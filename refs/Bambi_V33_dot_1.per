    (can-train eagles)
	(goal gl-imperial-priority no)
	(goal gl-feudal-defense yes)
=>
    (train eagles)
	(chat-local-to-self "train eagle rule 1")
)

(defrule
    (can-train wkeagles)
	(goal gl-imperial-priority no)
	(goal gl-feudal-defense yes)
=>
