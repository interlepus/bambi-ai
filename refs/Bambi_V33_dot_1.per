(defrule
	(wood-amount > 1200)
	(up-get-fact-min any-ally resource-amount wood gl-ally-min-wood)
	;(player-in-game this-any-ally)
	(up-compare-goal gl-ally-min-wood < 600)
=>
	(tribute-to-player this-any-ally wood 100)
	;(chat-local-to-self "tributing wood")
)
	
(defrule
	(food-amount > 1700)
	(up-get-fact-min any-ally resource-amount food gl-ally-min-food)
	;(player-in-game this-any-ally)
	(up-compare-goal gl-ally-min-food < 1000)
=>
	(tribute-to-player this-any-ally food 100)
	;(chat-local-to-self "tributing food")
)

(defrule
	(gold-amount > 1250)
	(up-get-fact-min any-ally resource-amount gold gl-ally-min-gold)
	;(player-in-game this-any-ally)
	(up-compare-goal gl-ally-min-gold < 800)
=>
	(tribute-to-player this-any-ally gold 50)
	;(chat-local-to-self "tributing gold")
)

(defrule
	(stone-amount > 1400)
	(up-get-fact-min any-ally resource-amount stone gl-ally-min-stone)
	;(player-in-game this-any-ally)
	(up-compare-goal gl-ally-min-stone < 650)
=>
	(tribute-to-player this-any-ally stone 100)
	;(chat-local-to-self "tributing stone")
)
