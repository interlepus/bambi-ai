		(unit-type-count-total scout-cavalry-line > 1) 
		(unit-type-count-total infantry-class > 0)
	)
	(goal gl-feudal-defense yes)
	(goal gl-imperial-priority no)
	(nand (current-age == castle-age) (and (goal gl-pikeman yes) (food-amount < 500)))
=>
	(up-research gl-escrow-state c: ri-forging)
)

(defrule
    (up-research-status c: castle-age c:>= research-pending)
	(can-research-with-escrow ri-forging)
	(or (or (unit-type-count-total cavalry-class > 0)(unit-type-count-total scout-cavalry-line > 1)) (unit-type-count-total infantry-class > 0))
	(goal gl-feudal-defense yes)
	(goal gl-imperial-priority no)
	(nand (current-age == castle-age) (and (goal gl-pikeman yes) (food-amount < 500)))
=>
	(up-research gl-escrow-state c: ri-forging)
)

