;region WATER=======================================
#load-if-not-defined YUCATAN-MAP
#load-if-not-defined OASIS-MAP
#load-if-not-defined ALPINE-LAKES-MAP
(defrule
	(true)
=>
	(set-strategic-number sn-dock-training-filter 2)
	(disable-self)
)

(defrule
	(game-time > 100)
	(cc-players-unit-type-count 0 deep-fish-class > 0)
=>
	(chat-to-player my-player-number "Watermap detected")
	(set-strategic-number sn-dock-training-filter 0)
	(set-goal gl-water-map yes)
	(disable-self)
)

(defrule
	(can-build dock)
	;(goal gl-water-map yes)
	(building-type-count-total dock < 1)
	(building-type-count-total town-center > 0)
	(building-type-count-total lumber-camp > 0)
	(or
		(building-type-count-total house > 0)
		(not (building-available house))
	)
	(or (building-type-count-total mill > 0)(building-type-count-total folwark > 0))
	;(building-type-count-total blacksmith > 0)
=>
	(disable-timer timer-docks)
	(build dock)
	(enable-timer timer-docks 600)
)

(defrule
	(timer-triggered timer-docks)
	(can-build dock)
=>
	(disable-timer timer-docks)
	(build dock)
	(enable-timer timer-docks 600)
)

(defrule
	(building-type-count dock > 0)
	(building-type-count-total watch-tower == 0)
=>
	(set-strategic-number sn-placement-zone-size 0)
	(up-set-placement-data my-player-number dock c: 0)
	(up-build place-control 0 c: watch-tower)
	(up-assign-builders c: watch-tower c: 3)
)

(defrule
	(strategic-number sn-placement-zone-size != 20)
=>
	(set-strategic-number sn-placement-zone-size 20)
)

