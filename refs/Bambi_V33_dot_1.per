	(or
		(goal gl-nomad yes)
		(goal gl-land-nomad yes)
	)
	(building-type-count-total lumber-camp > 0)
	(current-age == dark-age)
	(idle-farm-count < 1)
    (can-build farm)
	(up-pending-objects c: farm < 1)
	(food-amount < 2000)
=>
    (build farm)
)

