;region FAIL-SAFE and ATTACK GROUPS=================
#load-if-not-defined DIFFICULTY-EASIEST
#load-if-not-defined DIFFICULTY-EASY
#load-if-not-defined DIFFICULTY-MODERATE
(defrule
	(current-age >= castle-age)
	(can-train villager)
	(up-compare-goal gl-pop-cap > 20)
=>
	(train villager)
)
#end-if
#end-if
#end-if

(defrule
	(strategic-number sn-number-civilian-militia != 30)
	(strategic-number sn-allow-civilian-defense == 1)
	(up-compare-goal gl-pop-cap < 10)
	(current-age >= castle-age)
	(civilian-population > numbercivilians)
=>
	(set-strategic-number sn-allow-civilian-offense 2)
	(set-strategic-number sn-allow-civilian-defense 3)
	(set-strategic-number sn-number-civilian-militia 10)
	(set-strategic-number sn-number-attack-groups 100)
	(set-strategic-number sn-number-boat-attack-groups 100)
	(chat-to-player my-player-number "Overboomed: civilian offense and attack groups activated")
)

