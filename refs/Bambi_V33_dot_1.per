)

(defrule
	(players-military-population any-enemy g:> gl-my-army)
	(can-train-with-escrow eagles)
	(goal gl-feudal-defense yes)
	(up-research-status c: castle-age c:>= research-pending)
=>
	(up-train gl-escrow-state c: eagles)
	(chat-local-to-self "train eagle rule 2")
)

