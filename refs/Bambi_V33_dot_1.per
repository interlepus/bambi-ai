	(goal gl-loom yes)
	(can-research-with-escrow ri-loom)
=>
	(release-escrow gold)
	(research ri-loom)
)

(defrule
	(food-amount < 50)
	(current-age == dark-age)
=>
	(up-drop-resources food c: 5)
)

(defrule
	(civilian-population < numbercivilians)
	(can-train-with-escrow villager)
=>
	(up-train gl-escrow-state c: villager)
)

(defrule
	(civilian-population < numbercivilians)
	(can-train-with-escrow villager)
=>
	(up-train gl-escrow-state c: villager)
)

(defrule
	(civilian-population < numbercivilians)
	(can-train-with-escrow villager)
=>
	(up-train gl-escrow-state c: villager)
)

(defrule
    (can-research ri-loom)
	(or
		(building-type-count-total house > 1)
		(not (building-available house))
	)
=>
    (research ri-loom)
)

(defrule
	(can-research ri-loom)
	(up-pending-objects c: house == 0)
	(game-time > 15)
=>
	(research ri-loom)
)

(defrule
	(can-research ri-loom)
	(goal gl-nomad yes)
=>
	(research ri-loom)
