;region BUILDINGS ========================================
(defrule
	;(goal gl-nomad no)
	(up-pending-placement c: house)
=>
	(up-reset-placement c: house)
	(chat-local-to-self "Reset house")
	(up-jump-rule 10000)
)

; (defrule
	; (goal gl-nomad yes)
	; (building-type-count town-center > 0)
	; (can-build house)
	; (building-type-count-total house == 0)
	;; (up-pending-objects c: house == 0)
; =>
	; (up-set-placement-data my-player-number -1 c: 0)
	; (up-build place-control 0 c: house)
	; (disable-self)
; )	

(defrule ;we need houses!
    ;(goal gl-nomad no)
	(building-type-count town-center > 0)
	(building-type-count-total house == 0)
    (can-build house)
	(up-pending-objects c: house == 0)
=>
	(up-assign-builders c: house c: 3)
	(up-set-placement-data my-player-number villager-class c: 0)
	(up-build place-control 0 c: house)
	(chat-local-to-self "Villager house")
	;(enable-timer timer-first-house 10)
	(disable-self)
)

(defrule ;we need houses!
    ;(goal gl-nomad no)
	(unit-type-count scout-cavalry > 0)
	(building-type-count town-center > 0)
	(building-type-count-total house == 0)
    (can-build house)
	(up-pending-objects c: house == 0)
=>
	(up-assign-builders c: house c: 3)
	(up-set-placement-data my-player-number scout-cavalry c: 0)
	(up-build place-control 0 c: house)
	(chat-local-to-self "Cavalry house")
	;(enable-timer timer-first-house 10)
	(disable-self)
)

(defrule ;we need houses!
    ;(goal gl-nomad no)
	(unit-type-count eagles > 0)
	(building-type-count town-center > 0)
	(building-type-count-total house == 0)
    (can-build house)
	(up-pending-objects c: house == 0)
=>
	(up-assign-builders c: house c: 3)
	(up-set-placement-data my-player-number eagles c: 0)
	(up-build place-control 0 c: house)
	(chat-local-to-self "Eagle house")
	;(enable-timer timer-first-house 10)
	(disable-self)
)

(defrule ;we need houses!
    ;(goal gl-nomad no)
	(building-type-count town-center > 0)
	(building-type-count-total house == 0)
    (can-build house)
	(up-pending-objects c: house == 0)
=>
	(up-assign-builders c: house c: 3)
	(build house)
	(chat-local-to-self "Classic first house")
	;(enable-timer timer-first-house 10)
)

(defrule
	;(goal gl-nomad no)
	(building-type-count house > 0)
=>
	(up-assign-builders c: house c: 1)
	;(disable-timer timer-first-house)
)	

(defrule ;we need houses!
    (not (building-type-count-total house == 0))
	(current-age == dark-age)
    (housing-headroom < 5) ;if we are nearly housed
    (population-headroom > 0) ;if we are not population blocked
    (can-build house)
	(up-pending-objects c: house == 0)
=>
    (build house)
;	(chat-local-to-self "Headroom house dark age")
)

(defrule ;we need houses!
    (current-age == feudal-age)
    (housing-headroom < 10) ;if we are nearly housed
    (population-headroom > 0) ;if we are not population blocked
    (can-build house)
	(up-pending-objects c: house == 0)
=>
    (build house)
)

(defrule ;we need houses!
    (current-age == castle-age)
    (housing-headroom < 15) ;if we are nearly housed
    (population-headroom > 0) ;if we are not population blocked
    (can-build house)
	(up-pending-objects c: house == 0)
=>
    (build house)
)

(defrule ;we need houses!
    (current-age == imperial-age)
    (housing-headroom < 20) ;if we are nearly housed
    (population-headroom > 0) ;if we are not population blocked
    (can-build house)
	(up-pending-objects c: house == 0)
=>
    (build house)
)

(defrule ;first lumber camp
	(building-type-count town-center > 0)
	(civilian-population > 8)
	(building-type-count-total lumber-camp == 0)    
    (can-build lumber-camp)
	(resource-found wood)
=>
	(build lumber-camp)
	(up-modify-sn sn-camp-max-distance c:+ 2)
)

(defrule
	(building-type-count lumber-camp == 1)
	(building-type-count town-center > 0)
=>
	(chat-local-to-self "First LC built, release escrow wood")
	(release-escrow wood)
	(disable-self)
)

(defrule ;other lumber camps
	(building-type-count town-center > 0)
	(civilian-population > 8)
    (dropsite-min-distance wood > 2) ;if the closest tree is more than 2 tiles away from a dropoff point
    (can-build lumber-camp)
	(up-pending-objects c: lumber-camp == 0)
	(resource-found wood)
=>
	(build lumber-camp)
	(up-modify-sn sn-camp-max-distance c:+ 2)
)

(defrule ;other lumber camps
	(building-type-count town-center > 0)
	(civilian-population > 8)
    (dropsite-min-distance wood > 3) ;if the closest tree is more than 3 tiles away from a dropoff point
    (can-build-with-escrow lumber-camp)
	(up-pending-objects c: lumber-camp == 0)
	(resource-found wood)
=>
	(up-build place-normal gl-escrow-state c: lumber-camp)
	(up-modify-sn sn-camp-max-distance c:+ 2)
)

(defrule
	(civilian-population > 8)
	(resource-found wood)
	(up-pending-objects c: lumber-camp == 0)
	(dropsite-min-distance wood > 4)
	(escrow-amount wood < 100)
=>
	(up-modify-escrow wood c:= 100)
)

(defrule ;mills 1
	(or
		(building-type-count-total house > 0)
		(not (building-available house))
	)
	(building-type-count-total mill == 0)
	;(building-type-count-total lumber-camp > 0)
	(and (resource-found food) (unit-type-count villager-forager > 0))
    (can-build mill)
=>
    (set-strategic-number sn-preferred-mill-placement 0)
	(build mill)
)

(defrule ;mills 2
	(building-type-count-total town-center > 0)
	(building-type-count-total mill == 0)
	(building-type-count-total lumber-camp > 0)
	(or
		(and
			(game-time > 60)
			(unit-type-count-total villager-food <= 2)
		)
		(unit-type-count-total villager > 10)
	)
	(can-build mill)
=>
	(build mill)
	(chat-to-player my-player-number "Building mill")
)

(defrule ;mills 3
	(current-age == dark-age)
	(building-type-count-total town-center > 0)
	(building-type-count-total mill == 0)
	(building-type-count-total lumber-camp == 0)
	(game-time > 120)
	(unit-type-count-total villager-food <= 2)
	(wood-amount > 200)
	(food-amount < 50)
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(up-modify-sn sn-camp-max-distance c:+ 2)
	(chat-to-player my-player-number "Building emergency LC")
)

(defrule ;mills 4
	(current-age == dark-age)
	(building-type-count-total town-center > 0)
	(building-type-count-total mill == 0)
	(building-type-count-total lumber-camp > 0)
	(game-time > 120)
	(unit-type-count-total villager-food <= 2)
	(wood-amount > 300)
	(food-amount < 50)
	(can-build mill)
=>
	(build mill)
	(chat-to-player my-player-number "Building emergency mill")
)

(defrule ;folwark 1
	(or
		(building-type-count-total house > 0)
		(not (building-available house))
	)
	(building-type-count-total folwark == 0)
	;(building-type-count-total lumber-camp > 0)
	(and (resource-found food) (unit-type-count villager-forager > 0))
    (can-build folwark)
=>
    (set-strategic-number sn-preferred-mill-placement 0)
	(build folwark)
)

(defrule ;folwark 2
	(building-type-count-total town-center > 0)
	(building-type-count-total folwark == 0)
	(building-type-count-total lumber-camp > 0)
	(or
		(and
			(game-time > 60)
			(unit-type-count-total villager-food <= 2)
		)
		(unit-type-count-total villager > 10)
	)
	(can-build folwark)
=>
	(build folwark)
	(chat-to-player my-player-number "Building folwark")
)

(defrule ;folwark 3
	(current-age == dark-age)
	(building-type-count-total town-center > 0)
	(building-type-count-total folwark == 0)
	(building-type-count-total lumber-camp == 0)
	(game-time > 120)
	(unit-type-count-total villager-food <= 2)
	(wood-amount > 200)
	(food-amount < 50)
	(can-build lumber-camp)
=>
	(build lumber-camp)
	(up-modify-sn sn-camp-max-distance c:+ 2)
	(chat-to-player my-player-number "Building emergency LC")
)

(defrule ;folwark 4
	(current-age == dark-age)
	(building-type-count-total town-center > 0)
	(building-type-count-total folwark == 0)
	(building-type-count-total lumber-camp > 0)
	(game-time > 120)
	(unit-type-count-total villager-food <= 2)
	(wood-amount > 300)
	(food-amount < 50)
	(can-build folwark)
=>
	(build folwark)
	(chat-to-player my-player-number "Building emergency folwark")
)

(defrule ;mills 5 /folwark
	(or (building-type-count-total mill > 0)(building-type-count-total folwark > 0))
	(building-type-count-total lumber-camp > 0)
	(or (building-type-count-total farm > 0)(food-amount > 2000))
	(or (building-type-count-total mining-camp > 0) (and (wood-amount > 400)(up-research-status c: feudal-age c:>= research-pending)))
	(building-type-count-total barracks == 0)
    (can-build-with-escrow barracks)
=>
    (up-build place-normal gl-escrow-state c: barracks)
)

(defrule ;debugs keep building mines near end of game, spaces it out with 5 minutes per mining camp
	(true)
=>
	(enable-timer timer-debug-gold-mine yes)
	(enable-timer timer-debug-stone-mine yes)
	(disable-self)
)

(defrule
	(not (civilian-population < 20))
	(resource-found gold)
	(building-type-count-total mining-camp == 0)
	(can-build mining-camp)
	(up-pending-objects c: mining-camp == 0)
	(or (food-amount >= feudal-food) (up-research-status c: feudal-age c:>= research-pending))
=>
	(disable-timer timer-debug-gold-mine)
	(build mining-camp)
	(enable-timer timer-debug-gold-mine 600)
	(up-modify-sn sn-camp-max-distance c:+ 2)
	(chat-to-player my-player-number "Gold mining camp initiation rule")
	(disable-self)
)	

(defrule ;mining camps
    (timer-triggered timer-debug-gold-mine)
	(unit-type-count villager-gold > 0)
    (dropsite-min-distance gold > 2)
    (can-build-with-escrow mining-camp)
	(resource-found gold)
	(up-pending-objects c: mining-camp == 0)
=>
    (disable-timer timer-debug-gold-mine)
	(up-build place-normal gl-escrow-state c: mining-camp)
	(up-modify-sn sn-camp-max-distance c:+ 2)
	(enable-timer timer-debug-gold-mine 600)
	(chat-to-player my-player-number "Standard gold mining camp")
)

(defrule ;mill
	(xnor (goal gl-water-map yes) (building-type-count-total dock > 0))
	(xnor (goal gl-scrush yes) (building-type-count-total stable > 0))
	(building-type-count town-center > 0)
	(building-type-count-total mill == 1)
	;(building-type-count-total mining-camp >= 1)
	(dropsite-min-distance deer-hunting > 15)
	(dropsite-min-distance deer-hunting s:<= sn-maximum-hunt-drop-distance)
	(can-build mill)
	;(unit-type-count villager-food >= 8)
	(strategic-number sn-minimum-number-hunters < 1)
	(strategic-number sn-minimum-boar-hunt-group-size < 1)
	(up-pending-objects c: mill == 0)
	(goal gl-superiority yes)
=>
	;(set-strategic-number sn-allow-adjacent-dropsites 1); test
	(set-strategic-number sn-preferred-mill-placement 1); mill deer or boar
	(build mill)
)

(defrule ;folwark
	(xnor (goal gl-water-map yes) (building-type-count-total dock > 0))
	(xnor (goal gl-scrush yes) (building-type-count-total stable > 0))
	(building-type-count town-center > 0)
	(building-type-count-total folwark == 1)
	;(building-type-count-total mining-camp >= 1)
	(dropsite-min-distance deer-hunting > 15)
	(dropsite-min-distance deer-hunting s:<= sn-maximum-hunt-drop-distance)
	(can-build folwark)
	;(unit-type-count villager-food >= 8)
	(strategic-number sn-minimum-number-hunters < 1)
	(strategic-number sn-minimum-boar-hunt-group-size < 1)
	(up-pending-objects c: folwark == 0)
=>
	;(set-strategic-number sn-allow-adjacent-dropsites 1); test
	(set-strategic-number sn-preferred-mill-placement 1); mill deer or boar
	(build folwark)
)

(defrule
    (current-age >= castle-age)
	(goal meso-civ yes)
	(building-type-count-total mill > 0)
	(building-type-count-total lumber-camp > 0)
	(or (building-type-count-total farm > 1)(food-amount > 2000))
	(building-type-count-total barracks < 2)
	(building-type-count-total town-center > 1)
    (can-build barracks)
=>
    (up-assign-builders c: barracks c: 1)
	(build barracks)
)

(defrule
    (current-age >= castle-age)
	(goal meso-civ yes)
	(building-type-count-total folwark > 0)
	(building-type-count-total lumber-camp > 0)
	(or (building-type-count-total farm > 1)(food-amount > 2000))
	(building-type-count-total barracks < 2)
	(building-type-count-total town-center > 1)
    (can-build barracks)
=>
    (up-assign-builders c: barracks c: 1)
	(build barracks)
)

(defrule
    (current-age >= castle-age)
	(or (wood-amount > 300)(goal meso-civ yes))
	(building-type-count-total mill > 0)
	(building-type-count-total lumber-camp > 0)
	(or (building-type-count-total farm > 1)(food-amount > 2000))
	(building-type-count-total barracks < 3)
	(building-type-count town-center > 2)
    (can-build barracks)
=>
    (up-assign-builders c: barracks c: 1)
	(build barracks)
)

(defrule
    (current-age >= castle-age)
	(or (wood-amount > 300)(goal meso-civ yes))
	(building-type-count-total folwark > 0)
	(building-type-count-total lumber-camp > 0)
	(or (building-type-count-total farm > 1)(food-amount > 2000))
	(building-type-count-total barracks < 3)
	(building-type-count town-center > 2)
    (can-build barracks)
=>
    (up-assign-builders c: barracks c: 1)
	(build barracks)
)

(defrule
    (timer-triggered timer-debug-stone-mine)
	(unit-type-count villager-stone > 0)
    (dropsite-min-distance stone > 2)
	;(building-type-count-total town-center > 2)
	(can-build-with-escrow mining-camp)
	(up-pending-objects c: mining-camp == 0)
	(resource-found stone)
	(or
		(building-type-count stable > 0)
		(building-type-count archery-range > 0)
	)
	(building-type-count mining-camp < 2)
=>
	(disable-timer timer-debug-stone-mine)
	(up-retask-gatherers stone c: 1)
	(up-build place-normal gl-escrow-state c: mining-camp)
	(up-modify-sn sn-camp-max-distance c:+ 2)
	(enable-timer timer-debug-stone-mine 600)
	(chat-to-player my-player-number "Standard stone mining camp")
)

(defrule
    (timer-triggered timer-debug-stone-mine)
	(unit-type-count villager-stone > 0)
    (dropsite-min-distance stone > 2)
	;(building-type-count-total town-center > 2)
	(can-build-with-escrow mining-camp)
	(up-pending-objects c: mining-camp == 0)
	(resource-found stone)
	(building-type-count mining-camp >= 2)
=>
	(disable-timer timer-debug-stone-mine)
	(up-retask-gatherers stone c: 1)
	(up-build place-normal gl-escrow-state c: mining-camp)
	(up-modify-sn sn-camp-max-distance c:+ 2)
	(enable-timer timer-debug-stone-mine 600)
	(chat-to-player my-player-number "Standard stone mining camp")
)


(defrule
	(timer-triggered timer-debug-stone-mine)
	(timer-triggered timer-debug-gold-mine)
	(building-type-count-total mining-camp >= 2)
	(can-build mining-camp)
=>
	(disable-timer timer-debug-stone-mine)
	(disable-timer timer-debug-gold-mine)
	(build mining-camp)
	(enable-timer timer-debug-stone-mine 600)
	(enable-timer timer-debug-gold-mine 600)
	(up-modify-sn sn-camp-max-distance c:+ 2)
	(chat-to-player my-player-number "Placing extra mining camp. Next extra one in minimum 10 minutes")
)

(defrule
    (building-type-count-total town-center > 0)
	(building-type-count-total stable < 1)
    (can-build-with-escrow stable)
	(goal meso-civ no)
=>
	(up-assign-builders c: stable c: 2)
	(up-build place-normal gl-escrow-state c: stable)
)

(defrule
    (building-type-count-total town-center > 0)
	(building-type-count-total archery-range < 1)
    (can-build-with-escrow archery-range)
	(goal meso-civ yes)
=>
	(up-assign-builders c: archery-range c: 2)
	(up-build place-normal gl-escrow-state c: archery-range)
)

(defrule
    (building-type-count-total blacksmith == 0)
	(or
		(building-type-count-total stable >= 1)
		(building-type-count-total archery-range >= 1)
	)
    (can-build-with-escrow blacksmith)
=>
    (up-assign-builders c: blacksmith c: 2)
	(up-build place-normal gl-escrow-state c: blacksmith)
	(set-escrow-percentage wood 0)
)

(defrule
	(building-type-count-total blacksmith > 0)
	(building-type-count-total stable >= 1)
	(building-type-count-total archery-range == 0)
    (can-build-with-escrow archery-range)
=>
	(up-build place-normal gl-escrow-state c: archery-range)
)

(defrule
    (building-type-count-total town-center < 3)
	(can-build-with-escrow town-center)
=>
    (up-assign-builders c: town-center-foundation c: 3)
	(up-build place-normal gl-escrow-state c: town-center)
)

(defrule
    (or (building-type-count town-center > 2) (wood-amount > 300))
	(building-type-count-total monastery < 1)
	(can-build-with-escrow monastery)
=>
	(up-build place-normal gl-escrow-state c: monastery)
)

; UNIVERSITY
(defrule
    (or (building-type-count town-center > 2) (wood-amount > 400))
	(building-type-count-total university < 1)
	(or	(building-type-count-total siege-workshop > 0) (building-type-count-total castle > 0))
	(can-build university)
=>
    (up-set-placement-data my-player-number -1 c: 0)
	(up-build place-control 0 c: university)
)

(defrule
    (or (building-type-count town-center > 2) (wood-amount > 400))
	(building-type-count-total siege-workshop < 1)
	(can-build siege-workshop)
=>
	(build siege-workshop)
)

(defrule
    (goal gl-skirmisher-counter yes)
	(goal gl-superiority no)
	(building-type-count-total siege-workshop < 1)
	(can-build siege-workshop)
=>
	(build siege-workshop)
	(chat-local-to-self "Expedited Siege Workshop")
)

(defrule
	(or (building-type-count university > 0) (wood-amount > 400))
	(or (building-type-count siege-workshop > 0) (wood-amount > 400))
	(building-type-count town-center > 2)
	(current-age >= castle-age)
    (building-type-count-total stable < 2)
    (can-build stable)
=>
    (build stable)
)

(defrule
    (or (building-type-count university > 0) (wood-amount > 400))
	(or (building-type-count siege-workshop > 0) (wood-amount > 400))
	(building-type-count town-center > 2)
	(or
		(building-type-count-total stable > 1)
		(goal meso-civ yes)
	)
	(current-age >= castle-age)
	(building-type-count-total archery-range < 2)
    (can-build archery-range)
=>
    (build archery-range)
)

(defrule
	(or (building-type-count town-center > 2) (wood-amount > 350))
	(or (current-age == imperial-age) (up-research-status c: imperial-age c:>= research-pending))
	(building-type-count-total stable < 3)
    (can-build stable)
=>
    (build stable)
)

(defrule
	(or (building-type-count town-center > 2) (wood-amount > 350))
	(or (current-age == imperial-age) (up-research-status c: imperial-age c:>= research-pending))
	(building-type-count-total archery-range < 3)
    (can-build archery-range)
=>
    (build archery-range)
)

;CASTLES & BOMBARD TOWERS & KREPOSTS =================================
(defrule
	(true)
=>
	;(enable-timer timer-castle-fail-safe 200)
	(set-goal gl-castle-forward no)
	(disable-self)
)

(defrule
	(can-build castle)
=>
	(up-get-fact building-type-count castle gl-number-castles)
	(up-modify-goal gl-castle-placement c:= 10)
	(up-modify-goal gl-castle-placement g:* gl-number-castles)
	(up-modify-goal gl-castle-placement c:+ 10)
)

(defrule
    ;(timer-triggered timer-castle-fail-safe)
	(or (goal gl-castle-forward no) (or (players-building-type-count any-enemy castle >= 1) (players-military-population any-enemy g:> gl-my-army)))
	(can-build castle)
	(not (research-completed ri-bombard-tower))
	(not (goal gl-castle-forward fail-safe))
=>
   ;(disable-timer timer-castle-fail-safe)
	(up-assign-builders c: castle c: 6)
	(up-set-placement-data my-player-number -1 g: gl-castle-placement)
	(up-build place-control 0 c: castle)
	(set-goal gl-castle-forward fail-safe)
	;(enable-timer timer-castle-fail-safe 100)
	(up-jump-rule 10000)
)

(defrule
	(goal gl-castle-forward fail-safe)
	(can-build castle)
	(not (research-completed ri-bombard-tower))
=>
	(up-assign-builders c: castle c: 6)
	(up-set-placement-data my-player-number -1 c: 0)
	(up-build place-control 0 c: castle)
	(set-goal gl-castle-forward yes)
)

;#load-if-not-defined GOLD-RUSH-MAP
(defrule
    (goal gl-castle-forward yes)
	(can-build castle)
	(not (research-completed ri-bombard-tower))
=>
    (up-assign-builders c: castle c: 6)
	(build-forward castle)
	(set-goal gl-castle-forward no)
)
;#end-if

