		)
	)
=>
	(set-goal gl-skirmisher-counter yes)
	;(chat-local-to-self "Skirmisher Defense initiative ON")
)

(defrule
	(unit-type-count-total skirmisher-line > 0)
	(can-research-with-escrow ri-elite-skirmisher)
	;(goal gl-imperial-priority no)
	;(goal gl-feudal-defense yes)
=>
    ;(release-escrow gold)
	(up-research gl-escrow-state c: ri-elite-skirmisher)
)

(defrule
	(current-age == castle-age)
	(not (up-research-status c: imperial-age c:>= research-pending))
	(unit-type-count-total skirmisher-line > 0)
	(not (can-research-with-escrow ri-elite-skirmisher))
	(not (up-research-status c: ri-elite-skirmisher c:>= research-pending))
	(unit-type-count town-center >= 3)
	(research-available ri-elite-skirmisher)
	(escrow-amount wood < 200)
=>
	(up-modify-escrow wood c:= 200)
	(chat-local-to-self "Emphasis research Elite Skirmisher")
)

(defrule
	(current-age == castle-age)
	(not (up-research-status c: imperial-age c:>= research-pending))
	(or	
		(unit-type-count-total skirmisher-line == 0)
		(up-research-status c: ri-elite-skirmisher c:>= research-pending)
	)
	(unit-type-count town-center >= 3)
	(and (escrow-amount wood > 0)(dropsite-min-distance wood <= 4))
=>
	(release-escrow wood)
	(chat-local-to-self "Undo emphasis research Elite Skirmisher")
)	

