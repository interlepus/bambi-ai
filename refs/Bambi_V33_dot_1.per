;region Hello=================================
(defrule
	(game-time > 25)
=>
	(chat-to-all "Bambi DE Version 33 dot 2 -- GL HF!!!")
	(disable-self)
)

(defconst written-by "Written by interlepus@yahoo.com - May 15th 2026")

#load-if-not-defined POPULATION-CAP-200
(defrule
	(true)
=>
