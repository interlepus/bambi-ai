(defrule
	(not (players-current-age any-enemy >= castle-age))
	(current-age == feudal-age)
	(town-under-attack)
	(not (up-research-status c: castle-age c:>= research-pending))
	(not (up-attacker-class == gaia))
	;(or
		(strategic-number sn-maximum-town-size < 40)
		;(goal gl-help-allies yes)
	;)
=>
	(release-escrow food)
	(release-escrow gold)
	(release-escrow wood)
)

(defrule
	(not (players-current-age any-enemy >= imperial-age))
	(current-age == castle-age)
	(town-under-attack)
	(not (up-research-status c: imperial-age c:>= research-pending))
	(not (up-attacker-class == gaia))
	;(or
		(strategic-number sn-maximum-town-size < 45)
		;(goal gl-help-allies yes)
	;)
=>
	(release-escrow food)
	(release-escrow gold)
	(release-escrow wood)
)

(defrule
	(goal gl-superiority no)
	(current-age <= castle-age)
	(game-time < 4000)
	(population g:< gl-game-time)
	(town-under-attack)
	(not (up-attacker-class == gaia))
=>
	(release-escrow food)
	(release-escrow gold)
	(release-escrow wood)
)	

(defrule
	(town-under-attack)
	(current-age == imperial-age)
	(building-type-count-total castle == 0)
	(not (up-attacker-class == gaia))
	;(strategic-number sn-maximum-town-size < 100)
=>
	(release-escrow food)
	(release-escrow gold)
	(release-escrow wood)
)

(defrule
    (current-age == imperial-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 45)
    (set-strategic-number sn-wood-gatherer-percentage 35)
    (set-strategic-number sn-gold-gatherer-percentage 15)
    (set-strategic-number sn-stone-gatherer-percentage 5)
	(up-modify-goal gl-food-modifier-percentage c:= 0)
	(up-modify-goal gl-wood-modifier-percentage c:= 0)
	(up-modify-goal gl-stone-modifier-percentage c:= 0)
	(up-modify-goal gl-gold-modifier-percentage c:= 0)
    (disable-self)
)

(defrule
	(true)
=>
	(up-modify-goal gl-food-original s:= sn-food-gatherer-percentage)
	(up-modify-goal gl-wood-original s:= sn-wood-gatherer-percentage)
	(up-modify-goal gl-stone-original s:= sn-stone-gatherer-percentage)
	(up-modify-goal gl-gold-original s:= sn-gold-gatherer-percentage)
)

(defrule
	(true)
=>
	(up-modify-sn sn-food-gatherer-percentage g:+ gl-food-modifier-percentage)
	(up-modify-sn sn-wood-gatherer-percentage g:+ gl-wood-modifier-percentage)
	(up-modify-sn sn-stone-gatherer-percentage g:+ gl-stone-modifier-percentage)
	(up-modify-sn sn-gold-gatherer-percentage g:+ gl-gold-modifier-percentage)
)

(defrule
	(true)
=>
	(enable-timer timer-sitrep 100)
	(disable-self)
)

(defrule
	(timer-triggered timer-sitrep)
=>
	(disable-timer timer-sitrep)
	(up-chat-data-to-self "sn-food %d" s: sn-food-gatherer-percentage)
	(up-chat-data-to-self "sn-wood %d" s: sn-wood-gatherer-percentage)
	(up-chat-data-to-self "sn-stone %d" s: sn-stone-gatherer-percentage)
	(up-chat-data-to-self "sn-gold %d" s: sn-gold-gatherer-percentage)
	(enable-timer timer-sitrep 200)
)


;endregion

;region Imperial Age Priority=====================================
(defrule
	(true)
=>
	(set-goal gl-imperial-priority no)
	(disable-self)
)

(defrule
	(or (players-building-type-count any-enemy castle >= 2) (players-current-age any-enemy >= imperial-age))
	(not (up-research-status c: imperial-age c:>= research-pending))
	(not (town-under-attack))
	(goal gl-imperial-priority no)
=>
	(set-goal gl-imperial-priority yes)
	(chat-local-to-self "Imperial Age prioritised")
)

(defrule
	(up-research-status c: imperial-age c:>= research-pending)
	(goal gl-imperial-priority yes)
=>
	(set-goal gl-imperial-priority no)
	(chat-local-to-self "Going imperial: let's release the hounds!")
)

(defrule
	(town-under-attack)
	(not (up-attacker-class == gaia))
	(goal gl-imperial-priority yes)
	;(or
		(strategic-number sn-maximum-town-size < 40)
		;(goal gl-help-allies yes)
	;)
=>
	(set-goal gl-imperial-priority no)
	(chat-local-to-self "Emergency: Imperial Age Priority postponed")
)
;endregion

;region HELP ALLIES=============================================
(defrule 
	(goal gl-nomad no)
	(goal gl-help-allies no)
	(players-population any-ally g:< gl-game-time)
	(not (population g:< gl-game-time))
	(or 
		(players-building-type-count every-enemy castle == 0) 
		(or 
			(unit-type-count battering-ram-line > 1)
			(unit-type-count trebuchet-set > 0)
		)
	)
	(military-population >= 12)
=>
	;(set-strategic-number sn-target-player-number -1)
	;(disable-timer timer-help-allies)
	(set-goal gl-help-allies yes)
	(chat-local-to-self "Detecting allies in need: helping now!")
	(chat-to-allies "Detected ally in need: starting attack sequence to help!")
	;(enable-timer timer-help-allies MAP_TILE_SIZE)
	;(attack-now)
)

(defrule 
	(goal gl-nomad no)
	(goal gl-help-allies no)
	(players-population any-ally g:< gl-game-time)
	(not (population g:< gl-game-time))
	(military-population >= 24)
=>
	;(set-strategic-number sn-target-player-number -1)
	;(disable-timer timer-help-allies)
	(set-goal gl-help-allies yes)
	(chat-local-to-self "Detecting allies in need: helping now!")
	(chat-to-allies "Detected ally in need: starting attack sequence to help!")
	;(enable-timer timer-help-allies MAP_TILE_SIZE)
	;(attack-now)
)

; (defrule 
	; (goal gl-nomad no)
	; (timer-triggered timer-help-allies)
	; (players-population any-ally g:< gl-game-time)
	; (not (population g:< gl-game-time))
; =>
	; (set-strategic-number sn-target-player-number -1)
	; (disable-timer timer-help-allies)
	; (set-goal gl-help-allies yes)
	; (chat-local-to-self "Sending reinforcements to allies!")
	; (chat-to-allies "Sending reinforcements to allies!")
	; (enable-timer timer-help-allies MAP_TILE_SIZE)
	; (attack-now)
; )

(defrule
	(goal gl-help-allies yes)
	(players-population every-ally g:> gl-game-time)
=>
	(set-goal gl-help-allies no)
	;(disable-timer timer-help-allies)
	(chat-local-to-self "Detecting allies are now ok: stop helping and reboom!")
	(chat-to-allies "All allies seem ok now! Rebooming")
)

(defrule
	(goal gl-help-allies yes)
	(players-building-type-count any-enemy castle > 0)
	(military-population < 24)
	(nor
		(unit-type-count battering-ram-line > 1)
		(unit-type-count trebuchet-set > 0)
	)
=>
	(set-goal gl-help-allies no)
	(chat-local-to-self "No siege for enemy castle")
	(chat-to-allies "No siege for enemy castle")
)

(defrule
	(goal gl-help-allies yes)
	(military-population < 12)
=>
	(set-goal gl-help-allies no)
	(chat-local-to-self "Need to rebuild army, then I will help counterattack again")
	(chat-to-allies "Need to rebuild army, then I will help counterattack again")
)

(defrule
	(goal gl-help-allies yes)
	(population g:< gl-game-time)
=>
	(set-goal gl-help-allies no)
	;(disable-timer timer-help-allies)
	(chat-local-to-self "Frightened!")
	(chat-to-allies "I'm heavily hit! Hang in there as i reboom to counterattack shortly!")
)

