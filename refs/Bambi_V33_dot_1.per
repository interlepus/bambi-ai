;====== THREATLEVEL DEFINED ================
(defrule
	(true)
=>
	(set-goal gl-activate-threatlevel no)
	(disable-self)
)

;=== NORMAL Threatlevel for NOT pocket NOT 3vs3 or 4vs4
(defrule
	(goal gl-activate-threatlevel yes)
	(nand
		(goal gl-pocket-position yes)
		(goal gl-number-allies 3)
	)
	(or
		(goal gl-feudal-defense no)
		(goal gl-imperial-priority yes)
	)
=>
	(set-goal gl-activate-threatlevel no)
	(chat-to-player my-player-number "Deactivate standard Threatlevel procedures")
)

(defrule
	(goal gl-activate-threatlevel no)
	(goal gl-feudal-defense yes)
	(goal gl-imperial-priority no)
	(nand 
		(goal gl-pocket-position yes)
		(goal gl-number-allies 3)
	)
=>
	(set-goal gl-activate-threatlevel yes)
	(chat-to-player my-player-number "Activate Threatlevel standard procedures")
)

;=== SPECIAL Threatlevel for POCKET of a 3vs3 or 4vs4
(defrule
	(goal gl-activate-threatlevel yes)
	(goal gl-pocket-position yes)
	(goal gl-number-allies 3)
	(nand
		(and 
			(town-under-attack)
			(not (up-attacker-class == gaia))
		)
		(strategic-number sn-maximum-town-size < 35)
		
	)
=>
	(set-goal gl-activate-threatlevel no)
	(chat-to-player my-player-number "Deactivate emergency Threatlevel procedures")
)

(defrule
	(goal gl-activate-threatlevel no)
	(goal gl-pocket-position yes)
	(goal gl-number-allies 3)
	(town-under-attack)
	(not (up-attacker-class == gaia))
	(strategic-number sn-maximum-town-size < 35)
=>
	(set-goal gl-activate-threatlevel yes)
	(chat-to-player my-player-number "Activate Threatlevel emergency procedures")
)	
