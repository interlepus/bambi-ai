;==================================================================================
; THE MASTER - v2.0
; Age of Empires II: Definitive Edition AI.  Focus civ: FRANKS ("base civ").
; Plan: Scouts/FC -> Knights, Throwing Axemen vs spears/camels, Skirms vs archers.
; Scope: 1v1, Arabia, vs random-civ DE AI (Hardest).   Author: interlepus@yahoo.com
;
; v2.0 — major upgrade after studying Sol (ChatGPT's competing AI), Rehoboam & co:
;  * FIXED-HOME THREAT SCAN (idea from Sol): DUC-counts enemy units around our ORIGINAL
;    home point. town-under-attack goes unreliable once the town radius grows — fighting
;    at the enemy base looked like a home raid, pausing attacks and pulling militia.
;    All offensive pause / militia / boom gates now use the home-threat signal.
;  * KNIGHT TARGET DISCIPLINE (idea from Sol): offense priorities on unit types — kill
;    mangonels/monks/rams/spears/villagers first; towers ignored until the army is big.
;  * TSA push uses a DEFENSE-priority table (eco buildings high, towers/castle = never).
;  * Boar lure fail-safe timers (lurer death no longer locks food gathering forever).
;  * TSA-lite gated to Castle Age (9 scouts could explode the town radius in Feudal).
;  * Dynamic market (sell surplus food/wood when gold-starved), enemy-knight counter
;    (pikes+monks), early monastery vs cavalry, age-scaled camp distances, imperial
;    unlimited drop distances, wheelbarrow imperial fallback, age timestamps in debug.
;  NO ESCROW by design (v0.8 lesson) — Sol's Castle escrow bug (blocked villagers,
;  idle TCs) is exactly the trap this architecture eliminates.
;
; v1.0 — architecture + the v0.9 review:
;  * AGE-UP now sits ABOVE villager production: rule-order gives it the TC first, so
;    villagers keep producing behind it and the age-up isn't blocked (no goal needed).
;  * Opening keeps >=6 on food (no TC idle); Feudal gold = max ~2 vils, rest to wood.
;  * Castle keeps >=12 on wood; flexible eco now also fixes wood SHORTAGE and stone PILE.
;  * 2 lumber camps in Feudal, 3 in Castle, +1 whenever wood drifts >3 from a dropsite;
;    TCs placed by the lumber camps.
;  * Blacksmith/unit upgrades ONLY once we own that unit; pikemen only vs cavalry;
;    skirms vs archers; Throwing Axemen vs spears/camels (Franks weakness = camels).
;  * gl-enemy-ranged triggers on REAL enemy archers (not on a wolf attack); Fletching
;    first when attacked; stone mining camp + market deferred to Castle (used, not wasted).
;  * Monastery + monks for relic gold once we have 3 TCs; 2nd Castle when stone piles.
;  Franks notes (from research): top-tier Knights (+2 LOS, no Bloodlines cost), cheap
;  forward castle, free farms, weak archers -> SKIRMS for defence; camels hard-counter us.
;
; NOTE TO SELF: AoE2 and/or/nand are BINARY (exactly 2 args) — nest, never list 3+.
; >>> DEBUG: flip gl-debug to "off" at the rule marked [DEBUG TOGGLE] to silence.
;==================================================================================

;region IDENTITY & GREETING ========================================================
(defrule (true) => (up-change-name "Meistar") (disable-self))
(defrule (game-time > 4) => (chat-to-all "The Master v2.0 -- Meistar. GL HF!") (disable-self))
;endregion

;region CONSTANTS ==================================================================
(defconst on 1)
(defconst off 0)
(defconst research-pending 2)
(defconst research-complete 3)

(defconst gl-debug 1)
(defconst gl-my-army 3)
(defconst gl-enemy-anti-cav 4)     ; enemy fields mass spears/pikes/camels
(defconst gl-enemy-ranged 5)       ; enemy fields mass archers/skirmishers
(defconst gl-attack 6)
(defconst gl-town-size-step 7)
(defconst gl-plan 8)               ; 0 undecided, 1 = scout rush, 2 = fast castle
(defconst gl-boar-state 10)        ; 0 idle, 1 luring with 1, 2 swarming with 6
(defconst gl-scrush 11)            ; 0 idle, 1 armed, 2 raiding, 3 done/off
(defconst gl-home-x 15)            ; original home point (x,y = 15,16 consecutive)
(defconst gl-home-y 16)
(defconst gl-tmp 17)               ; scratch (age timestamps etc.)
(defconst gl-target-player 18)     ; the 1v1 enemy player number
(defconst gl-home-threat 19)       ; enemy units near ORIGINAL home (fixed-home scan)
(defconst gl-search-base 20)       ; up-get-search-state writes 20..23 — keep reserved
(defconst gl-enemy-cavalry 24)     ; enemy fields massed knights

(defconst priority-offense 0)      ; for up-reset-target-priorities
(defconst all-units-class -1)      ; any-unit class for DUC searches
(defconst enemy 3)                 ; player stance group for up-find-player
(defconst find-closest 2)          ; up-find-player mode
(defconst gl-search-remote-count 22) ; 3rd of the 4 consecutive search-state goals

(defconst timer-debug 1)
(defconst timer-attack 2)
(defconst timer-homescan 3)
(defconst timer-boar 4)
;endregion

;region INIT / STATE ===============================================================
(defrule                            ; [DEBUG TOGGLE]
	(true)
=>
	(set-goal gl-debug on)
	(set-goal gl-attack off)
	(set-goal gl-enemy-anti-cav off)
	(set-goal gl-enemy-ranged off)
	(set-goal gl-town-size-step 0)
	(set-goal gl-plan 0)
	(set-goal gl-boar-state 0)
	(set-goal gl-scrush 0)
	(set-goal gl-home-threat 0)
	(set-goal gl-enemy-cavalry off)
	(disable-self)
)
(defrule (true) => (enable-timer timer-debug 20) (disable-self))

; TSA/defence target table (Sol's insight: the town-radius push clears buildings via the
; DEFENSE priority table). Prefer exposed eco/production; never dive towers or castles.
(defrule
	(true)
=>
	(up-set-defense-priority c: mining-camp c: 20000)
	(up-set-defense-priority c: lumber-camp c: 18000)
	(up-set-defense-priority c: mill c: 16000)
	(up-set-defense-priority c: archery-range c: 14000)
	(up-set-defense-priority c: stable c: 12000)
	(up-set-defense-priority c: barracks c: 10000)
	(up-set-defense-priority c: town-center c: 4000)
	(up-set-defense-priority c: watch-tower c: -1)
	(up-set-defense-priority c: castle c: -1)
	(disable-self)
)

; Record the ORIGINAL home point + find our 1v1 opponent, then start the home scan.
(defrule
	(game-time > 5)
=>
	(up-get-point position-self gl-home-x)
	(up-find-player enemy find-closest gl-target-player)
	(enable-timer timer-homescan 4)
	(disable-self)
)
;endregion

;region FIXED-HOME THREAT SCAN (from Sol) =========================================
; Count enemy units within 36 tiles of the ORIGINAL home point. This stays accurate
; when the town radius has grown toward the enemy — fighting at THEIR base can no
; longer masquerade as a raid on ours.
(defrule
	(timer-triggered timer-homescan)
	(up-compare-goal gl-target-player > 0)
=>
	(disable-timer timer-homescan)
	(up-modify-sn sn-focus-player-number g:= gl-target-player)
	(up-full-reset-search)
	(up-set-target-point gl-home-x)
	(up-filter-distance c: -1 c: 36)
	(up-find-remote c: all-units-class c: 40)
	(up-get-search-state gl-search-base)
	(up-modify-goal gl-home-threat c:= 0)
	(up-modify-goal gl-home-threat g:+ gl-search-remote-count)
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(enable-timer timer-homescan 4)
)
;endregion

;region INITIAL STRATEGIC NUMBERS ==================================================
(defrule
	(true)
=>
	(set-strategic-number sn-initial-exploration-required 0)
	(set-strategic-number sn-number-explore-groups 1)
	(set-strategic-number sn-total-number-explorers 1)
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-home-exploration-time 300)

	(set-strategic-number sn-intelligent-gathering 1)
	(set-strategic-number sn-livestock-to-town-center 1)
	(set-strategic-number sn-enable-boar-hunting 0)
	(set-strategic-number sn-minimum-number-hunters 0)
	(set-strategic-number sn-minimum-boar-lure-group-size 1000)
	(set-strategic-number sn-maximum-hunt-drop-distance 28)
	(set-strategic-number sn-maximum-food-drop-distance 24)
	(set-strategic-number sn-maximum-gold-drop-distance 30)
	(set-strategic-number sn-maximum-stone-drop-distance 30)
	(set-strategic-number sn-camp-max-distance 16)
	(set-strategic-number sn-mill-max-distance 22)
	(set-strategic-number sn-allow-adjacent-dropsites 1)
	(set-strategic-number sn-town-center-placement lumber-camp)   ; TCs near woods

	(set-strategic-number sn-cap-civilian-builders 5)
	(set-strategic-number sn-percent-building-cancellation 0)
	(set-strategic-number sn-object-repair-level 2)
	(disable-self)
)
(defrule
	(true)
=>
	(set-strategic-number sn-enable-patrol-attack 1)
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-minimum-attack-group-size 1)
	(set-strategic-number sn-maximum-attack-group-size 1)
	(set-strategic-number sn-attack-group-size-randomness 0)
	(set-strategic-number sn-number-attack-groups 0)
	(set-strategic-number sn-consecutive-idle-unit-limit 1)
	(set-strategic-number sn-enable-offensive-priority 1)
	(set-strategic-number sn-maximum-town-size 18)
	(set-strategic-number sn-enemy-sighted-response-distance 30)
	(set-strategic-number sn-wall-targeting-mode 1)
	(set-strategic-number sn-allow-civilian-defense 1)
	(set-strategic-number sn-number-civilian-militia 0)
	(disable-self)
)
;endregion

;region AGE-UP (ABOVE villager production -> rule-order gives it the TC first) ======
(defrule
	(or (civilian-population >= 21) (players-current-age any-enemy >= feudal-age))
	(can-research feudal-age)
=>
	(research feudal-age)
	(chat-to-player my-player-number "[MASTER] Clicking FEUDAL")
)
(defrule
	(can-research castle-age)
=>
	(research castle-age)
	(chat-to-player my-player-number "[MASTER] Clicking CASTLE")
)
(defrule
	(can-research imperial-age)
	(military-population >= 12)
	(civilian-population >= 45)
=>
	(research imperial-age)
	(chat-to-player my-player-number "[MASTER] Clicking IMPERIAL")
)
;endregion

;region ANTI-IDLE: KEEP THE TC FED ================================================
(defrule
	(current-age <= feudal-age)
	(food-amount < 50)
=>
	(up-drop-resources food c: 5)
)
;endregion

;region BOAR LURE (1 lurer -> boar walks to TC -> 6 hunters) =======================
(defrule
	(current-age == dark-age)
	(civilian-population >= 14)
	(goal gl-boar-state 0)
	(dropsite-min-distance live-boar > -1)
	(dropsite-min-distance live-boar s:<= sn-maximum-hunt-drop-distance)
=>
	(set-strategic-number sn-enable-boar-hunting 2)
	(set-strategic-number sn-minimum-number-hunters 1)
	(set-strategic-number sn-minimum-boar-lure-group-size 1)
	(set-goal gl-boar-state 1)
	(enable-timer timer-boar 90)
	(chat-to-player my-player-number "[MASTER] Luring boar with 1 villager")
)
(defrule
	(goal gl-boar-state 1)
	(dropsite-min-distance live-boar > -1)
	(dropsite-min-distance live-boar <= 13)
=>
	(disable-timer timer-boar)
	(set-strategic-number sn-minimum-number-hunters 6)
	(set-strategic-number sn-minimum-boar-hunt-group-size 6)
	(set-goal gl-boar-state 2)
	(enable-timer timer-boar 60)
	(chat-to-player my-player-number "[MASTER] Boar at the TC -> 6 hunters")
)
(defrule
	(goal gl-boar-state 2)
	(or (up-remaining-boar-amount < 180) (dropsite-min-distance live-boar == -1))
=>
	(set-strategic-number sn-enable-boar-hunting 1)
	(set-strategic-number sn-minimum-number-hunters 0)
	(set-strategic-number sn-minimum-boar-hunt-group-size 0)
	(set-strategic-number sn-minimum-boar-lure-group-size 1000)
	(set-goal gl-boar-state 0)
	(disable-timer timer-boar)
)

; FAIL-SAFES (from Sol): if the lure or the kill stalls (lurer died, boar stolen),
; unwind so "nothing-but-boar-hunting" mode can't lock food gathering forever.
(defrule
	(goal gl-boar-state 1)
	(timer-triggered timer-boar)
=>
	(set-strategic-number sn-enable-boar-hunting 1)
	(set-strategic-number sn-minimum-number-hunters 0)
	(set-strategic-number sn-minimum-boar-lure-group-size 1000)
	(set-goal gl-boar-state 0)
	(disable-timer timer-boar)
	(chat-to-player my-player-number "[MASTER] Boar lure timed out -> reset")
)
(defrule
	(goal gl-boar-state 2)
	(timer-triggered timer-boar)
=>
	(set-strategic-number sn-enable-boar-hunting 1)
	(set-strategic-number sn-minimum-number-hunters 0)
	(set-strategic-number sn-minimum-boar-hunt-group-size 0)
	(set-strategic-number sn-minimum-boar-lure-group-size 1000)
	(set-goal gl-boar-state 0)
	(disable-timer timer-boar)
)
;endregion

;region ECONOMY: VILLAGER PRODUCTION (age-up above already has TC priority) =========
(defrule
	(can-train villager)
	(civilian-population < 95)
	(population-headroom > 0)
	(housing-headroom > 0)
=>
	(train villager)
)
;endregion

;region ECONOMY: GATHER DISTRIBUTION (Dark Age keeps >=6 on food) ==================
(defrule
	(current-age == dark-age)
	(not (up-research-status c: feudal-age c:>= research-pending))
	(civilian-population <= 6)
=>
	(set-strategic-number sn-food-gatherer-percentage 100)
	(set-strategic-number sn-wood-gatherer-percentage 0)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)
(defrule
	(current-age == dark-age)
	(not (up-research-status c: feudal-age c:>= research-pending))
	(civilian-population >= 7)
	(civilian-population <= 8)
=>
	(set-strategic-number sn-food-gatherer-percentage 85)   ; ~6 food + 1-2 wood
	(set-strategic-number sn-wood-gatherer-percentage 15)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)
(defrule
	(current-age == dark-age)
	(not (up-research-status c: feudal-age c:>= research-pending))
	(civilian-population >= 9)
	(civilian-population <= 11)
=>
	(set-strategic-number sn-food-gatherer-percentage 67)   ; ~6-7 food + 3-4 wood
	(set-strategic-number sn-wood-gatherer-percentage 33)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)
(defrule
	(current-age == dark-age)
	(not (up-research-status c: feudal-age c:>= research-pending))
	(civilian-population >= 12)
=>
	(set-strategic-number sn-food-gatherer-percentage 60)   ; caps wood ~8 by 20 pop
	(set-strategic-number sn-wood-gatherer-percentage 40)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)
(defrule
	(current-age == dark-age)
	(not (up-research-status c: feudal-age c:>= research-pending))
	(civilian-population >= 22)
	(food-amount < 500)
=>
	(set-strategic-number sn-food-gatherer-percentage 78)
	(set-strategic-number sn-wood-gatherer-percentage 22)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

; FEUDAL - SCOUT RUSH: wood-heavy for buildings/LCs/scouts, ~2 vils gold only.
(defrule
	(current-age == feudal-age)
	(goal gl-plan 1)
	(not (up-research-status c: castle-age c:>= research-pending))
=>
	(set-strategic-number sn-food-gatherer-percentage 52)
	(set-strategic-number sn-wood-gatherer-percentage 43)
	(set-strategic-number sn-gold-gatherer-percentage 5)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)
; FEUDAL - FAST CASTLE: food to bank the 800, ~2 vils gold, rest wood (we were short).
(defrule
	(current-age == feudal-age)
	(goal gl-plan 2)
	(not (up-research-status c: castle-age c:>= research-pending))
=>
	(set-strategic-number sn-food-gatherer-percentage 56)
	(set-strategic-number sn-wood-gatherer-percentage 38)
	(set-strategic-number sn-gold-gatherer-percentage 6)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

; Castle Age: KNIGHT eco — keep >=12 on wood (TCs/LCs/farms), good gold, light stone.
(defrule
	(current-age == castle-age)
=>
	(set-strategic-number sn-food-gatherer-percentage 42)
	(set-strategic-number sn-wood-gatherer-percentage 30)
	(set-strategic-number sn-gold-gatherer-percentage 23)
	(set-strategic-number sn-stone-gatherer-percentage 5)
)

(defrule
	(current-age == imperial-age)
	(gold-amount < 700)
=>
	(set-strategic-number sn-food-gatherer-percentage 40)
	(set-strategic-number sn-wood-gatherer-percentage 25)
	(set-strategic-number sn-gold-gatherer-percentage 30)
	(set-strategic-number sn-stone-gatherer-percentage 5)
)
(defrule
	(current-age == imperial-age)
	(gold-amount >= 700)
=>
	(set-strategic-number sn-food-gatherer-percentage 45)
	(set-strategic-number sn-wood-gatherer-percentage 33)
	(set-strategic-number sn-gold-gatherer-percentage 17)
	(set-strategic-number sn-stone-gatherer-percentage 5)
)
;endregion

;region FLEXIBLE ECO (rebalance whichever way it's unbalanced) =====================
(defrule (wood-amount > 800)(strategic-number sn-wood-gatherer-percentage > 22)
=> (up-modify-sn sn-wood-gatherer-percentage c:- 12)(up-modify-sn sn-food-gatherer-percentage c:+ 8)(up-modify-sn sn-gold-gatherer-percentage c:+ 4))
; Wood SHORTAGE (Castle+) -> pull off gold onto wood.
(defrule (current-age >= castle-age)(wood-amount < 150)(strategic-number sn-gold-gatherer-percentage > 10)
=> (up-modify-sn sn-wood-gatherer-percentage c:+ 8)(up-modify-sn sn-gold-gatherer-percentage c:- 8))
(defrule (gold-amount > 900)(strategic-number sn-gold-gatherer-percentage > 6)
=> (up-modify-sn sn-gold-gatherer-percentage c:- 6)(up-modify-sn sn-food-gatherer-percentage c:+ 4)(up-modify-sn sn-wood-gatherer-percentage c:+ 2))
(defrule (current-age >= castle-age)(food-amount > 1300)(strategic-number sn-food-gatherer-percentage > 25)
=> (up-modify-sn sn-food-gatherer-percentage c:- 10)(up-modify-sn sn-gold-gatherer-percentage c:+ 10))
; Stone PILE -> stop over-mining stone, put it on wood.
(defrule (stone-amount > 600)(strategic-number sn-stone-gatherer-percentage > 2)
=> (up-modify-sn sn-stone-gatherer-percentage c:- 4)(up-modify-sn sn-wood-gatherer-percentage c:+ 4))

; Camps may reach farther as the map opens up (crowded/exhausted deposits -> new mines).
(defrule (current-age == castle-age)(strategic-number sn-camp-max-distance < 22)
=> (set-strategic-number sn-camp-max-distance 22))
(defrule (current-age == imperial-age)(strategic-number sn-camp-max-distance < 28)
=> (set-strategic-number sn-camp-max-distance 28))
; Imperial: no drop-distance caps — gather wherever resources remain (Sol's idea).
(defrule
	(current-age == imperial-age)
=>
	(set-strategic-number sn-maximum-food-drop-distance -1)
	(set-strategic-number sn-maximum-wood-drop-distance -1)
	(set-strategic-number sn-maximum-gold-drop-distance -1)
	(set-strategic-number sn-maximum-stone-drop-distance -1)
	(disable-self)
)
;endregion

;region ECONOMY: FARMS (Franks get farm upgrades free) ============================
(defrule
	(current-age == dark-age)
	(civilian-population >= 16)
	(building-type-count-total mill > 0)
	(idle-farm-count < 1)
	(can-build farm)
	(up-pending-objects c: farm < 2)
	(wood-amount > 80)
=> (build farm))
(defrule
	(current-age >= feudal-age)
	(or (building-type-count-total stable > 0) (wood-amount > 180))
	(idle-farm-count < 1)
	(can-build farm)
	(up-pending-objects c: farm < 2)
	(wood-amount > 100)
=> (build farm))
;endregion

;region BUILDINGS: HOUSES & LUMBER CAMPS ==========================================
(defrule
	(building-type-count town-center > 0)
	(building-type-count-total house == 0)
	(can-build house)
	(up-pending-objects c: house == 0)
=> (up-assign-builders c: house c: 2)(build house))
(defrule (building-type-count-total house > 0) => (up-assign-builders c: house c: 1)(disable-self))
; 2nd house immediately after the 1st (2 houses at the start = housed through Dark Age).
(defrule
	(current-age == dark-age)
	(building-type-count-total house == 1)
	(can-build house)
	(up-pending-objects c: house < 2)
=> (build house))
(defrule (current-age <= feudal-age)(housing-headroom < 6)(population-headroom > 0)(up-pending-objects c: house < 2)(can-build house) => (build house))
(defrule (current-age == castle-age)(housing-headroom < 12)(population-headroom > 0)(up-pending-objects c: house < 3)(can-build house) => (build house))
(defrule (current-age == imperial-age)(housing-headroom < 18)(population-headroom > 0)(up-pending-objects c: house < 5)(can-build house) => (build house))

; Lumber camps: 1 by ~8 vils, 2 in Feudal, 3 in Castle, +1 whenever wood drifts >3.
(defrule (building-type-count-total lumber-camp < 1)(civilian-population >= 8)(can-build lumber-camp)(up-pending-objects c: lumber-camp < 1) => (build lumber-camp))
(defrule (current-age >= feudal-age)(building-type-count-total lumber-camp < 2)(can-build lumber-camp)(up-pending-objects c: lumber-camp < 1)(wood-amount > 100) => (build lumber-camp))
(defrule (current-age >= castle-age)(building-type-count-total lumber-camp < 3)(can-build lumber-camp)(up-pending-objects c: lumber-camp < 1)(wood-amount > 100) => (build lumber-camp))
(defrule (building-type-count-total lumber-camp >= 1)(dropsite-min-distance wood > 3)(up-pending-objects c: lumber-camp < 1)(can-build lumber-camp) => (build lumber-camp))

(defrule
	(building-type-count-total mill == 0)
	(building-type-count-total lumber-camp > 0)
	(civilian-population >= 9)
	(can-build mill)
	(up-pending-objects c: mill < 1)
=> (build mill))

(defrule
	(or (up-research-status c: feudal-age c:>= research-pending) (current-age >= feudal-age))
	(dropsite-min-distance gold > 5)
	(resource-found gold)
	(up-pending-objects c: mining-camp < 1)
	(can-build mining-camp)
=> (build mining-camp))

; Stone mining camp only IN Castle Age (where we actually mine stone).
(defrule
	(current-age >= castle-age)
	(dropsite-min-distance stone > 5)
	(resource-found stone)
	(up-pending-objects c: mining-camp < 1)
	(can-build mining-camp)
=> (build mining-camp))
;endregion

;region BUILDINGS: MILITARY & TECH ================================================
(defrule
	(or (up-research-status c: feudal-age c:>= research-pending) (current-age >= feudal-age))
	(building-type-count-total barracks < 1)
	(can-build barracks)
	(up-pending-objects c: barracks < 1)
=> (build barracks))

(defrule (current-age >= feudal-age)(building-type-count-total stable < 1)(can-build stable)(up-pending-objects c: stable < 1) => (build stable))
(defrule (current-age >= castle-age)(building-type-count-total stable < 3)(can-build stable)(up-pending-objects c: stable < 1)(wood-amount > 175) => (build stable))

(defrule (current-age >= feudal-age)(building-type-count-total stable > 0)(building-type-count-total blacksmith < 1)(can-build blacksmith)(up-pending-objects c: blacksmith < 1) => (build blacksmith))

; Archery Range when the enemy actually fields archers/skirms (skirm defence).
(defrule
	(goal gl-enemy-ranged on)
	(current-age >= feudal-age)
	(building-type-count-total archery-range < 1)
	(can-build archery-range)
	(up-pending-objects c: archery-range < 1)
=> (build archery-range))
; 2nd Archery Range vs heavy ranged (need skirm volume).
(defrule
	(goal gl-enemy-ranged on)
	(current-age >= castle-age)
	(players-unit-type-count any-enemy archer-line >= 12)
	(building-type-count-total archery-range < 2)
	(can-build archery-range)
	(up-pending-objects c: archery-range < 1)
=> (build archery-range))

; Market deferred to Castle (used for buy-stone) — no wasted Feudal wood.
(defrule (current-age >= castle-age)(building-type-count-total market < 1)(can-build market)(up-pending-objects c: market < 1)(wood-amount > 175) => (build market))
(defrule (current-age >= castle-age)(building-type-count-total university < 1)(can-build university)(up-pending-objects c: university < 1)(wood-amount > 200) => (build university))
(defrule (current-age >= castle-age)(building-type-count-total siege-workshop < 1)(can-build siege-workshop)(up-pending-objects c: siege-workshop < 1)(military-population > 8) => (build siege-workshop))

(defrule (current-age >= castle-age)(building-type-count-total castle < 1)(can-build castle)(up-pending-objects c: castle < 1) => (build castle))
; 2nd Castle when stone piles (forward/defensive) instead of hoarding stone.
(defrule (current-age >= castle-age)(building-type-count-total castle < 2)(stone-amount > 650)(can-build castle)(up-pending-objects c: castle < 1) => (build castle))
;endregion

;region BUILDINGS: TOWN CENTERS + MONASTERY (relics) ==============================
(defrule
	(current-age >= castle-age)
	(building-type-count-total town-center < 3)
	(can-build town-center)
	(up-pending-objects c: town-center < 1)
	(civilian-population > 28)
	(up-compare-goal gl-home-threat < 6)
=> (up-assign-builders c: town-center c: 3)(build town-center))

; Monastery: for relic gold at 3 TCs, EARLY vs enemy knights (conversions), or as the
; 2nd Castle-Age building when the bank is Imperial-ready (imp needs 2 of them!).
(defrule
	(current-age >= castle-age)
	(or
		(building-type-count-total town-center >= 3)
		(or (goal gl-enemy-cavalry on) (and (food-amount > 900) (gold-amount > 700)))
	)
	(building-type-count-total monastery < 1)
	(can-build monastery)
	(up-pending-objects c: monastery < 1)
=> (build monastery))
(defrule
	(building-type-count monastery > 0)
	(can-train monk)
	(unit-type-count-total monks < 3)
=> (train monk))
; Extra monks vs massed enemy knights (conversion defence).
(defrule
	(goal gl-enemy-cavalry on)
	(building-type-count monastery > 0)
	(can-train monk)
	(unit-type-count-total monks < 5)
=> (train monk))
; Pikemen vs enemy knight mass (anti-cavalry — their one good matchup).
(defrule
	(goal gl-enemy-cavalry on)
	(current-age >= castle-age)
	(can-train spearman-line)
	(unit-type-count-total spearman-line < 8)
=> (train spearman-line))
;endregion

;region FEUDAL FORK: SCOUT RUSH vs FAST CASTLE ====================================
(defrule
	(current-age == feudal-age)(goal gl-plan 0)
	(not (players-current-age any-enemy >= feudal-age))
=> (set-goal gl-plan 1)(chat-to-player my-player-number "[MASTER] Plan: SCOUT RUSH (we hit Feudal first)"))
(defrule
	(current-age == feudal-age)(goal gl-plan 0)
	(players-current-age any-enemy >= feudal-age)
=> (set-goal gl-plan 2)(chat-to-player my-player-number "[MASTER] Plan: FAST CASTLE (enemy reached Feudal first)"))
;endregion

;region SCOUT RUSH EXECUTION (the rush actually rushes) ===========================
; Arm: raid the enemy ECONOMY — houses/mills/camps first, ignore towers (don't suicide
; into TC/tower fire). Same priority pattern Bambi and Rehoboam use.
(defrule
	(goal gl-plan 1)
	(goal gl-scrush 0)
	(current-age == feudal-age)
=>
	(up-reset-target-priorities priority-offense 1)
	(up-set-offense-priority c: house c: 5)
	(up-set-offense-priority c: archery-range c: 6)
	(up-set-offense-priority c: stable c: 7)
	(up-set-offense-priority c: barracks c: 8)
	(up-set-offense-priority c: mill c: 9)
	(up-set-offense-priority c: mining-camp c: 10)
	(up-set-offense-priority c: lumber-camp c: 11)
	(set-strategic-number sn-disable-tower-priority 1)
	(set-goal gl-scrush 1)
)

; Launch the first wave at 5 scouts while the window is open (enemy Feudal, no spear mass).
(defrule
	(goal gl-scrush 1)
	(unit-type-count scout-cavalry-line >= 5)
	(players-unit-type-count any-enemy spearman-line < 2)
	(not (players-current-age any-enemy >= castle-age))
	(not (town-under-attack))
=>
	(set-strategic-number sn-number-attack-groups 100)
	(attack-now)
	(disable-timer timer-attack)
	(enable-timer timer-attack 40)
	(set-goal gl-scrush 2)
	(chat-to-player my-player-number "[MASTER] SCOUT RUSH: raiding enemy eco")
)

; Keep the waves flowing while raiding.
(defrule
	(goal gl-scrush 2)
	(timer-triggered timer-attack)
	(military-population >= 4)
	(not (town-under-attack))
=>
	(attack-now)
	(disable-timer timer-attack)
	(enable-timer timer-attack 40)
)

; Reinforce a working rush up to ~9 scouts.
(defrule
	(goal gl-scrush 2)
	(current-age == feudal-age)
	(food-amount > 150)
	(players-unit-type-count any-enemy spearman-line < 2)
	(can-train scout-cavalry-line)
	(unit-type-count-total scout-cavalry-line < 9)
=> (train scout-cavalry-line))

; Call it off when countered (spear mass) or the game moves on (either side Castle).
(defrule
	(or (goal gl-scrush 1) (goal gl-scrush 2))
	(or
		(players-unit-type-count any-enemy spearman-line >= 3)
		(or (players-current-age any-enemy >= castle-age) (current-age >= castle-age))
	)
=>
	(up-reset-target-priorities priority-offense 0)
	(set-strategic-number sn-disable-tower-priority 0)
	(set-strategic-number sn-number-attack-groups 0)
	(disable-timer timer-attack)
	(set-goal gl-scrush 3)
	(chat-to-player my-player-number "[MASTER] Scout rush off -> transitioning to Knights")
)
;endregion

;region RESEARCH: ECONOMY ==========================================================
(defrule
	(or (food-amount < 45) (or (civilian-population >= 20) (or (town-under-attack) (up-enemy-units-in-town > 0))))
	(can-research ri-loom)
=> (research ri-loom)(chat-to-player my-player-number "[MASTER] Loom"))

(defrule (can-research ri-double-bit-axe) => (research ri-double-bit-axe))
(defrule (can-research ri-horse-collar)   => (research ri-horse-collar))
(defrule (can-research ri-bow-saw)        => (research ri-bow-saw))
(defrule (can-research ri-heavy-plow)     => (research ri-heavy-plow))

; Wheelbarrow at end-Feudal/Castle, skip if enemy already in Castle.
(defrule
	(or (current-age >= castle-age) (up-research-status c: castle-age c:>= research-pending))
	(not (players-current-age any-enemy >= castle-age))
	(can-research ri-wheel-barrow)
=> (research ri-wheel-barrow))
; ...but never skip it forever: by Imperial it's always worth it.
(defrule
	(current-age >= imperial-age)
	(can-research ri-wheel-barrow)
=> (research ri-wheel-barrow))
; Hand cart at 2+ TCs or 60+ vils.
(defrule (or (building-type-count-total town-center >= 2) (civilian-population > 60))(can-research ri-hand-cart) => (research ri-hand-cart))

(defrule (or (current-age >= castle-age) (up-research-status c: castle-age c:>= research-pending))(can-research ri-gold-mining) => (research ri-gold-mining))
(defrule (current-age >= castle-age)(can-research ri-gold-shaft-mining) => (research ri-gold-shaft-mining))
(defrule (current-age >= imperial-age)(can-research ri-two-man-saw)       => (research ri-two-man-saw))
(defrule (current-age >= imperial-age)(can-research ri-stone-mining)      => (research ri-stone-mining))
;endregion

;region RESEARCH: BLACKSMITH (ONLY once we own the relevant unit) ==================
; Melee attack/armour — gate on owning cavalry (scouts/knights) or throwing axemen.
(defrule (or (unit-type-count-total scout-cavalry-line > 0) (or (unit-type-count-total knight-line > 0) (unit-type-count-total throwing-axeman-line > 0))) (can-research ri-forging) => (research ri-forging))
(defrule (research-completed ri-forging)(can-research ri-iron-casting)  => (research ri-iron-casting))
(defrule (research-completed ri-iron-casting)(can-research ri-blast-furnace) => (research ri-blast-furnace))
(defrule (or (unit-type-count-total scout-cavalry-line > 0) (unit-type-count-total knight-line > 0)) (can-research ri-bloodlines) => (research ri-bloodlines))
(defrule (or (unit-type-count-total scout-cavalry-line > 0) (unit-type-count-total knight-line > 0)) (can-research ri-husbandry)  => (research ri-husbandry))
(defrule (or (unit-type-count-total scout-cavalry-line > 0) (unit-type-count-total knight-line > 0)) (can-research ri-scale-barding) => (research ri-scale-barding))
(defrule (research-completed ri-scale-barding)(can-research ri-chain-barding) => (research ri-chain-barding))
(defrule (research-completed ri-chain-barding)(can-research ri-plate-barding) => (research ri-plate-barding))
; Archer armour — ONLY if we own skirms/archers.
(defrule (or (unit-type-count-total skirmisher-line > 0) (unit-type-count-total archer-line > 0)) (can-research ri-padded-archer-armor) => (research ri-padded-archer-armor))
(defrule (or (unit-type-count-total skirmisher-line > 0) (unit-type-count-total archer-line > 0)) (can-research ri-leather-archer-armor) => (research ri-leather-archer-armor))
; Infantry techs — ONLY if we own axemen/spearmen.
(defrule (unit-type-count-total throwing-axeman-line > 0)(can-research ri-squires) => (research ri-squires))
(defrule (or (unit-type-count-total throwing-axeman-line > 0) (unit-type-count-total spearman-line > 0)) (can-research ri-scale-mail) => (research ri-scale-mail))
(defrule (research-completed ri-scale-mail)(can-research ri-chain-mail) => (research ri-chain-mail))
(defrule (research-completed ri-chain-mail)(can-research ri-plate-mail) => (research ri-plate-mail))
;endregion

;region RESEARCH: UNIT LINES (gate upgrades on owning the unit) ====================
(defrule (can-research ri-cavalier) => (research ri-cavalier))   ; needs a Stable anyway
(defrule (can-research ri-paladin)  => (research ri-paladin))
(defrule (can-research ri-chivalry) => (research ri-chivalry))
(defrule (unit-type-count-total throwing-axeman-line > 0)(can-research ri-elite-throwing-axeman) => (research ri-elite-throwing-axeman))
(defrule (unit-type-count-total skirmisher-line > 0)(can-research ri-elite-skirmisher) => (research ri-elite-skirmisher))
(defrule (unit-type-count-total spearman-line > 0)(can-research ri-pikeman) => (research ri-pikeman))
;endregion

;region RESEARCH: DEFENSIVE / UNIVERSITY ==========================================
; Fletching FIRST when attacked — boosts TC/tower (and any skirm/archer) arrows.
(defrule (town-under-attack)(can-research ri-fletching) => (research ri-fletching))
(defrule (or (unit-type-count-total skirmisher-line > 0) (unit-type-count-total archer-line > 0))(can-research ri-bodkin-arrow) => (research ri-bodkin-arrow))
(defrule (can-research ri-masonry)        => (research ri-masonry))
(defrule (can-research ri-murder-holes)   => (research ri-murder-holes))
(defrule (current-age >= imperial-age)(can-research ri-architecture) => (research ri-architecture))
;endregion

;region DEFENCE: detect threats (real units only) =================================
; Anti-cav threat = enemy mass spears OR camels (camels hard-counter Franks knights).
(defrule
	(or (players-unit-type-count any-enemy spearman-line >= 5) (players-unit-type-count any-enemy camel-line >= 4))
	(goal gl-enemy-anti-cav off)
=> (set-goal gl-enemy-anti-cav on))
(defrule
	(players-unit-type-count any-enemy spearman-line < 3)
	(players-unit-type-count any-enemy camel-line < 2)
	(goal gl-enemy-anti-cav on)
=> (set-goal gl-enemy-anti-cav off))

; Ranged threat = enemy actually owning archers/skirms (NOT a wolf attack).
(defrule
	(or (players-unit-type-count any-enemy archer-line >= 4) (players-unit-type-count any-enemy skirmisher-line >= 4))
	(goal gl-enemy-ranged off)
=> (set-goal gl-enemy-ranged on))

; Enemy massed knights -> pikes + monks alongside our own knights.
(defrule
	(players-unit-type-count any-enemy knight-line >= 4)
	(goal gl-enemy-cavalry off)
=> (set-goal gl-enemy-cavalry on))
(defrule
	(players-unit-type-count any-enemy knight-line < 2)
	(goal gl-enemy-cavalry on)
=> (set-goal gl-enemy-cavalry off))
;endregion

;region MILITARY: SCOUTS (plan-aware) + scout defence =============================
(defrule
	(current-age == feudal-age)(goal gl-plan 1)(food-amount > 80)
	(can-train scout-cavalry-line)
	(unit-type-count-total scout-cavalry-line < 6)
	(not (up-research-status c: castle-age c:>= research-pending))
=> (train scout-cavalry-line))
(defrule
	(current-age == feudal-age)(goal gl-plan 2)(food-amount > 90)
	(can-train scout-cavalry-line)
	(unit-type-count-total scout-cavalry-line < 1)
=> (train scout-cavalry-line))
; Defensive scouts when attacked (fast, good vs archers) — any plan.
(defrule
	(current-age == feudal-age)(town-under-attack)(food-amount > 80)
	(can-train scout-cavalry-line)
	(unit-type-count-total scout-cavalry-line < 5)
=> (train scout-cavalry-line))
; Feudal spearmen vs enemy SCOUT raids (spears are anti-cavalry — their only good matchup).
(defrule
	(current-age == feudal-age)
	(players-unit-type-count any-enemy scout-cavalry-line >= 3)
	(building-type-count barracks > 0)
	(can-train spearman-line)
	(unit-type-count-total spearman-line < 5)
=> (train spearman-line))
;endregion

;region MILITARY: KNIGHTS (core) ==================================================
(defrule (current-age >= castle-age)(can-train knight-line) => (train knight-line))
;endregion

;region MILITARY: COUNTERS ========================================================
; Throwing Axemen (Franks UU) vs enemy spears/camels — they shield the Knights.
(defrule
	(goal gl-enemy-anti-cav on)
	(building-type-count castle > 0)
	(can-train throwing-axeman-line)
	(unit-type-count-total throwing-axeman-line < 14)
=> (train throwing-axeman-line))
; Pikemen (anti-cav) only vs enemy CAMELS, and only the barracks unit (no archers/skirm matchup).
(defrule
	(players-unit-type-count any-enemy camel-line >= 4)
	(current-age >= castle-age)
	(can-train spearman-line)
	(unit-type-count-total spearman-line < 10)
=> (train spearman-line))
; Skirmishers = the expert vs archers (Franks' archers too weak to bother).
(defrule
	(goal gl-enemy-ranged on)
	(building-type-count archery-range > 0)
	(can-train skirmisher-line)
	(unit-type-count-total skirmisher-line < 14)
=> (train skirmisher-line))
; Mangonels vs clumped ranged.
(defrule
	(goal gl-enemy-ranged on)
	(current-age >= castle-age)
	(building-type-count siege-workshop > 0)
	(can-train mangonel-line)
	(unit-type-count-total mangonel-line < 3)
=> (train mangonel-line))
;endregion

;region MILITARY: SIEGE & TRASH (Imperial) ========================================
(defrule
	(current-age >= castle-age)
	(building-type-count siege-workshop > 0)
	(can-train battering-ram-line)
	(unit-type-count-total battering-ram-line < 2)
	(military-population > 14)
=> (train battering-ram-line))
(defrule (current-age == imperial-age)(can-train trebuchet)(unit-type-count-total trebuchet-set < 2) => (train trebuchet))
; Trash when gold runs dry: skirms (vs ranged), and pikes only if enemy has camels.
(defrule
	(current-age == imperial-age)(gold-amount < 120)
	(building-type-count archery-range > 0)
	(can-train skirmisher-line)
	(unit-type-count-total skirmisher-line < 16)
=> (train skirmisher-line))
;endregion

;region TSA-LITE: GROW DEFENDED RADIUS WITH ARMY ==================================
(defrule (true) => (up-get-fact military-population 0 gl-my-army))
(defrule
	(current-age >= castle-age)
	(up-compare-goal gl-my-army g:>= gl-town-size-step)
	(strategic-number sn-maximum-town-size < 80)
	(military-population >= 10)
	(up-compare-goal gl-home-threat < 3)
=>
	(up-modify-sn sn-maximum-town-size c:+ 4)
	(up-modify-goal gl-town-size-step c:= gl-my-army)
	(up-modify-goal gl-town-size-step c:+ 4)
)
;endregion

;region ATTACK ====================================================================
(defrule
	(goal gl-attack off)(current-age >= castle-age)
	(unit-type-count knight-line >= 8)
	(up-compare-goal gl-home-threat < 4)
=>
	(set-goal gl-attack on)
	; Target discipline (from Sol): kill counters/siege/monks/villagers first; leave
	; towers alone until the army is big enough (rams/trebs handle fortifications).
	(up-reset-target-priorities priority-offense 1)
	(up-set-offense-priority c: mangonel-line c: 11)
	(up-set-offense-priority c: monk c: 11)
	(up-set-offense-priority c: battering-ram-line c: 10)
	(up-set-offense-priority c: camel-line c: 10)
	(up-set-offense-priority c: spearman-line c: 9)
	(up-set-offense-priority c: villager c: 8)
	(up-set-offense-priority c: house c: 5)
	(up-set-offense-priority c: mill c: 6)
	(up-set-offense-priority c: mining-camp c: 6)
	(up-set-offense-priority c: lumber-camp c: 6)
	(set-strategic-number sn-disable-tower-priority 1)
	(set-strategic-number sn-number-attack-groups 100)
	(attack-now)
	(enable-timer timer-attack 45)
	(chat-to-player my-player-number "[MASTER] Attacking: knight mass ready")
)
(defrule
	(goal gl-attack on)(timer-triggered timer-attack)
	(military-population >= 10)
	(up-compare-goal gl-home-threat < 4)
=> (attack-now)(disable-timer timer-attack)(enable-timer timer-attack 45))
; Army is big -> stop avoiding fortifications; siege the base down.
(defrule
	(goal gl-attack on)
	(military-population > 30)
	(strategic-number sn-disable-tower-priority == 1)
=> (set-strategic-number sn-disable-tower-priority 0))
(defrule
	(goal gl-attack on)(military-population < 6)
=> (set-goal gl-attack off)(set-strategic-number sn-number-attack-groups 0)(disable-timer timer-attack)(chat-to-player my-player-number "[MASTER] Regrouping: army too low"))
;endregion

;region DEFENCE REACTIONS =========================================================
; Militia only on a REAL home raid: the fixed-home scan, or town-under-attack while the
; town radius is still small (early game, before TSA growth makes it unreliable).
(defrule
	(or
		(up-compare-goal gl-home-threat >= 3)
		(and (town-under-attack) (strategic-number sn-maximum-town-size <= 26))
	)
	(strategic-number sn-number-civilian-militia != 8)
=> (set-strategic-number sn-number-civilian-militia 8))
(defrule
	(up-compare-goal gl-home-threat < 3)
	(not (town-under-attack))
	(strategic-number sn-number-civilian-militia != 0)
=> (set-strategic-number sn-number-civilian-militia 0))
;endregion

;region MARKET FAIL-SAFES & DYNAMIC TRADING =======================================
; Gold-starved with a food/wood surplus -> convert it (funds Castle click / knights).
(defrule
	(current-age == feudal-age)
	(food-amount > 850)(gold-amount < 180)
	(can-sell-commodity food)
=> (sell-commodity food))
(defrule
	(current-age >= castle-age)
	(gold-amount < 100)(wood-amount > 650)
	(can-sell-commodity wood)
=> (sell-commodity wood))
(defrule
	(current-age >= castle-age)(building-type-count-total castle == 0)
	(stone-amount < 500)(wood-amount > 250)(gold-amount > 200)(can-buy-commodity stone)
=> (buy-commodity stone))
(defrule
	(current-age >= imperial-age)(stone-amount > 500)(gold-amount < 200)(can-sell-commodity stone)
=> (sell-commodity stone))
;endregion

;region RESIGN ====================================================================
(defrule
	(game-time > 1500)(building-type-count-total town-center == 0)
	(civilian-population < 4)(military-population < 4)(not (can-build town-center))
=> (chat-to-all "gg wp")(resign))
;endregion

;region DEBUG / TELEMETRY =========================================================
(defrule (goal gl-debug on)(current-age == feudal-age)  => (up-get-fact game-time 0 gl-tmp)(up-chat-data-to-self "[MASTER] >>> FEUDAL AGE at %d s" g: gl-tmp)  (disable-self))
(defrule (goal gl-debug on)(current-age == castle-age)  => (up-get-fact game-time 0 gl-tmp)(up-chat-data-to-self "[MASTER] >>> CASTLE AGE at %d s" g: gl-tmp)  (disable-self))
(defrule (goal gl-debug on)(current-age == imperial-age)=> (up-get-fact game-time 0 gl-tmp)(up-chat-data-to-self "[MASTER] >>> IMPERIAL AGE at %d s" g: gl-tmp)(disable-self))
(defrule (goal gl-debug on)(goal gl-enemy-cavalry on)   => (chat-to-player my-player-number "[MASTER] counter: enemy knights -> pikes + monks") (disable-self))
(defrule (goal gl-debug on)(goal gl-enemy-anti-cav on)  => (chat-to-player my-player-number "[MASTER] counter: enemy spears/camels -> Throwing Axemen") (disable-self))
(defrule (goal gl-debug on)(goal gl-enemy-ranged on)    => (chat-to-player my-player-number "[MASTER] counter: enemy archers -> skirms + Fletching") (disable-self))
(defrule
	(goal gl-debug on)(timer-triggered timer-debug)
=>
	(up-chat-data-to-self "[MASTER] mil-pop=%d" g: gl-my-army)
	(up-chat-data-to-self "[MASTER] town-size=%d" s: sn-maximum-town-size)
	(up-chat-data-to-self "[MASTER] home-threat=%d" g: gl-home-threat)
	(disable-timer timer-debug)(enable-timer timer-debug 60)
)
;endregion
