;==================================================================================
; THE MASTER - v0.8
; Age of Empires II: Definitive Edition AI.  Focus civ: FRANKS ("base civ").
; Game plan : Scouts -> Knights -> Paladins, Feudal fork (Scrush vs Fast Castle).
; Scope     : 1v1, Arabia, vs random-civ DE AI (Hardest).   Author: interlepus@yahoo.com
;
; v0.8: ESCROW REMOVED — it was locking wood/food in a reserved pool that plain
;       (build)/(research) can't spend, delaying Stable/Blacksmith/Scouts and piling
;       wood. Everything now draws from one pool; rule-order keeps villagers first.
;       + wheelbarrow at end-of-Feudal/Castle (skip if enemy in Castle), handcart at
;       2 TCs / 60 vils, age-scaled housing (more houses per age), boar with 6 hunters.
;       Franks notes: farm upgrades are FREE; archers are weak (no Arbalest/Bracer);
;       castles are 25% cheaper; cavalry +20% HP.
;
; NOTE TO SELF: AoE2 and/or/nand are BINARY (exactly 2 args) — nest, never list 3+.
; >>> DEBUG: flip gl-debug to "off" at the rule marked [DEBUG TOGGLE] to silence.
;==================================================================================

;region IDENTITY & GREETING ========================================================
(defrule
	(true)
=>
	(up-change-name "Meistar")
	(disable-self)
)

(defrule
	(game-time > 4)
=>
	(chat-to-all "The Master v0.8 -- Meistar. GL HF!")
	(disable-self)
)
;endregion

;region CONSTANTS ==================================================================
(defconst on 1)
(defconst off 0)
(defconst with-escrow 0)

(defconst research-pending 2)
(defconst research-complete 3)

(defconst stance-aggressive 0)
(defconst stance-defensive 1)
(defconst stance-stand-ground 2)
(defconst stance-no-attack 3)

; goals
(defconst gl-debug 1)
(defconst gl-escrow-state 2)
(defconst gl-my-army 3)
(defconst gl-enemy-anti-cav 4)
(defconst gl-enemy-ranged 5)
(defconst gl-attack 6)
(defconst gl-town-size-step 7)
(defconst gl-plan 8)               ; 0 undecided, 1 = scout rush, 2 = fast castle

; timers
(defconst timer-debug 1)
(defconst timer-attack 2)
;endregion

;region INIT / STATE ===============================================================
(defrule                            ; [DEBUG TOGGLE]  set to "off" to silence debug
	(true)
=>
	(set-goal gl-debug on)
	(set-goal gl-escrow-state with-escrow)
	(set-goal gl-attack off)
	(set-goal gl-enemy-anti-cav off)
	(set-goal gl-enemy-ranged off)
	(set-goal gl-town-size-step 0)
	(set-goal gl-plan 0)
	(disable-self)
)

(defrule
	(true)
=>
	(enable-timer timer-debug 20)
	(disable-self)
)
;endregion

;region INITIAL STRATEGIC NUMBERS ==================================================
(defrule
	(true)
=>
	(set-strategic-number sn-initial-exploration-required 0)
	(set-strategic-number sn-number-explore-groups 1)
	(set-strategic-number sn-total-number-explorers 1)
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-home-exploration-time 300)

	(set-strategic-number sn-intelligent-gathering 1)
	(set-strategic-number sn-livestock-to-town-center 1)
	(set-strategic-number sn-enable-boar-hunting 0)
	(set-strategic-number sn-minimum-number-hunters 0)
	(set-strategic-number sn-minimum-boar-lure-group-size 1000)   ; boar BLOCKED until ~14 vils
	(set-strategic-number sn-maximum-hunt-drop-distance 24)
	(set-strategic-number sn-maximum-food-drop-distance 24)
	(set-strategic-number sn-maximum-gold-drop-distance 30)
	(set-strategic-number sn-maximum-stone-drop-distance 30)
	(set-strategic-number sn-camp-max-distance 18)
	(set-strategic-number sn-mill-max-distance 22)
	(set-strategic-number sn-allow-adjacent-dropsites 1)

	(set-strategic-number sn-cap-civilian-builders 5)
	(set-strategic-number sn-percent-building-cancellation 0)
	(set-strategic-number sn-object-repair-level 2)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-enable-patrol-attack 1)
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-minimum-attack-group-size 1)
	(set-strategic-number sn-maximum-attack-group-size 1)
	(set-strategic-number sn-attack-group-size-randomness 0)
	(set-strategic-number sn-number-attack-groups 0)
	(set-strategic-number sn-consecutive-idle-unit-limit 1)
	(set-strategic-number sn-enable-offensive-priority 1)

	(set-strategic-number sn-maximum-town-size 18)
	(set-strategic-number sn-enemy-sighted-response-distance 30)
	(set-strategic-number sn-wall-targeting-mode 1)

	(set-strategic-number sn-allow-civilian-defense 1)
	(set-strategic-number sn-number-civilian-militia 0)
	(disable-self)
)
;endregion

;region ANTI-IDLE: KEEP THE TC FED ================================================
; Force food-gatherers to deposit their load when food drops below a villager's cost.
(defrule
	(current-age <= feudal-age)
	(food-amount < 50)
=>
	(up-drop-resources food c: 5)
)
;endregion

;region BOAR TIMING ================================================================
; Take boar at ~14 vils with 6 hunters (4 was iffy — the boar fights back and we don't
; want to lose a villager). ~6+ stay on food. Boar blocked via lure-group-size 1000.
(defrule
	(current-age == dark-age)
	(civilian-population >= 14)
	(strategic-number sn-minimum-boar-lure-group-size != 1)
=>
	(set-strategic-number sn-enable-boar-hunting 1)
	(set-strategic-number sn-minimum-number-hunters 6)
	(set-strategic-number sn-minimum-boar-lure-group-size 1)
	(chat-to-player my-player-number "[MASTER] Boar on (~14 vils, 6 hunters)")
)
;endregion

;region ECONOMY: VILLAGER PRODUCTION (always first -> never out-prioritised) =======
; The TC pumps villagers; it only pauses the instant Feudal is clickable so the age-up
; wins the food. This rule sits ABOVE all military/tech, so villagers always get the
; TC slot before anything else spends.
(defrule
	(can-train villager)
	(civilian-population < 95)
	(population-headroom > 0)
	(housing-headroom > 0)
	(nand
		(current-age == dark-age)
		(and
			(not (up-research-status c: feudal-age c:>= research-pending))
			(can-research feudal-age)
		)
	)
=>
	(train villager)
)
;endregion

;region ECONOMY: GATHER DISTRIBUTION ==============================================
; Dark Age = FOOD-FIRST. First ~6 vils on sheep, then phase wood in.
(defrule
	(current-age == dark-age)
	(not (up-research-status c: feudal-age c:>= research-pending))
	(civilian-population <= 6)
=>
	(set-strategic-number sn-food-gatherer-percentage 100)
	(set-strategic-number sn-wood-gatherer-percentage 0)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

(defrule
	(current-age == dark-age)
	(not (up-research-status c: feudal-age c:>= research-pending))
	(civilian-population >= 7)
	(civilian-population <= 10)
=>
	(set-strategic-number sn-food-gatherer-percentage 68)
	(set-strategic-number sn-wood-gatherer-percentage 32)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

(defrule
	(current-age == dark-age)
	(not (up-research-status c: feudal-age c:>= research-pending))
	(civilian-population >= 11)
=>
	(set-strategic-number sn-food-gatherer-percentage 58)
	(set-strategic-number sn-wood-gatherer-percentage 42)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

; SAFETY NET: enough vils but still under 500 food -> slam food to bank & click up.
(defrule
	(current-age == dark-age)
	(not (up-research-status c: feudal-age c:>= research-pending))
	(civilian-population >= 22)
	(food-amount < 500)
=>
	(set-strategic-number sn-food-gatherer-percentage 78)
	(set-strategic-number sn-wood-gatherer-percentage 22)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

; Clicking up to Feudal: at most ~2 vils on gold for the Feudal blacksmith/stable.
(defrule
	(up-research-status c: feudal-age c:>= research-pending)
	(current-age == dark-age)
=>
	(set-strategic-number sn-food-gatherer-percentage 50)
	(set-strategic-number sn-wood-gatherer-percentage 43)
	(set-strategic-number sn-gold-gatherer-percentage 7)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

; FEUDAL - SCOUT RUSH: wood for buildings/scouts, low gold, no stone yet.
(defrule
	(current-age == feudal-age)
	(goal gl-plan 1)
	(not (up-research-status c: castle-age c:>= research-pending))
=>
	(set-strategic-number sn-food-gatherer-percentage 51)
	(set-strategic-number sn-wood-gatherer-percentage 42)
	(set-strategic-number sn-gold-gatherer-percentage 7)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

; FEUDAL - FAST CASTLE: bank food + gold to reach Castle fast; minimal wood/stone.
(defrule
	(current-age == feudal-age)
	(goal gl-plan 2)
	(not (up-research-status c: castle-age c:>= research-pending))
=>
	(set-strategic-number sn-food-gatherer-percentage 55)
	(set-strategic-number sn-wood-gatherer-percentage 30)
	(set-strategic-number sn-gold-gatherer-percentage 15)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

; Castle Age: KNIGHT economy = heavy food + gold, wood for TCs/farms, stone for TC/castle.
(defrule
	(current-age == castle-age)
=>
	(set-strategic-number sn-food-gatherer-percentage 45)
	(set-strategic-number sn-wood-gatherer-percentage 20)
	(set-strategic-number sn-gold-gatherer-percentage 28)
	(set-strategic-number sn-stone-gatherer-percentage 7)
)

; Imperial Age: Paladin + siege; keep gold high.
(defrule
	(current-age == imperial-age)
	(gold-amount < 700)
=>
	(set-strategic-number sn-food-gatherer-percentage 40)
	(set-strategic-number sn-wood-gatherer-percentage 22)
	(set-strategic-number sn-gold-gatherer-percentage 33)
	(set-strategic-number sn-stone-gatherer-percentage 5)
)

(defrule
	(current-age == imperial-age)
	(gold-amount >= 700)
=>
	(set-strategic-number sn-food-gatherer-percentage 48)
	(set-strategic-number sn-wood-gatherer-percentage 30)
	(set-strategic-number sn-gold-gatherer-percentage 17)
	(set-strategic-number sn-stone-gatherer-percentage 5)
)
;endregion

;region FLEXIBLE ECO (rebalance when a resource piles) ============================
(defrule
	(wood-amount > 800)
	(strategic-number sn-wood-gatherer-percentage > 22)
=>
	(up-modify-sn sn-wood-gatherer-percentage c:- 12)
	(up-modify-sn sn-food-gatherer-percentage c:+ 8)
	(up-modify-sn sn-gold-gatherer-percentage c:+ 4)
)

(defrule
	(gold-amount > 900)
	(strategic-number sn-gold-gatherer-percentage > 6)
=>
	(up-modify-sn sn-gold-gatherer-percentage c:- 6)
	(up-modify-sn sn-food-gatherer-percentage c:+ 4)
	(up-modify-sn sn-wood-gatherer-percentage c:+ 2)
)

(defrule
	(current-age >= castle-age)
	(food-amount > 1300)
	(strategic-number sn-food-gatherer-percentage > 25)
=>
	(up-modify-sn sn-food-gatherer-percentage c:- 10)
	(up-modify-sn sn-gold-gatherer-percentage c:+ 10)
)
;endregion

;region ECONOMY: FARMS =============================================================
; Franks get farm upgrades FREE, so farms are extra efficient. Sheep/boar/berries carry
; Dark Age; add farms once we have a mill + ~16 vils, and from Feudal on (but not before
; the Stable, so military buildings win the wood).
(defrule
	(current-age == dark-age)
	(civilian-population >= 16)
	(building-type-count-total mill > 0)
	(idle-farm-count < 1)
	(can-build farm)
	(up-pending-objects c: farm < 2)
	(wood-amount > 80)
=>
	(build farm)
)

(defrule
	(current-age >= feudal-age)
	(or (building-type-count-total stable > 0) (wood-amount > 180))
	(idle-farm-count < 1)
	(can-build farm)
	(up-pending-objects c: farm < 2)
	(wood-amount > 100)
=>
	(build farm)
)
;endregion

;region BUILDINGS: HOUSES & DROPSITES =============================================
; First house with 2 builders so we're not pop-blocked at 5; then 1 builder per house.
(defrule
	(building-type-count town-center > 0)
	(building-type-count-total house == 0)
	(can-build house)
	(up-pending-objects c: house == 0)
=>
	(up-assign-builders c: house c: 2)
	(build house)
)

(defrule
	(building-type-count-total house > 0)
=>
	(up-assign-builders c: house c: 1)
	(disable-self)
)

; Build MORE houses at once as we age up (more buildings produce simultaneously).
(defrule
	(current-age <= feudal-age)
	(housing-headroom < 6)
	(population-headroom > 0)
	(up-pending-objects c: house < 2)
	(can-build house)
=>
	(build house)
)

(defrule
	(current-age == castle-age)
	(housing-headroom < 12)
	(population-headroom > 0)
	(up-pending-objects c: house < 3)
	(can-build house)
=>
	(build house)
)

(defrule
	(current-age == imperial-age)
	(housing-headroom < 18)
	(population-headroom > 0)
	(up-pending-objects c: house < 5)
	(can-build house)
=>
	(build house)
)

; First lumber camp at ~7 vils (after the opening 6 stay on food), before mill/farms.
(defrule
	(building-type-count-total lumber-camp < 1)
	(civilian-population >= 7)
	(can-build lumber-camp)
	(up-pending-objects c: lumber-camp < 1)
=>
	(build lumber-camp)
)

(defrule
	(building-type-count-total lumber-camp >= 1)
	(dropsite-min-distance wood > 4)
	(up-pending-objects c: lumber-camp < 1)
	(can-build lumber-camp)
=>
	(build lumber-camp)
)

; Mill after the lumber camp, near the forage the scout found.
(defrule
	(building-type-count-total mill == 0)
	(building-type-count-total lumber-camp > 0)
	(civilian-population >= 8)
	(can-build mill)
	(up-pending-objects c: mill < 1)
=>
	(build mill)
)

; Gold mining camp once we need gold (clicking Feudal onward).
(defrule
	(or (up-research-status c: feudal-age c:>= research-pending) (current-age >= feudal-age))
	(dropsite-min-distance gold > 5)
	(resource-found gold)
	(up-pending-objects c: mining-camp < 1)
	(can-build mining-camp)
=>
	(build mining-camp)
)

; Stone mining camp delayed to Castle Age (no towers planned in v1).
(defrule
	(or (current-age >= castle-age) (up-research-status c: castle-age c:>= research-pending))
	(dropsite-min-distance stone > 5)
	(resource-found stone)
	(up-pending-objects c: mining-camp < 1)
	(can-build mining-camp)
=>
	(build mining-camp)
)
;endregion

;region BUILDINGS: MILITARY & TECH ================================================
; Barracks ASAP — built DURING the Feudal click so the Stable can follow instantly.
(defrule
	(or (up-research-status c: feudal-age c:>= research-pending) (current-age >= feudal-age))
	(building-type-count-total barracks < 1)
	(can-build barracks)
	(up-pending-objects c: barracks < 1)
=>
	(build barracks)
)

(defrule
	(current-age >= feudal-age)
	(building-type-count-total stable < 1)
	(can-build stable)
	(up-pending-objects c: stable < 1)
=>
	(build stable)
)

(defrule
	(current-age >= castle-age)
	(building-type-count-total stable < 3)
	(can-build stable)
	(up-pending-objects c: stable < 1)
	(wood-amount > 175)
=>
	(build stable)
)

; Blacksmith after the Stable (cavalry before upgrades).
(defrule
	(current-age >= feudal-age)
	(building-type-count-total stable > 0)
	(building-type-count-total blacksmith < 1)
	(can-build blacksmith)
	(up-pending-objects c: blacksmith < 1)
=>
	(build blacksmith)
)

(defrule
	(or (goal gl-enemy-anti-cav on) (goal gl-enemy-ranged on))
	(current-age >= feudal-age)
	(building-type-count-total archery-range < 1)
	(can-build archery-range)
	(up-pending-objects c: archery-range < 1)
=>
	(build archery-range)
)

(defrule
	(current-age >= feudal-age)
	(building-type-count-total market < 1)
	(can-build market)
	(up-pending-objects c: market < 1)
	(wood-amount > 175)
=>
	(build market)
)

(defrule
	(current-age >= castle-age)
	(building-type-count-total university < 1)
	(can-build university)
	(up-pending-objects c: university < 1)
	(wood-amount > 200)
=>
	(build university)
)

(defrule
	(current-age >= castle-age)
	(building-type-count-total siege-workshop < 1)
	(can-build siege-workshop)
	(up-pending-objects c: siege-workshop < 1)
	(military-population > 8)
=>
	(build siege-workshop)
)

(defrule
	(current-age >= castle-age)
	(building-type-count-total castle < 1)
	(can-build castle)
	(up-pending-objects c: castle < 1)
=>
	(build castle)
)
;endregion

;region BUILDINGS: TOWN CENTERS (BOOM) ============================================
(defrule
	(current-age >= castle-age)
	(building-type-count-total town-center < 3)
	(can-build town-center)
	(up-pending-objects c: town-center < 1)
	(civilian-population > 30)
	(not (town-under-attack))
=>
	(up-assign-builders c: town-center c: 3)
	(build town-center)
)
;endregion

;region AGES (no escrow — one resource pool) ======================================
; Feudal: click at ~21 vils (eco rules bank the 500 food), or react to enemy advancing.
(defrule
	(or
		(civilian-population >= 21)
		(players-current-age any-enemy >= feudal-age)
	)
	(can-research feudal-age)
=>
	(research feudal-age)
	(chat-to-player my-player-number "[MASTER] Clicking FEUDAL")
)

; Castle: as soon as 800 food + 200 gold are banked.
(defrule
	(can-research castle-age)
=>
	(research castle-age)
	(chat-to-player my-player-number "[MASTER] Clicking CASTLE")
)

; Imperial: with a real Castle-Age army + economy behind it.
(defrule
	(can-research imperial-age)
	(military-population >= 12)
	(civilian-population >= 45)
=>
	(research imperial-age)
	(chat-to-player my-player-number "[MASTER] Clicking IMPERIAL")
)
;endregion

;region FEUDAL FORK: SCOUT RUSH vs FAST CASTLE ====================================
(defrule
	(current-age == feudal-age)
	(goal gl-plan 0)
	(not (players-current-age any-enemy >= feudal-age))
=>
	(set-goal gl-plan 1)
	(chat-to-player my-player-number "[MASTER] Plan: SCOUT RUSH (we hit Feudal first)")
)

(defrule
	(current-age == feudal-age)
	(goal gl-plan 0)
	(players-current-age any-enemy >= feudal-age)
=>
	(set-goal gl-plan 2)
	(chat-to-player my-player-number "[MASTER] Plan: FAST CASTLE (enemy reached Feudal first)")
)
;endregion

;region RESEARCH: ECONOMY ==========================================================
; Loom: ~20 pop (before Feudal), or TC would idle (food<45), or ANY enemy unit in town.
(defrule
	(or (food-amount < 45) (or (civilian-population >= 20) (or (town-under-attack) (up-enemy-units-in-town > 0))))
	(can-research ri-loom)
=>
	(research ri-loom)
	(chat-to-player my-player-number "[MASTER] Loom")
)

; (Franks get Horse Collar / Heavy Plow / Crop Rotation FREE — these just won't fire.)
(defrule (can-research ri-double-bit-axe) => (research ri-double-bit-axe))
(defrule (can-research ri-horse-collar)   => (research ri-horse-collar))
(defrule (can-research ri-bow-saw)        => (research ri-bow-saw))
(defrule (can-research ri-heavy-plow)     => (research ri-heavy-plow))

; Wheelbarrow at end-of-Feudal / Castle — SKIP if an enemy is already in Castle.
(defrule
	(or (current-age >= castle-age) (up-research-status c: castle-age c:>= research-pending))
	(not (players-current-age any-enemy >= castle-age))
	(can-research ri-wheel-barrow)
=>
	(research ri-wheel-barrow)
)

; Hand cart once we're booming: 2+ TCs or 60+ villagers.
(defrule
	(or (building-type-count-total town-center >= 2) (civilian-population > 60))
	(can-research ri-hand-cart)
=>
	(research ri-hand-cart)
)

; Gold-mining techs delayed to Castle Age.
(defrule (or (current-age >= castle-age) (up-research-status c: castle-age c:>= research-pending)) (can-research ri-gold-mining) => (research ri-gold-mining))
(defrule (current-age >= castle-age) (can-research ri-gold-shaft-mining) => (research ri-gold-shaft-mining))

(defrule (current-age >= imperial-age)(can-research ri-two-man-saw)       => (research ri-two-man-saw))
(defrule (current-age >= imperial-age)(can-research ri-stone-mining)      => (research ri-stone-mining))
(defrule (current-age >= imperial-age)(can-research ri-stone-shaft-mining)=> (research ri-stone-shaft-mining))
;endregion

;region RESEARCH: CAVALRY (only once we actually own cavalry) ======================
(defrule (or (unit-type-count-total scout-cavalry-line > 1) (unit-type-count-total knight-line > 1)) (can-research ri-bloodlines) => (research ri-bloodlines))
(defrule (or (unit-type-count-total scout-cavalry-line > 1) (unit-type-count-total knight-line > 1)) (can-research ri-husbandry)  => (research ri-husbandry))
(defrule (or (unit-type-count-total scout-cavalry-line > 1) (unit-type-count-total knight-line > 1)) (can-research ri-forging)       => (research ri-forging))
(defrule (research-completed ri-forging)(can-research ri-iron-casting)  => (research ri-iron-casting))
(defrule (research-completed ri-iron-casting)(can-research ri-blast-furnace) => (research ri-blast-furnace))
(defrule (or (unit-type-count-total scout-cavalry-line > 1) (unit-type-count-total knight-line > 1)) (can-research ri-scale-barding) => (research ri-scale-barding))
(defrule (research-completed ri-scale-barding)(can-research ri-chain-barding) => (research ri-chain-barding))
(defrule (research-completed ri-chain-barding)(can-research ri-plate-barding) => (research ri-plate-barding))

(defrule (can-research ri-cavalier) => (research ri-cavalier))
(defrule (can-research ri-paladin)  => (research ri-paladin))
(defrule (can-research ri-chivalry) => (research ri-chivalry))
;endregion

;region RESEARCH: DEFENSIVE / UNIVERSITY ==========================================
; Fletching ASAP when attacked — stronger/longer TC & tower arrows.
(defrule
	(town-under-attack)
	(can-research ri-fletching)
=>
	(research ri-fletching)
)

(defrule (can-research ri-masonry)        => (research ri-masonry))
(defrule (can-research ri-murder-holes)   => (research ri-murder-holes))
(defrule (can-research ri-ballistics)     => (research ri-ballistics))
(defrule (current-age >= imperial-age)(can-research ri-architecture) => (research ri-architecture))
;endregion

;region MILITARY: SCOUTS (plan-aware; food guard so vils stay first) ==============
(defrule
	(current-age == feudal-age)
	(goal gl-plan 1)
	(food-amount > 80)
	(can-train scout-cavalry-line)
	(unit-type-count-total scout-cavalry-line < 6)
	(not (up-research-status c: castle-age c:>= research-pending))
=>
	(train scout-cavalry-line)
)

(defrule
	(current-age == feudal-age)
	(goal gl-plan 2)
	(food-amount > 80)
	(can-train scout-cavalry-line)
	(unit-type-count-total scout-cavalry-line < 1)
=>
	(train scout-cavalry-line)
)
;endregion

;region MILITARY: KNIGHTS (the core) ==============================================
(defrule
	(current-age >= castle-age)
	(can-train knight-line)
=>
	(train knight-line)
)
;endregion

;region MILITARY: ENEMY ASSESSMENT (for counters) =================================
(defrule
	(or
		(players-unit-type-count any-enemy spearman-line >= 6)
		(players-unit-type-count any-enemy camel-line >= 5)
	)
	(goal gl-enemy-anti-cav off)
=>
	(set-goal gl-enemy-anti-cav on)
)

(defrule
	(players-unit-type-count any-enemy spearman-line < 3)
	(players-unit-type-count any-enemy camel-line < 2)
	(goal gl-enemy-anti-cav on)
=>
	(set-goal gl-enemy-anti-cav off)
)

(defrule
	(or
		(players-unit-type-count any-enemy archer-line >= 8)
		(players-unit-type-count any-enemy skirmisher-line >= 8)
	)
	(goal gl-enemy-ranged off)
=>
	(set-goal gl-enemy-ranged on)
)
;endregion

;region MILITARY: COUNTERS =========================================================
(defrule
	(goal gl-enemy-anti-cav on)
	(current-age >= feudal-age)
	(building-type-count archery-range > 0)
	(can-train archer-line)
	(unit-type-count-total archer-line < 14)
=>
	(train archer-line)
)
(defrule (can-research ri-crossbow) (goal gl-enemy-anti-cav on) => (research ri-crossbow))
(defrule (can-research ri-arbalest) (goal gl-enemy-anti-cav on) => (research ri-arbalest))
(defrule (can-research ri-bodkin-arrow)(goal gl-enemy-anti-cav on) => (research ri-bodkin-arrow))

(defrule
	(goal gl-enemy-ranged on)
	(current-age >= castle-age)
	(building-type-count siege-workshop > 0)
	(can-train mangonel-line)
	(unit-type-count-total mangonel-line < 3)
=>
	(train mangonel-line)
)
(defrule
	(goal gl-enemy-ranged on)
	(building-type-count archery-range > 0)
	(can-train skirmisher-line)
	(unit-type-count-total skirmisher-line < 8)
=>
	(train skirmisher-line)
)
;endregion

;region MILITARY: SIEGE & TRASH (Imperial) ========================================
(defrule
	(current-age >= castle-age)
	(building-type-count siege-workshop > 0)
	(can-train battering-ram-line)
	(unit-type-count-total battering-ram-line < 2)
	(military-population > 14)
=>
	(train battering-ram-line)
)

(defrule
	(current-age == imperial-age)
	(can-train trebuchet)
	(unit-type-count-total trebuchet-set < 2)
=>
	(train trebuchet)
)

(defrule
	(current-age == imperial-age)
	(gold-amount < 150)
	(can-train spearman-line)
=>
	(train spearman-line)
)
(defrule (can-research ri-pikeman)     => (research ri-pikeman))
(defrule (can-research ri-halberdier)  => (research ri-halberdier))
;endregion

;region TSA-LITE: GROW DEFENDED RADIUS WITH ARMY ==================================
(defrule
	(true)
=>
	(up-get-fact military-population 0 gl-my-army)
)

(defrule
	(up-compare-goal gl-my-army g:>= gl-town-size-step)
	(strategic-number sn-maximum-town-size < 80)
	(military-population >= 10)
	(not (town-under-attack))
=>
	(up-modify-sn sn-maximum-town-size c:+ 4)
	(up-modify-goal gl-town-size-step c:= gl-my-army)
	(up-modify-goal gl-town-size-step c:+ 4)
)
;endregion

;region ATTACK ====================================================================
(defrule
	(goal gl-attack off)
	(current-age >= castle-age)
	(unit-type-count knight-line >= 8)
	(not (town-under-attack))
=>
	(set-goal gl-attack on)
	(set-strategic-number sn-number-attack-groups 100)
	(attack-now)
	(enable-timer timer-attack 45)
	(chat-to-player my-player-number "[MASTER] Attacking: knight mass ready")
)

(defrule
	(goal gl-attack on)
	(timer-triggered timer-attack)
	(military-population >= 10)
	(not (town-under-attack))
=>
	(attack-now)
	(disable-timer timer-attack)
	(enable-timer timer-attack 45)
)

(defrule
	(goal gl-attack on)
	(military-population < 6)
=>
	(set-goal gl-attack off)
	(set-strategic-number sn-number-attack-groups 0)
	(disable-timer timer-attack)
	(chat-to-player my-player-number "[MASTER] Regrouping: army too low")
)
;endregion

;region DEFENCE REACTIONS =========================================================
(defrule
	(town-under-attack)
	(strategic-number sn-number-civilian-militia != 8)
=>
	(set-strategic-number sn-number-civilian-militia 8)
)
(defrule
	(not (town-under-attack))
	(strategic-number sn-number-civilian-militia != 0)
=>
	(set-strategic-number sn-number-civilian-militia 0)
)
;endregion

;region MARKET FAIL-SAFES =========================================================
(defrule
	(current-age >= castle-age)
	(building-type-count-total castle == 0)
	(stone-amount < 500)
	(wood-amount > 250)
	(gold-amount > 200)
	(can-buy-commodity stone)
=>
	(buy-commodity stone)
)

(defrule
	(current-age >= imperial-age)
	(stone-amount > 500)
	(gold-amount < 200)
	(can-sell-commodity stone)
=>
	(sell-commodity stone)
)
;endregion

;region RESIGN ====================================================================
(defrule
	(game-time > 1500)
	(building-type-count-total town-center == 0)
	(civilian-population < 4)
	(military-population < 4)
	(not (can-build town-center))
=>
	(chat-to-all "gg wp")
	(resign)
)
;endregion

;region DEBUG / TELEMETRY =========================================================
(defrule (goal gl-debug on)(current-age == feudal-age)  => (chat-to-player my-player-number "[MASTER] >>> FEUDAL AGE")  (disable-self))
(defrule (goal gl-debug on)(current-age == castle-age)  => (chat-to-player my-player-number "[MASTER] >>> CASTLE AGE")  (disable-self))
(defrule (goal gl-debug on)(current-age == imperial-age)=> (chat-to-player my-player-number "[MASTER] >>> IMPERIAL AGE")(disable-self))

(defrule (goal gl-debug on)(goal gl-enemy-anti-cav on)  => (chat-to-player my-player-number "[MASTER] counter: enemy anti-cav -> adding crossbows") (disable-self))
(defrule (goal gl-debug on)(goal gl-enemy-ranged on)    => (chat-to-player my-player-number "[MASTER] counter: enemy ranged -> adding mangonels/skirms") (disable-self))

(defrule
	(goal gl-debug on)
	(timer-triggered timer-debug)
=>
	(up-chat-data-to-self "[MASTER] mil-pop=%d" g: gl-my-army)
	(up-chat-data-to-self "[MASTER] town-size=%d" s: sn-maximum-town-size)
	(disable-timer timer-debug)
	(enable-timer timer-debug 60)
)
;endregion
